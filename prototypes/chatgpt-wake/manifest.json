{
  "manifest_version": 3,
  "name": "Switch mailbox pairing prototype",
  "version": "0.2.0",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_popup": "popup.html"}
}
