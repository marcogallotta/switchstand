{
  "manifest_version": 3,
  "name": "Switch mailbox wake",
  "version": "0.3.0",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "scripting", "activeTab"],
  "host_permissions": ["https://chatgpt.com/*", "http://127.0.0.1/*"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_title": "Re-arm all"}
}
