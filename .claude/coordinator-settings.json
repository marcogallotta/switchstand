{
  "autoCompactWindow": 300000,
  "claudeMdExcludes": [
    "**/.claude/CLAUDE.md"
  ],
  "voiceEnabled": true,
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|MultiEdit|NotebookEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$SWITCHSTAND_PRIMARY\"/scripts/codex-hook --coordinator-primary \"$SWITCHSTAND_PRIMARY\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'CURRENT PRIORITIES (read before acting):'; cat \"$HOME/.local/state/switchstand/independent-audit-claude-20261008/PRIORITIES.md\" 2>/dev/null || echo 'PRIORITIES.md MISSING: tell Marco'"
          }
        ]
      }
    ]
  }
}
