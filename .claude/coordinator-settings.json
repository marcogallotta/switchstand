{
  "autoCompactWindow": 300000,
  "claudeMdExcludes": ["**/.claude/CLAUDE.md"],
  "voiceEnabled": true,
  "voice": {"enabled": true, "mode": "hold"},
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|MultiEdit|NotebookEdit|Write",
        "hooks": [
          {"type": "command",
           "command": "\"$SWITCHSTAND_PRIMARY\"/scripts/codex-hook --coordinator-primary \"$SWITCHSTAND_PRIMARY\"",
           "timeout": 10}
        ]
      }
    ]
  }
}
