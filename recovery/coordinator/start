#!/usr/bin/env python3
import asyncio
from switchstand.codex_inbound_wake import DaemonConnection

async def start():
    rpc = DaemonConnection("/run/user/1000/switchstand-codex.sock", lambda: None)
    for attempt in range(30):
        try:
            await rpc.__aenter__()
            break
        except OSError:
            if attempt == 29:
                raise
            await asyncio.sleep(0.1)
    try:
        await rpc.call("thread/resume", {"threadId": "01a1a7c8-f56b-71e0-bd80-f352335a8039", "cwd": "/home/marco/switchstand-recovery/coordinator", "excludeTurns": True})
        await rpc.call("turn/start", {"threadId": "01a1a7c8-f56b-71e0-bd80-f352335a8039", "input": [{"type": "text", "text": "Start the coordinator: load recovery AGENTS.md, check mail, and continue authorized work."}]})
    finally:
        await rpc.__aexit__(None, None, None)
asyncio.run(start())
