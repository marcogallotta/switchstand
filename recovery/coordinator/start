#!/usr/bin/env python3
import asyncio
from pathlib import Path
from switchstand.codex_inbound_wake import DaemonConnection

THREAD = Path("/home/marco/switchstand-recovery/coordinator/thread-id").read_text().strip()

async def start():
    rpc = DaemonConnection("/run/user/1000/switchstand-codex.sock", lambda: None)
    for attempt in range(30):
        try:
            await rpc.__aenter__()
            break
        except OSError:
            if attempt == 29:
                raise
            await asyncio.sleep(0.1)
    try:
        await rpc.call("thread/resume", {"threadId": THREAD, "cwd": "/home/marco/switchstand-recovery/coordinator", "excludeTurns": True})
        await rpc.call("turn/start", {"threadId": THREAD, "input": [{"type": "text", "text": "Start the coordinator: load recovery AGENTS.md, check mail, and continue authorized work."}]})
    finally:
        await rpc.__aexit__(None, None, None)
asyncio.run(start())
