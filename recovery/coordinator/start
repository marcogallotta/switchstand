#!/usr/bin/env python3
import argparse
import asyncio
from pathlib import Path
from switchstand.codex_inbound_wake import DaemonConnection

ROOT = "/home/marco/switchstand-recovery/coordinator"
THREAD_FILE = Path(ROOT, "thread-id")

async def start(*, fresh=False):
    rpc = DaemonConnection("/run/user/1000/switchstand-codex.sock", lambda: None)
    for attempt in range(30):
        try:
            await rpc.__aenter__()
            break
        except OSError:
            if attempt == 29:
                raise
            await asyncio.sleep(0.1)
    try:
        if THREAD_FILE.exists() and not fresh:
            thread = THREAD_FILE.read_text().strip()
            await rpc.call("thread/resume", {"threadId": thread, "cwd": ROOT, "excludeTurns": True,
                                             "sandbox": "danger-full-access", "approvalPolicy": "never"})
        else:
            result = await rpc.call("thread/start", {"cwd": ROOT, "sandbox": "danger-full-access",
                                                      "approvalPolicy": "never"})
            thread = result["thread"]["id"]
            THREAD_FILE.write_text(thread + "\n")
        await rpc.call("turn/start", {"threadId": thread, "input": [{"type": "text", "text": "Start a fresh Codex Coordinator. Before any other tool or content read, "
                    "call work_get(include_notes=true, api_version=1) for these exact items in order: "
                    "40581c1e-04c5-5ab4-94d9-3c5ce21fcd35 (Situation), "
                    "332857d1-6c4d-51e8-af19-ed77b4f19e69 (Priorities focus-now), "
                    "a8ec90d7-8f20-5e44-9551-03fbfea22474 (notes; CURRENT only). "
                    "Then read GOAL.md and recovery AGENTS.md, reconcile current authority, "
                    "and check mail. Do not resume the old thread 01a1a811. "
                    "Then work the approved priority list: check running jobs and launch the next "
                    "approved step for every item without a running job, in priority order, "
                    "with at most 3 jobs running at once and resource admission before each launch. "
                    "As jobs finish, continue the next approved steps. Ask Marco via "
                    "claude-coordinator only for choices that are his calls; keep other approved "
                    "work moving. Use /home/marco/switchstand/scripts/codex-job for background workers."}]})
    finally:
        await rpc.__aexit__(None, None, None)
if __name__ == "__main__":
    parser = argparse.ArgumentParser()
    parser.add_argument("--fresh", action="store_true", help="start a new thread instead of resuming")
    asyncio.run(start(fresh=parser.parse_args().fresh))
