#!/usr/bin/env python3
"""Run one deterministic whole-module shard of pytest's actual collection."""
from __future__ import annotations

import argparse
import json
from pathlib import Path

import pytest


def module_shards(modules: set[str], count: int) -> dict[str, int]:
    """Balance observed module costs; new modules use the remaining modules' mean."""
    weights = json.loads(Path(__file__).with_name("pytest-shard-weights.json").read_text())
    costs = {module: weights["module_seconds"].get(module, weights["default_seconds"])
             for module in modules}
    loads = [0.0] * count
    # Quality runs static checks on the last shard, including selected count=1 runs.
    loads[-1] = weights["static_seconds"]
    assignments: dict[str, int] = {}
    occupied: set[int] = set()
    for module in sorted(modules, key=lambda module: (-costs[module], module)):
        # Keep small/new collections usable without hiding genuinely empty shards.
        shard = min(range(count), key=lambda index: (index in occupied, loads[index], index))
        assignments[module] = shard
        occupied.add(shard)
        loads[shard] += costs[module]
    return assignments


class Shard:
    def __init__(self, index: int, count: int, membership: Path):
        self.index, self.count, self.membership = index, count, membership

    def pytest_collection_modifyitems(self, config: pytest.Config, items: list[pytest.Item]):
        assignments = module_shards(
            {item.path.relative_to(config.rootpath).as_posix() for item in items}, self.count,
        )
        assigned: list[pytest.Item] = []
        deselected: list[pytest.Item] = []
        modules: set[str] = set()
        for item in items:
            module = item.path.relative_to(config.rootpath).as_posix()
            if assignments[module] == self.index:
                assigned.append(item)
                modules.add(module)
            else:
                deselected.append(item)
        self.membership.write_text(json.dumps({
            "index": self.index, "count": self.count,
            "collected_nodeids": [item.nodeid for item in items],
            "assigned_nodeids": [item.nodeid for item in assigned],
            "modules": sorted(modules),
        }, indent=2) + "\n")
        config.hook.pytest_deselected(items=deselected)
        items[:] = assigned


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--index", type=int, required=True)
    parser.add_argument("--count", type=int, required=True)
    parser.add_argument("--membership", type=Path, required=True)
    parser.add_argument("pytest_args", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    if args.count < 1 or not 0 <= args.index < args.count:
        parser.error("require count > 0 and 0 <= index < count")
    pytest_args = args.pytest_args
    if pytest_args[:1] == ["--"]:
        pytest_args = pytest_args[1:]
    return int(pytest.main(pytest_args, plugins=[Shard(args.index, args.count, args.membership)]))


if __name__ == "__main__":
    raise SystemExit(main())
