#!/usr/bin/env python3
"""Run one deterministic whole-module shard of pytest's actual collection."""
from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path

import pytest


class Shard:
    def __init__(self, index: int, count: int, membership: Path):
        self.index, self.count, self.membership = index, count, membership

    def pytest_collection_modifyitems(self, config: pytest.Config, items: list[pytest.Item]):
        assigned: list[pytest.Item] = []
        deselected: list[pytest.Item] = []
        modules: set[str] = set()
        for item in items:
            module = item.path.relative_to(config.rootpath).as_posix()
            shard = int.from_bytes(hashlib.sha256(module.encode()).digest()) % self.count
            if shard == self.index:
                assigned.append(item)
                modules.add(module)
            else:
                deselected.append(item)
        self.membership.write_text(json.dumps({
            "index": self.index, "count": self.count,
            "collected_nodeids": [item.nodeid for item in items],
            "assigned_nodeids": [item.nodeid for item in assigned],
            "modules": sorted(modules),
        }, indent=2) + "\n")
        config.hook.pytest_deselected(items=deselected)
        items[:] = assigned


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--index", type=int, required=True)
    parser.add_argument("--count", type=int, required=True)
    parser.add_argument("--membership", type=Path, required=True)
    parser.add_argument("pytest_args", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    if args.count < 1 or not 0 <= args.index < args.count:
        parser.error("require count > 0 and 0 <= index < count")
    pytest_args = args.pytest_args
    if pytest_args[:1] == ["--"]:
        pytest_args = pytest_args[1:]
    return int(pytest.main(pytest_args, plugins=[Shard(args.index, args.count, args.membership)]))


if __name__ == "__main__":
    raise SystemExit(main())
