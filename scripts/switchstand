#!/bin/sh
set -eu

repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
if [ "$#" -eq 0 ] || [ "${1:-}" = --coordinator ]; then
    if [ "${1:-}" = --coordinator ]; then
        shift
    fi
    : "${HOME:?HOME is required for Coordinator launch}"
    coordinator_home="$HOME/.local/state/switchstand/codex/coordinator"
    auth_source="$HOME/.codex/auth.json"
    auth_link="$coordinator_home/auth.json"
    if [ ! -f "$auth_source" ]; then
        echo "Coordinator launch requires existing Codex authentication" >&2
        exit 1
    fi
    mkdir -p "$coordinator_home"
    chmod 700 "$coordinator_home"
    if [ -L "$auth_link" ]; then
        if [ "$(readlink -f "$auth_link")" != "$(readlink -f "$auth_source")" ]; then
            echo "Coordinator Codex authentication binding is invalid" >&2
            exit 1
        fi
    elif [ -e "$auth_link" ]; then
        echo "Coordinator Codex authentication binding is invalid" >&2
        exit 1
    else
        ln -s "$auth_source" "$auth_link"
    fi
    CODEX_HOME="$coordinator_home" \
        exec codex -C "$repo" --dangerously-bypass-approvals-and-sandbox --disable hooks "$@"
fi

if [ "${1:-}" = --isolated ]; then
    shift
    : "${HOME:?HOME is required for isolated Switchstand launch}"
    selector="$HOME/.local/bin/switchstand-start"
    if [ ! -f "$selector" ] || [ ! -x "$selector" ]; then
        echo "isolated launch is not reliance-ready: trusted external selector is unavailable" >&2
        exit 1
    fi
    SWITCHSTAND_COMPAT_SILENT=1 exec "$selector" "$@"
fi

common=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)
python=$(dirname "$common")/.venv/bin/python
if [ ! -x "$python" ]; then
    echo "run scripts/bootstrap before starting Codex" >&2
    exit 1
fi

cd "$repo"
PYTHONPATH="$repo/src${PYTHONPATH:+:$PYTHONPATH}" \
    exec "$python" -m switchstand.context "$@"
