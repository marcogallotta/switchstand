#!/bin/sh
set -eu

repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
if [ "${1:-}" = --isolated ]; then
    shift
    SWITCHSTAND_COMPAT_SILENT=1 exec "$repo/scripts/switchstand-start" "$@"
fi

python=$("$repo/scripts/switchstand-python")

cd "$repo"
PYTHONPATH="$repo/src${PYTHONPATH:+:$PYTHONPATH}" \
    exec "$python" -m switchstand.context "$@"
