#!/usr/bin/env python3
"""Show the durable sync alert after replies or at session start.

Never fires mid-reply. While Marco is mid-conversation Claude may punt with
`claude-sync-reminder --punt` (silences the reminder for five minutes), at most three
times; then Claude must tell Marco it needs to update the file, and sync it.
"""

from __future__ import annotations

import json
import os
import sys
import time
from pathlib import Path

STATE = Path.home() / ".local/state/switchstand/independent-audit-claude-20261008"
ALERT = STATE / "SYNC-ALERT.md"
SNOOZE = STATE / ".sync-snooze"
SNOOZE_SECONDS = 5 * 60
MAX_PUNTS = 3
PUNT = f"{Path(__file__).resolve()} --punt"


def punts() -> int:
    try:
        return int(SNOOZE.read_text().strip() or 0)
    except OSError, ValueError:
        return 0


def punt() -> int:
    count = punts()
    if count >= MAX_PUNTS:
        print(
            f"Already punted {MAX_PUNTS} times: tell Marco you need to update PRIORITIES.md, then sync it."
        )
        return 1
    SNOOZE.write_text(f"{count + 1}\n")
    print(f"Punted {count + 1}/{MAX_PUNTS}; reminder returns in 5 min.")
    return 0


def main() -> int:
    if sys.argv[1:] == ["--punt"]:
        return punt()
    if os.environ.get("SWITCHSTAND_SYNC_REMINDER") != "1":
        return 0
    try:
        event = json.load(sys.stdin)
    except ValueError:
        event = {}
    if event.get("stop_hook_active"):
        return 0
    if not ALERT.exists() or not ALERT.read_text().strip():
        SNOOZE.unlink(missing_ok=True)
        return 0
    count = punts()
    if count and time.time() - SNOOZE.stat().st_mtime < SNOOZE_SECONDS:
        return 0
    alert = ALERT.read_text().strip()
    if count >= MAX_PUNTS:
        reason = f"{alert}\nAlready punted {MAX_PUNTS} times. Handle the checklist now."
    else:
        reason = (
            f"{alert}\nHandle the checklist now. If Marco is mid-conversation, "
            f"punt instead ({count}/{MAX_PUNTS} used): run {PUNT}"
        )
    print(json.dumps({"decision": "block", "reason": reason}))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
