#!/bin/sh
set -eu

: "${HOME:?HOME is required for Codex shim installation}"
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
source_path="$script_dir/codex-shim"
destination="$HOME/.local/bin/codex"
destination_dir=$(dirname -- "$destination")

if [ ! -f "$source_path" ]; then
    echo "Codex shim source is unavailable" >&2
    exit 1
fi
if [ -e "$destination" ] && [ ! -f "$destination" ] && [ ! -L "$destination" ]; then
    echo "Codex shim destination is not a file or symlink" >&2
    exit 1
fi

mkdir -p "$destination_dir"
temporary=$(mktemp "$destination_dir/.codex.XXXXXX")
trap 'rm -f "$temporary"' EXIT HUP INT TERM
cp "$source_path" "$temporary"
chmod 755 "$temporary"

if [ -f "$destination" ] && [ ! -L "$destination" ] \
        && [ -x "$destination" ] && cmp -s "$temporary" "$destination"; then
    exit 0
fi

mv -fT "$temporary" "$destination"
trap - EXIT HUP INT TERM
