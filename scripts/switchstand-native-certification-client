#!/bin/sh
set -eu

repo=$(git rev-parse --show-toplevel)
url=${SWITCHSTAND_CERTIFICATION_RESOURCE_URL:?certification resource URL is required}
[ "$url" = "https://laptop.tail46f0b9.ts.net:8446/mcp" ] || {
    echo "certification resource does not match pinned isolated origin" >&2
    exit 2
}
codex_home=${CODEX_HOME:-"$HOME/.codex"}

exec env -i \
    HOME="$HOME" PATH="$PATH" USER="${USER:-}" SHELL="${SHELL:-/bin/sh}" \
    TERM="${TERM:-dumb}" LANG="${LANG:-C.UTF-8}" CODEX_HOME="$codex_home" \
    codex -C "$repo" \
    -c 'mcp_servers.switchstand.enabled=false' \
    -c 'mcp_servers.switchstand_managed.enabled=false' \
    -c 'mcp_servers.switchstand_development.enabled=false' \
    -c 'mcp_servers.switchstand_certification.enabled=true' \
    -c "mcp_servers.switchstand_certification.url=\"$url\"" \
    -c 'mcp_servers.switchstand_certification.required=true' "$@"
