#!/bin/sh
set -eu

: "${HOME:?HOME is required for Claude launch}"
real_claude=$(
    for candidate in "$HOME"/.local/share/claude/versions/*; do
        [ -f "$candidate" ] && [ -x "$candidate" ] && printf '%s\n' "$candidate"
    done | sort -V | tail -1
)
if [ -z "$real_claude" ]; then
    echo "Claude Code executable is unavailable" >&2
    exit 1
fi

canonical_repo="$HOME/switchstand"
script_dir=$(dirname -- "$(readlink -f "$0")")
git_common() {
    env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR \
        -u GIT_CEILING_DIRECTORIES -u GIT_DISCOVERY_ACROSS_FILESYSTEM \
        git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || :
}
canonical_common=$(git_common "$canonical_repo")
current_common=$(git_common "$PWD")
if [ -z "$canonical_common" ] || [ "$current_common" != "$canonical_common" ]; then
    exec "$real_claude" "$@"
fi

# Only the interactive coordinator syncs PRIORITIES.md; print-mode workers skip the reminder.
SWITCHSTAND_SYNC_REMINDER=1
for arg in "$@"; do
    case "$arg" in -p|--print) SWITCHSTAND_SYNC_REMINDER=0 ;; esac
done
export SWITCHSTAND_SYNC_REMINDER

SWITCHSTAND_PRIMARY="$canonical_repo" exec "$real_claude" --setting-sources project,local \
    --settings "$script_dir/../.claude/coordinator-settings.json" \
    --mcp-config "$script_dir/../.claude/coordinator-mcp.json" --strict-mcp-config \
    --permission-mode bypassPermissions "$@"
