#!/usr/bin/env python3
"""Small host-local PostgreSQL backup, retention, staleness, and restore checker."""

from __future__ import annotations

import argparse
import ast
import hashlib
import json
import os
import shutil
import subprocess
import sys
import time
from datetime import UTC, datetime, timedelta
from pathlib import Path
from uuid import uuid4

TIERS = {
    "hourly": timedelta(hours=24),
    "12-hourly": timedelta(days=7),
    "daily": timedelta(days=31),
    "weekly": timedelta(days=120),
}
DB_AUTH = ("-U", "switchstand", "-d", "switchstand")


def state_root() -> Path:
    return Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "switchstand"


def run(arguments: list[str]) -> str:
    result = subprocess.run(
        arguments,
        check=True,
        capture_output=True,
        text=True,
    )
    return result.stdout.strip()


def db_command(container: str, tool: str, *arguments: str, interactive: bool = False) -> list[str]:
    return [
        "docker",
        "exec",
        *(["-i"] if interactive else []),
        container,
        tool,
        *arguments,
        *DB_AUTH,
    ]


def deployment_root(wrapper: Path) -> Path:
    tree = ast.parse(wrapper.read_text())
    for node in tree.body:
        if not isinstance(node, ast.Assign):
            continue
        if not any(
            isinstance(target, ast.Name) and target.id == "RUNTIME" for target in node.targets
        ):
            continue
        value = node.value
        if not (
            isinstance(value, ast.Call)
            and isinstance(value.func, ast.Name)
            and value.func.id == "Path"
            and len(value.args) == 1
        ):
            break
        resolved = ast.literal_eval(value.args[0])
        if isinstance(resolved, str):
            return Path(resolved)
    raise RuntimeError(f"cannot resolve deployed runtime from {wrapper}")


def hash_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        while chunk := stream.read(1024 * 1024):
            digest.update(chunk)
    return digest.hexdigest()


def fingerprints(container: str) -> dict[str, str]:
    query = """
SELECT json_build_object(
  'WorkIds', coalesce(md5((SELECT string_agg(id::text, E'\\n' ORDER BY id) FROM work_handles)), md5('')),
  'messages', coalesce(md5((SELECT string_agg(message_id::text, E'\\n' ORDER BY message_id) FROM messages)), md5('')),
  'grants', coalesce(md5((SELECT string_agg(principal_key || ':' || md5(document::text), E'\\n' ORDER BY principal_key) FROM work_grants)), md5(''))
)::text
"""
    output = run(db_command(container, "psql", "-Atc", query))
    result = json.loads(output)
    if not isinstance(result, dict) or set(result) != {"WorkIds", "messages", "grants"}:
        raise RuntimeError("database fingerprint query returned an invalid result")
    return {str(key): str(value) for key, value in result.items()}


def deployed_commit(wrapper: Path) -> str:
    return run(["git", "-C", str(deployment_root(wrapper)), "rev-parse", "HEAD"])


def metadata(
    created_at: datetime,
    dump: Path,
    data_fingerprints: dict[str, str],
    migration_version: str,
    commit: str,
) -> dict[str, object]:
    return {
        "created_at": created_at.astimezone(UTC).isoformat(),
        "db_migration_version": migration_version,
        "data_fingerprints": data_fingerprints,
        "deployed_commit": commit,
        "dump_sha256": hash_file(dump),
        "dump_size": dump.stat().st_size,
    }


def selected_tiers(now: datetime) -> list[str]:
    tiers = ["hourly"]
    if now.hour in {0, 12}:
        tiers.append("12-hourly")
    if now.hour == 0:
        tiers.append("daily")
        if now.weekday() == 0:
            tiers.append("weekly")
    return tiers


def prune(root: Path, now: datetime) -> None:
    for tier, age in TIERS.items():
        cutoff = (now - age).timestamp()
        directory = root / tier
        if not directory.exists():
            continue
        for dump in directory.glob("*.dump"):
            if dump.stat().st_mtime < cutoff:
                dump.unlink()
                dump.with_suffix(".json").unlink(missing_ok=True)


def create_backup(root: Path, container: str, wrapper: Path, now: datetime) -> Path:
    root.mkdir(mode=0o700, parents=True, exist_ok=True)
    root.chmod(0o700)
    stamp = now.astimezone(UTC).strftime("%Y%m%dT%H%M%SZ")
    hourly = root / "hourly"
    hourly.mkdir(mode=0o700, exist_ok=True)
    hourly.chmod(0o700)
    target = hourly / f"switchstand-{stamp}.dump"
    temporary = hourly / f".{target.name}.{uuid4().hex}.tmp"
    metadata_path = target.with_suffix(".json")
    metadata_temporary = hourly / f".{metadata_path.name}.{uuid4().hex}.tmp"
    try:
        commit = deployed_commit(wrapper)
        descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC, 0o600)
        with os.fdopen(descriptor, "wb") as stream:
            subprocess.run(
                db_command(container, "pg_dump", "-Fc"),
                check=True,
                stdout=stream,
            )
        restored_fingerprints, migration_version = inspect_dump(temporary)
        if deployed_commit(wrapper) != commit:
            raise RuntimeError("deployed commit changed while backup was captured")
        details = metadata(now, temporary, restored_fingerprints, migration_version, commit)
        descriptor = os.open(
            metadata_temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC, 0o600
        )
        with os.fdopen(descriptor, "w") as stream:
            json.dump(details, stream, indent=2, sort_keys=True)
            stream.write("\n")
        temporary.replace(target)
        metadata_temporary.replace(metadata_path)
    finally:
        temporary.unlink(missing_ok=True)
        metadata_temporary.unlink(missing_ok=True)
    for tier in selected_tiers(now)[1:]:
        directory = root / tier
        directory.mkdir(mode=0o700, exist_ok=True)
        directory.chmod(0o700)
        linked = directory / target.name
        os.link(target, linked)
        shutil.copy2(metadata_path, linked.with_suffix(".json"))
    prune(root, now)
    return target


def latest_backup(root: Path) -> Path:
    backups = sorted(
        (root / "hourly").glob("*.dump"), key=lambda path: path.stat().st_mtime, reverse=True
    )
    for backup in backups:
        metadata_path = backup.with_suffix(".json")
        try:
            details = json.loads(metadata_path.read_text())
        except OSError, json.JSONDecodeError:
            continue
        expected_keys = {
            "created_at",
            "data_fingerprints",
            "db_migration_version",
            "deployed_commit",
            "dump_sha256",
            "dump_size",
        }
        data_fingerprints = details.get("data_fingerprints") if isinstance(details, dict) else None
        if (
            isinstance(details, dict)
            and set(details) == expected_keys
            and all(
                isinstance(details[key], str)
                for key in ("created_at", "db_migration_version", "deployed_commit")
            )
            and details.get("dump_size") == backup.stat().st_size
            and details.get("dump_sha256") == hash_file(backup)
            and isinstance(data_fingerprints, dict)
            and set(data_fingerprints) == {"WorkIds", "messages", "grants"}
            and all(isinstance(value, str) for value in data_fingerprints.values())
        ):
            return backup
    raise RuntimeError("no complete validated hourly backup exists")


def check_stale(root: Path, now: datetime, maximum_age: timedelta) -> Path:
    newest = latest_backup(root)
    age = now.timestamp() - newest.stat().st_mtime
    if age > maximum_age.total_seconds():
        raise RuntimeError(
            f"backup stale: newest is {age / 3600:.1f}h old (limit {maximum_age.total_seconds() / 3600:.1f}h)"
        )
    return newest


def inspect_dump(backup: Path) -> tuple[dict[str, str], str]:
    container = f"switchstand-backup-restore-{uuid4().hex[:12]}"
    subprocess.run(
        [
            "docker",
            "run",
            "-d",
            "--rm",
            "--name",
            container,
            "-e",
            "POSTGRES_USER=switchstand",
            "-e",
            "POSTGRES_PASSWORD=switchstand",
            "-e",
            "POSTGRES_DB=switchstand",
            "postgres:18-alpine",
        ],
        check=True,
        stdout=subprocess.DEVNULL,
    )
    try:
        deadline = time.monotonic() + 30
        healthy_checks = 0
        while time.monotonic() < deadline:
            ready = subprocess.run(
                db_command(container, "pg_isready"),
                check=False,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            if ready.returncode == 0:
                healthy_checks += 1
                if healthy_checks == 2:
                    break
            else:
                healthy_checks = 0
            time.sleep(0.2)
        else:
            raise RuntimeError("throwaway PostgreSQL did not become ready")
        with backup.open("rb") as stream:
            subprocess.run(
                db_command(
                    container, "pg_restore", "--exit-on-error", "--no-owner", interactive=True
                ),
                stdin=stream,
                check=True,
                stdout=subprocess.DEVNULL,
            )
        restored = fingerprints(container)
        migration = run(
            db_command(container, "psql", "-Atc", "select version_num from alembic_version")
        )
        return restored, migration
    finally:
        subprocess.run(
            ["docker", "rm", "-f", container],
            check=False,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )


def restore_test(root: Path, _source_container: str) -> dict[str, str]:
    backup = latest_backup(root)
    details = json.loads(backup.with_suffix(".json").read_text())
    restored, migration = inspect_dump(backup)
    if restored != details["data_fingerprints"] or migration != details["db_migration_version"]:
        raise RuntimeError("throwaway restore mismatch: WorkIds, messages, grants, or migration")
    return restored


def parser() -> argparse.ArgumentParser:
    subject = argparse.ArgumentParser()
    subject.add_argument("command", choices=("run", "check-stale", "restore-test", "fingerprints"))
    subject.add_argument("--backup-root", type=Path, default=state_root() / "backups")
    subject.add_argument("--container", default="switchstand-postgres-1")
    subject.add_argument(
        "--runtime-wrapper",
        type=Path,
        default=Path.home() / ".local/libexec/switchstand-chatgpt-edge",
    )
    subject.add_argument("--max-age-hours", type=float, default=2.0)
    return subject


def main() -> None:
    arguments = parser().parse_args()
    now = datetime.now(UTC)
    try:
        if arguments.command == "run":
            print(
                create_backup(
                    arguments.backup_root, arguments.container, arguments.runtime_wrapper, now
                )
            )
        elif arguments.command == "check-stale":
            print(check_stale(arguments.backup_root, now, timedelta(hours=arguments.max_age_hours)))
        elif arguments.command == "restore-test":
            print(
                json.dumps(restore_test(arguments.backup_root, arguments.container), sort_keys=True)
            )
        else:
            print(json.dumps(fingerprints(arguments.container), sort_keys=True))
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        print(f"switchstand backup alert: {error}", file=sys.stderr)
        raise SystemExit(2) from error


if __name__ == "__main__":
    main()
