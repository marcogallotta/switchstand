#!/bin/sh
set -eu

usage() {
    echo "usage: scripts/switchstand-start --active <Asana task ID or URL> [--reference <ID-or-URL>] [prompt]" >&2
    exit 2
}

active=
previous=
for argument in "$@"; do
    if [ "$previous" = "--active" ]; then
        [ -z "$active" ] || usage
        active=$argument
        previous=
        continue
    fi
    case "$argument" in
        --active) previous=--active ;;
        --active=*)
            [ -z "$active" ] || usage
            active=${argument#--active=}
            ;;
    esac
done
[ -n "$active" ] && [ -z "$previous" ] || usage

repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
branch=$(git -C "$repo" branch --show-current)
dirty=$(git -C "$repo" status --porcelain)
[ "$branch" = main ] || {
    echo "start requires the ordinary main checkout" >&2
    exit 1
}
[ -z "$dirty" ] || {
    echo "start requires a clean ordinary main checkout" >&2
    exit 1
}

python=$(command -v python3.14 || command -v python3 || true)
[ -n "$python" ] || {
    echo "start requires python3" >&2
    exit 1
}
task_id=$(PYTHONPATH="$repo/src${PYTHONPATH:+:$PYTHONPATH}" "$python" -c \
    'import sys; from switchstand.task_ref import asana_task_id; print(asana_task_id(sys.argv[1]))' \
    "$active")
resolved=$(PYTHONPATH="$repo/src${PYTHONPATH:+:$PYTHONPATH}" "$python" -m switchstand.launch_source \
    --repo "$repo" "$task_id")
set -- $resolved
[ "$#" -eq 2 ] || {
    echo "launch source resolver returned an invalid result" >&2
    exit 1
}
accepted=$1
candidate=$2

"$repo/scripts/bootstrap"
target=$(cd "$repo" && scripts/switchstand-worktree "task-$task_id" "$accepted" "$candidate")
actual=$(git -C "$target" rev-parse HEAD)
[ "$actual" = "$candidate" ] || {
    echo "prepared task writer is not at the exact requested candidate" >&2
    exit 1
}
printf 'SWITCHSTAND_ACCEPTED_BASE=%s\nSWITCHSTAND_CANDIDATE_SHA=%s\n' "$accepted" "$candidate" >&2
cd "$target"
exec scripts/switchstand-launch "$@"
