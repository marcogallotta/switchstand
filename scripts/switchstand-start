#!/bin/sh
set -eu

usage() {
    echo "usage: scripts/switchstand-start --active <Asana task ID or URL> --commit <exact-40-character-SHA> [--reference <ID-or-URL>] [prompt]" >&2
    exit 2
}

active=
commit=
previous=
for argument in "$@"; do
    if [ "$previous" = "--active" ]; then
        [ -z "$active" ] || usage
        active=$argument
        previous=
        continue
    fi
    if [ "$previous" = "--commit" ]; then
        [ -z "$commit" ] || usage
        commit=$argument
        previous=
        continue
    fi
    case "$argument" in
        --active) previous=--active ;;
        --active=*)
            [ -z "$active" ] || usage
            active=${argument#--active=}
            ;;
        --commit) previous=--commit ;;
        --commit=*)
            [ -z "$commit" ] || usage
            commit=${argument#--commit=}
            ;;
    esac
done
[ -n "$active" ] && [ -n "$commit" ] && [ -z "$previous" ] || usage
case "$commit" in *[!0-9a-f]*|'') usage;; esac
[ "${#commit}" -eq 40 ] || usage

repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
branch=$(git -C "$repo" branch --show-current)
head=$(git -C "$repo" rev-parse HEAD)
common=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)
dirty=$(git -C "$repo" status --porcelain --untracked-files=all)
selector_path=${SWITCHSTAND_CONTROL_PATH:-}
selector_sha=${SWITCHSTAND_CONTROL_SHA:-}
selector_common=${SWITCHSTAND_CONTROL_COMMON:-}
if [ -n "$selector_path$selector_sha$selector_common" ]; then
    [ -n "$selector_path" ] && [ -n "$selector_sha" ] && [ -n "$selector_common" ] \
        || { echo "selector CONTROL identity is incomplete" >&2; exit 1; }
    [ "$repo" = "$selector_path" ] && [ "$head" = "$selector_sha" ] \
        && [ "$common" = "$selector_common" ] && [ -z "$branch" ] && [ -z "$dirty" ] \
        || { echo "start CONTROL checkout does not match selector identity" >&2; exit 1; }
    accepted=$selector_sha
else
    git -C "$repo" fetch --quiet --no-tags origin \
        '+refs/heads/main:refs/remotes/origin/main'
    accepted=$(git -C "$repo" rev-parse origin/main)
    [ "$branch" = main ] || {
        echo "start requires the ordinary main checkout" >&2
        exit 1
    }
    [ "$head" = "$accepted" ] && [ -z "$dirty" ] || {
        echo "start requires clean main at the freshly accepted origin/main" >&2
        exit 1
    }
fi
[ "$(git -C "$repo" cat-file -t "$commit" 2>/dev/null || true)" = commit ] || {
    echo "requested revision must be an available commit object" >&2
    exit 1
}
git -C "$repo" merge-base --is-ancestor "$accepted" "$commit" || {
    echo "requested revision must contain the freshly accepted origin/main" >&2
    exit 1
}
primary=$(dirname "$common")
"$primary/scripts/bootstrap"
python="$primary/.venv/bin/python"
[ -x "$python" ] || { echo "trusted CONTROL Python environment is unavailable" >&2; exit 1; }
task_id=$(PYTHONPATH="$repo/src" "$python" -P -c \
    'import sys; from switchstand.task_ref import asana_task_id; print(asana_task_id(sys.argv[1]))' \
    "$active")
target=$(cd "$repo" && scripts/switchstand-worktree "task-$task_id" "$commit")
target_root=$(git -C "$target" rev-parse --show-toplevel 2>/dev/null || true)
target_head=$(git -C "$target" rev-parse HEAD 2>/dev/null || true)
target_common=$(git -C "$target" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
target_dirty=$(git -C "$target" status --porcelain --untracked-files=all \
    2>/dev/null || printf 'unknown\n')
registered=false
if git -C "$repo" worktree list --porcelain 2>/dev/null | awk -v target="$target" '
    /^worktree / { if (substr($0, 10) == target) found = 1 }
    END { exit found ? 0 : 1 }
'; then
    registered=true
fi
[ "$target_root" = "$target" ] && [ "$target_common" = "$common" ] \
    && [ "$target_head" = "$commit" ] && [ -z "$target_dirty" ] \
    && [ "$registered" = true ] || {
        echo "candidate must be the requested repository's registered clean worktree at the exact requested commit" >&2
        exit 1
    }
cd "$repo"
SWITCHSTAND_REQUESTING_GIT_COMMON=$common \
    SWITCHSTAND_CONTROL_ROOT=$repo \
    SWITCHSTAND_CONTROL_SHA=$accepted \
    SWITCHSTAND_CANDIDATE_ROOT=$target \
    PYTHONPATH="$repo/src" \
    exec "$python" -P -m switchstand.launch "$@"
