#!/bin/sh
set -eu

usage() {
    echo "usage: scripts/switchstand-start --active <Asana task ID or URL> --commit <exact-40-character-SHA> [--reference <ID-or-URL>] [prompt]" >&2
    exit 2
}

active=
commit=
previous=
for argument in "$@"; do
    if [ "$previous" = "--active" ]; then
        [ -z "$active" ] || usage
        active=$argument
        previous=
        continue
    fi
    if [ "$previous" = "--commit" ]; then
        [ -z "$commit" ] || usage
        commit=$argument
        previous=
        continue
    fi
    case "$argument" in
        --active) previous=--active ;;
        --active=*)
            [ -z "$active" ] || usage
            active=${argument#--active=}
            ;;
        --commit) previous=--commit ;;
        --commit=*)
            [ -z "$commit" ] || usage
            commit=${argument#--commit=}
            ;;
    esac
done
[ -n "$active" ] && [ -n "$commit" ] && [ -z "$previous" ] || usage
case "$commit" in *[!0-9a-f]*|'') usage;; esac
[ "${#commit}" -eq 40 ] || usage

repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
branch=$(git -C "$repo" branch --show-current)
head=$(git -C "$repo" rev-parse HEAD)
common=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)
dirty=$(git -C "$repo" status --porcelain --untracked-files=all)
selector_path=${SWITCHSTAND_CONTROL_PATH:-}
selector_sha=${SWITCHSTAND_CONTROL_SHA:-}
selector_common=${SWITCHSTAND_CONTROL_COMMON:-}
if [ -n "$selector_path$selector_sha$selector_common" ]; then
    [ -n "$selector_path" ] && [ -n "$selector_sha" ] && [ -n "$selector_common" ] \
        || { echo "selector CONTROL identity is incomplete" >&2; exit 1; }
    [ "$repo" = "$selector_path" ] && [ "$head" = "$selector_sha" ] \
        && [ "$common" = "$selector_common" ] && [ -z "$branch" ] && [ -z "$dirty" ] \
        || { echo "start CONTROL checkout does not match selector identity" >&2; exit 1; }
    accepted=$selector_sha
else
    primary=$(dirname "$common")
    [ "$repo" = "$primary" ] && [ "$branch" = main ] || {
        echo "start requires the ordinary main checkout" >&2
        exit 1
    }
    [ -z "$dirty" ] || {
        echo "start refuses dirty main; local work is intact" >&2
        exit 1
    }
    git -C "$repo" fetch --quiet --no-tags origin \
        '+refs/heads/main:refs/remotes/origin/main'
    accepted=$(git -C "$repo" rev-parse origin/main)
    if [ "$head" != "$accepted" ]; then
        git -C "$repo" merge-base --is-ancestor "$head" "$accepted" || {
            echo "start refuses divergent main; local commits are intact" >&2
            exit 1
        }
        [ -z "$(git -C "$repo" status --porcelain --untracked-files=all)" ] || {
            echo "start refuses dirty main; local work is intact" >&2
            exit 1
        }
        git -C "$repo" merge --ff-only --quiet "$accepted" || {
            echo "start could not fast-forward main; inspect the checkout" >&2
            exit 1
        }
    fi
    [ "$(git -C "$repo" branch --show-current)" = main ] \
        && [ "$(git -C "$repo" rev-parse HEAD)" = "$accepted" ] \
        && [ -z "$(git -C "$repo" status --porcelain --untracked-files=all)" ] || {
            echo "start could not read back clean main at the exact fetched revision" >&2
            exit 1
        }
fi
primary=$(dirname "$common")
"$primary/scripts/bootstrap"
python="$primary/.venv/bin/python"
[ -x "$python" ] || { echo "trusted CONTROL Python environment is unavailable" >&2; exit 1; }
unset ASANA_TOKEN
task_id=$(PYTHONPATH="$repo/src" "$python" -P -c \
    'import sys; from switchstand.task_ref import asana_task_id; print(asana_task_id(sys.argv[1]))' \
    "$active")
resolved=$(PYTHONPATH="$repo/src" "$python" -P -m switchstand.launch_source \
    --repo "$repo" --control-sha "$accepted" "$task_id")
task_base=
candidate=
extra=
IFS=' ' read -r task_base candidate extra <<EOF_RESOLVED
$resolved
EOF_RESOLVED
[ -n "$task_base" ] && [ -n "$candidate" ] && [ -z "$extra" ] || {
    echo "launch source resolver returned an invalid result" >&2
    exit 1
}
[ "$task_base" = "$accepted" ] || {
    echo "launch task base does not match selected CONTROL" >&2
    exit 1
}
[ "$candidate" = "$commit" ] || {
    echo "launch task candidate does not match requested --commit" >&2
    exit 1
}
[ -n "${HOME:-}" ] || { echo "host HOME is required for durable task work" >&2; exit 1; }
case "$HOME" in
    /*) : ;;
    *) echo "host HOME must be absolute for durable task work" >&2; exit 1 ;;
esac
state_root=$HOME/.local/state/switchstand/worktrees
umask 077
mkdir -p "$state_root" || { echo "durable task-work directory is unavailable" >&2; exit 1; }
[ -d "$state_root" ] && [ ! -L "$state_root" ] \
    && [ "$(stat -c %a "$state_root")" = 700 ] || {
    echo "durable task-work directory must be a real private 0700 directory" >&2
    exit 1
}
state_root=$(CDPATH= cd -- "$state_root" && pwd -P) || {
    echo "durable task-work directory could not be resolved" >&2
    exit 1
}
durable_target=$state_root/switchstand-task-$task_id
for old_root in "${TMPDIR:-/tmp}" /tmp; do
    canonical_old_root=$(CDPATH= cd -- "$old_root" && pwd -P 2>/dev/null || true)
    [ -n "$canonical_old_root" ] || continue
    old_target=$canonical_old_root/switchstand-task-$task_id
    if [ "$old_target" != "$durable_target" ] \
            && { [ -e "$old_target" ] || [ -L "$old_target" ]; }; then
        echo "legacy task writer exists at $old_target; work is intact, reconcile before durable relaunch" >&2
        exit 1
    fi
done
target=$(cd "$repo" && TMPDIR="$state_root" \
    scripts/switchstand-worktree "task-$task_id" "$candidate" --resume-exact)
[ "$target" = "$durable_target" ] || {
    echo "task writer helper did not return the exact durable target" >&2
    exit 1
}
target_root=$(git -C "$target" rev-parse --show-toplevel 2>/dev/null || true)
target_head=$(git -C "$target" rev-parse HEAD 2>/dev/null || true)
target_common=$(git -C "$target" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
registered=false
if git -C "$repo" worktree list --porcelain 2>/dev/null | awk -v target="$target" '
    /^worktree / { if (substr($0, 10) == target) found = 1 }
    END { exit found ? 0 : 1 }
'; then
    registered=true
fi
[ "$target_root" = "$target" ] && [ "$target_common" = "$common" ] \
    && [ "$target_head" = "$candidate" ] \
    && [ "$registered" = true ] || {
        echo "candidate must be the requesting repository's registered worktree at the exact requested checkpoint" >&2
        exit 1
    }
cd "$repo"
printf 'SWITCHSTAND_ACCEPTED_BASE=%s\nSWITCHSTAND_CANDIDATE_SHA=%s\n' "$task_base" "$candidate" >&2
SWITCHSTAND_REQUESTING_GIT_COMMON=$common \
    SWITCHSTAND_CONTROL_ROOT=$repo \
    SWITCHSTAND_CONTROL_SHA=$accepted \
    SWITCHSTAND_CANDIDATE_ROOT=$target \
    PYTHONPATH="$repo/src" \
    exec "$python" -P -m switchstand.launch "$@"
