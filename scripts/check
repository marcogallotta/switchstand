#!/bin/sh
set -eu

missing() {
    echo "focused check prerequisite '$1' is missing; make '$1' available on PATH, then rerun scripts/check" >&2
    exit 1
}
for command_name in git date timeout dirname env; do
    command -v "$command_name" >/dev/null 2>&1 || missing "$command_name"
done

repo=$(git rev-parse --show-toplevel)
common=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)
primary=$(dirname "$common")
bootstrap=$primary/scripts/bootstrap
venv=$primary/.venv
deadline=$(($(date +%s) + 120))
run() {
    remaining=$((deadline - $(date +%s)))
    [ "$remaining" -gt 1 ] || {
        echo "focused check exceeded the 120-second stop-loss" >&2
        return 124
    }
    soft_limit=$((remaining - 1))
    status=0
    timeout --kill-after=1 "$soft_limit" "$@" || status=$?
    case "$status" in
        124|137) return 124 ;;
        *) return "$status" ;;
    esac
}
bound=false
if [ "${SWITCHSTAND_CHECK_UV+x}" != "" ]; then
    uv=$SWITCHSTAND_CHECK_UV
    [ -x "$uv" ] || { echo "CONTROL pinned uv is missing; relaunch through scripts/switchstand" >&2; exit 1; }
    venv=$repo/.venv
    run env UV_CACHE_DIR="$repo/.git/uv-cache" UV_PYTHON_INSTALL_DIR="$repo/.git/uv-python" \
        UV_PROJECT_ENVIRONMENT="$venv" "$uv" sync --project "$repo" --locked --all-groups \
        --no-install-project || exit $?
    bound=true
elif [ "${SWITCHSTAND_CHECK_VENV+x}${SWITCHSTAND_CHECK_MANIFEST+x}" != "" ]; then
    echo "old shared environment binding; relaunch through scripts/switchstand for CONTROL pinned uv" >&2
    exit 1
elif [ -x "$bootstrap" ]; then
    run "$bootstrap" || {
        status=$?
        if [ "$status" -eq 124 ]; then
            echo "focused check setup exceeded the 120-second stop-loss; run scripts/bootstrap in the primary checkout, then rerun scripts/check" >&2
        fi
        exit "$status"
    }
elif [ ! -x "$venv/bin/python" ]; then
    echo "focused check setup is missing; run scripts/bootstrap in the primary checkout, then rerun scripts/check" >&2
    exit 1
fi
for tool in python ruff pyright pytest; do
    [ -x "$venv/bin/$tool" ] || {
        echo "focused check setup is incomplete ($venv/bin/$tool missing); rerun scripts/check" >&2
        exit 1
    }
done
manifest() {
    run "$venv/bin/python" -c \
        'import hashlib, pathlib, sys; h=hashlib.sha256(); [h.update((pathlib.Path(sys.argv[1]) / n).read_bytes()) for n in ("pyproject.toml", "uv.lock")]; print(h.hexdigest())' \
        "$1"
}
if [ "$bound" = false ]; then
    repo_manifest=$(manifest "$repo") || exit $?
    primary_manifest=$(manifest "$primary") || exit $?
    [ "$repo_manifest" = "$primary_manifest" ] || {
        echo "candidate dependency manifests differ from the pinned Stage-0 environment; relaunch required" >&2
        exit 1
    }
fi
run env PYTHONPATH="$repo/src" "$venv/bin/ruff" check .
run env PYTHONPATH="$repo/src" "$venv/bin/pyright" --pythonpath "$venv/bin/python"
run env SWITCHSTAND_REQUIRE_TEST_DATABASE=1 PYTHONPATH="$repo/src" "$venv/bin/pytest" -ra "$@"
