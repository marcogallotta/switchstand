#!/bin/sh
set -eu

missing() {
    echo "focused check prerequisite '$1' is missing; make '$1' available on PATH, then rerun scripts/check" >&2
    exit 1
}
for command_name in git date timeout env sed; do
    command -v "$command_name" >/dev/null 2>&1 || missing "$command_name"
done

repo=$(git rev-parse --show-toplevel)
cd "$repo"
deadline=$(($(date +%s) + 120))
run() {
    remaining=$((deadline - $(date +%s)))
    [ "$remaining" -gt 1 ] || {
        echo "focused check exceeded the 120-second stop-loss" >&2
        return 124
    }
    soft_limit=$((remaining - 1))
    run_status=0
    timeout --kill-after=1 "$soft_limit" "$@" || run_status=$?
    case "$run_status" in
        124|137) return 124 ;;
        *) return "$run_status" ;;
    esac
}
# Use a stdlib-only coordinator; candidate tools always come from the private receipt.
python=$(command -v python3.14 || command -v python3 || true)
[ -n "$python" ] || missing python3
helper="$repo/src/switchstand/check_environment.py"
binding=$(run "$python" "$helper" prepare "$repo") || exit $?
venv=$(printf '%s\n' "$binding" | sed -n '1p')
receipt=$(printf '%s\n' "$binding" | sed -n '2p')
verify() {
    run "$python" "$helper" verify "$repo" --generation "$venv" --receipt "$receipt"
}
verify
status=0
run env PYTHONPATH="$repo/src" "$venv/bin/ruff" check . || status=$?
if [ "$status" -eq 0 ]; then
    run env PYTHONPATH="$repo/src" "$venv/bin/pyright" --pythonpath "$venv/bin/python" || status=$?
fi
if [ "$status" -eq 0 ]; then
    run env SWITCHSTAND_REQUIRE_TEST_DATABASE=1 PYTHONPATH="$repo/src" "$venv/bin/pytest" "$@" || status=$?
fi
verify || exit $?
exit "$status"
