#!/bin/sh
set -eu
script_repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ "${SWITCHSTAND_MANAGED:-}" = 1 ]; then
    : "${SWITCHSTAND_WORKTREE:?managed development requires SWITCHSTAND_WORKTREE}"
    : "${SWITCHSTAND_BRANCH:?managed development requires SWITCHSTAND_BRANCH}"
    : "${SWITCHSTAND_GIT_COMMON:?managed development requires SWITCHSTAND_GIT_COMMON}"
fi
repo=${SWITCHSTAND_WORKTREE:-$script_repo}
common=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)
python=$(dirname "$common")/.venv/bin/python
if [ ! -x "$python" ]; then
    echo "run the documented bootstrap in the primary checkout first" >&2
    exit 1
fi
PYTHONPATH="$script_repo/src" exec "$python" -m switchstand.development
