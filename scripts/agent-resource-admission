#!/usr/bin/env python3
"""Print the Stage 1 agent resource admission decision for one proposed job."""

from __future__ import annotations

import argparse
import os
from pathlib import Path
import subprocess
import sys
import time


DEFAULT_CONFIG = Path("/home/marco/.config/switchstand/agent-resource-admission.conf")
CGROUP_ROOT = Path("/sys/fs/cgroup")
REQUIRED_CONFIG = {
    "reserve_mib": int,
    "swap_window_seconds": int,
    "max_swap_growth_kib": int,
    "psi_avg10_max": float,
    "max_memory_jobs": int,
}


def fail(reason: str) -> int:
    print(f"WAIT reason=measurement_error:{reason}")
    return 1


def read_config(path: Path) -> dict[str, int | float]:
    values: dict[str, int | float] = {}
    for raw_line in path.read_text().splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        key, separator, raw_value = line.partition("=")
        if not separator or key not in REQUIRED_CONFIG:
            raise ValueError(f"invalid_config_line:{line}")
        values[key] = REQUIRED_CONFIG[key](raw_value)
    missing = REQUIRED_CONFIG.keys() - values.keys()
    if missing:
        raise ValueError(f"missing_config:{','.join(sorted(missing))}")
    if any(value < 0 for value in values.values()) or values["max_memory_jobs"] < 1:
        raise ValueError("invalid_config_value")
    return values


def read_mem_available_mib() -> int:
    for line in Path("/proc/meminfo").read_text().splitlines():
        if line.startswith("MemAvailable:"):
            return int(line.split()[1]) // 1024
    raise ValueError("missing_mem_available")


def read_psi_avg10() -> float:
    for line in Path("/proc/pressure/memory").read_text().splitlines():
        if line.startswith("some "):
            fields = dict(field.split("=", 1) for field in line.split()[1:])
            return float(fields["avg10"])
    raise ValueError("missing_memory_psi")


def read_swap_pages() -> tuple[int, int]:
    counters: dict[str, int] = {}
    for line in Path("/proc/vmstat").read_text().splitlines():
        key, value = line.split()
        if key in {"pswpin", "pswpout"}:
            counters[key] = int(value)
    if counters.keys() != {"pswpin", "pswpout"}:
        raise ValueError("missing_swap_counter")
    return counters["pswpin"], counters["pswpout"]


def systemctl(*arguments: str) -> str:
    completed = subprocess.run(
        ["systemctl", "--user", *arguments],
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    return completed.stdout


def show_properties(unit: str, *names: str) -> dict[str, str]:
    output = systemctl("show", unit, *(f"--property={name}" for name in names))
    properties = dict(line.split("=", 1) for line in output.splitlines() if "=" in line)
    missing = set(names) - properties.keys()
    if missing:
        raise ValueError(f"missing_systemd_property:{unit}:{','.join(sorted(missing))}")
    return properties


def has_codex_exec(cgroup: str) -> bool:
    root = CGROUP_ROOT / cgroup.lstrip("/")
    if not root.is_dir():
        return False
    pids: set[int] = set()
    for process_file in root.rglob("cgroup.procs"):
        try:
            pids.update(int(pid) for pid in process_file.read_text().split())
        except (FileNotFoundError, ProcessLookupError):
            continue
    for pid in pids:
        try:
            arguments = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0")
        except (FileNotFoundError, ProcessLookupError, PermissionError):
            continue
        for index, argument in enumerate(arguments[:-1]):
            if Path(os.fsdecode(argument)).name in {"codex", "codex.exe"}:
                if os.fsdecode(arguments[index + 1]) == "exec":
                    return True
    return False


def memory_jobs(scope_pattern: str) -> tuple[list[str], list[tuple[str, str]]]:
    output = systemctl(
        "list-units", scope_pattern, "--type=scope", "--all", "--no-legend", "--plain"
    )
    active: list[str] = []
    leftovers: list[tuple[str, str]] = []
    now_usec = int(time.monotonic() * 1_000_000)
    for line in output.splitlines():
        if not line.strip():
            continue
        unit = line.split()[0]
        properties = show_properties(
            unit, "ActiveState", "Slice", "ControlGroup", "ActiveEnterTimestampMonotonic"
        )
        if properties["ActiveState"] != "active" or properties["Slice"] != "agents.slice":
            continue
        if has_codex_exec(properties["ControlGroup"]):
            active.append(unit)
            continue
        entered = properties["ActiveEnterTimestampMonotonic"]
        age = "unknown"
        if entered.isdigit() and int(entered) <= now_usec:
            age = str((now_usec - int(entered)) // 1_000_000)
        leftovers.append((unit, age))
    return active, leftovers


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("estimate_mib", type=int, help="conservative memory estimate for the job")
    parser.add_argument("--config", type=Path, default=DEFAULT_CONFIG)
    parser.add_argument(
        "--scope-pattern",
        default="ss-codex-*.scope",
        help=argparse.SUPPRESS,
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    if args.estimate_mib < 0:
        return fail("invalid_estimate")
    try:
        config = read_config(args.config)
        before_mem_available_mib = read_mem_available_mib()
        before_psi_avg10 = read_psi_avg10()
        before_swap = read_swap_pages()
        time.sleep(config["swap_window_seconds"])
        after_swap = read_swap_pages()
        deltas = tuple(after - before for before, after in zip(before_swap, after_swap, strict=True))
        if any(delta < 0 for delta in deltas):
            return fail("swap_counter_reset")
        swap_growth_kib = sum(deltas) * os.sysconf("SC_PAGE_SIZE") // 1024
        mem_available_mib = read_mem_available_mib()
        psi_avg10 = read_psi_avg10()
        slice_properties = show_properties(
            "agents.slice", "TasksCurrent", "MemoryCurrent", "MemoryMax"
        )
        active, leftovers = memory_jobs(args.scope_pattern)
        memory_max = slice_properties["MemoryMax"]
        memory_max_mib = None if memory_max == "infinity" else int(memory_max) // (1024 * 1024)
        slice_tasks = int(slice_properties["TasksCurrent"])
        slice_memory_mib = int(slice_properties["MemoryCurrent"]) // (1024 * 1024)
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        return fail(str(error).replace(" ", "_"))

    for unit, age_seconds in leftovers:
        print(f"LEFTOVER scope={unit} age_seconds={age_seconds}")

    reasons: list[str] = []
    required_mib = int(config["reserve_mib"]) + args.estimate_mib
    if mem_available_mib < required_mib:
        reasons.append("headroom")
    if swap_growth_kib > config["max_swap_growth_kib"]:
        reasons.append("swap_growth")
    if psi_avg10 > config["psi_avg10_max"]:
        reasons.append("memory_psi")
    if len(active) >= config["max_memory_jobs"]:
        reasons.append("active_jobs")
    if memory_max_mib is not None:
        used_mib = slice_memory_mib if slice_tasks else 0
        if used_mib + args.estimate_mib > memory_max_mib:
            reasons.append("slice_capacity")

    verdict = "WAIT" if reasons else "GO"
    fields = [
        f"reason={','.join(reasons) if reasons else 'all_checks_passed'}",
        f"active_memory_jobs={len(active)}",
        f"max_memory_jobs={config['max_memory_jobs']}",
        f"before_mem_available_mib={before_mem_available_mib}",
        f"mem_available_mib={mem_available_mib}",
        f"required_mib={required_mib}",
        f"swap_growth_kib={swap_growth_kib}",
        f"before_psi_avg10={before_psi_avg10}",
        f"psi_avg10={psi_avg10}",
        f"slice_tasks={slice_tasks}",
        f"slice_memory_mib={slice_memory_mib}",
        f"slice_max_mib={memory_max_mib if memory_max_mib is not None else 'infinity'}",
    ]
    print(f"{verdict} {' '.join(fields)}")
    return 1 if reasons else 0


if __name__ == "__main__":
    sys.exit(main())
