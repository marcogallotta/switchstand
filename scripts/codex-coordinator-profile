#!/usr/bin/env python3
"""Copy benign user preferences into the isolated Coordinator Codex home."""

from __future__ import annotations

import json
import os
import shlex
import sys
import tempfile
import tomllib
from pathlib import Path
from typing import Any, cast

PREFERENCES = (
    ("model_auto_compact_token_limit",),
    ("model_auto_compact_token_limit_scope",),
    ("tui", "alternate_screen"),
    ("notice", "hide_rate_limit_model_nudge"),
)

CANONICAL_MCP_FIELDS = (
    "url",
    "default_tools_approval_mode",
    "enabled_tools",
)
CONTROL_ROOT = Path(__file__).resolve().parents[1]


def _linked_worktree_git_dir(primary: Path, writer: Path) -> Path:
    gitfile = writer / ".git"
    if gitfile.is_symlink() or not gitfile.is_file():
        raise SystemExit("Coordinator writer Git administrative binding is unavailable")
    try:
        prefix, raw = gitfile.read_text().strip().split(":", 1)
        git_dir = Path(raw.strip())
        if not git_dir.is_absolute():
            git_dir = gitfile.parent / git_dir
        git_dir = git_dir.resolve(strict=True)
        worktrees = (primary / ".git/worktrees").resolve(strict=True)
    except (OSError, ValueError) as exc:
        raise SystemExit("Coordinator writer Git administrative binding is invalid") from exc
    if prefix != "gitdir" or git_dir.parent != worktrees or not git_dir.is_dir():
        raise SystemExit("Coordinator writer Git administrative binding is invalid")
    return git_dir


def _lookup(config: dict[str, Any], path: tuple[str, ...]) -> Any:
    value: Any = config
    for key in path:
        if not isinstance(value, dict):
            return None
        mapping = cast(dict[str, Any], value)
        if key not in mapping:
            return None
        value = mapping[key]
    return value


def _toml_value(value: Any) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, int):
        return str(value)
    if isinstance(value, str):
        return json.dumps(value)
    raise TypeError(f"unsupported preference type: {type(value).__name__}")


def _canonical_mcp() -> dict[str, Any]:
    with (CONTROL_ROOT / ".codex/config.toml").open("rb") as handle:
        config = tomllib.load(handle)
    try:
        source = cast(dict[str, Any], config["mcp_servers"]["switchstand"])
        selected = {field: source[field] for field in CANONICAL_MCP_FIELDS}
    except (KeyError, TypeError) as exc:
        raise SystemExit("canonical Switchstand MCP configuration is unavailable") from exc
    tools = selected["enabled_tools"]
    if (not isinstance(selected["url"], str)
            or selected["default_tools_approval_mode"] != "approve"
            or not isinstance(tools, list)
            or not tools
            or not all(isinstance(tool, str) and tool for tool in cast(list[object], tools))):
        raise SystemExit("canonical Switchstand MCP configuration is invalid")
    return selected


def render(
    config: dict[str, Any],
    primary: Path,
    writer: Path,
    start_record: Path,
    manifest_record: Path,
    hook: Path,
    continuity_hook: Path,
    continuity_mode: str,
    lifetime: str,
    telemetry: Path,
    compact_hook: Path,
) -> str:
    canonical_mcp = _canonical_mcp()
    _linked_worktree_git_dir(primary, writer)
    guard_command = shlex.join((
        str(hook), "--coordinator-primary", str(primary), "--coordinator-writer", str(writer),
    ))
    continuity_command = shlex.join((
        str(continuity_hook), "--mode", continuity_mode, "--lifetime", lifetime,
        "--telemetry", str(telemetry),
    ))
    compact_command = shlex.join((
        str(compact_hook), str(manifest_record),
    ))
    worker_inspector = shlex.join((
        str(hook.with_name("codex-worker-inspect")), "--root", str(writer),
    ))
    frozen_control = compact_hook.with_name("coordinator-control")
    lines = [
        'approval_policy = "never"',
        'sandbox_mode = "danger-full-access"',
        "developer_instructions = " + json.dumps(
            f"Coordinator start commit is recorded at {start_record}. "
            f"This generation's owned linked writer is {writer}; make repository mutations "
            "only there. Canonical main may advance without changing this generation's exact "
            "candidate. Its launch-control manifest is "
            f"{manifest_record}. After context compaction, the synchronous compact-session hook "
            "runs the post-compaction currentness check and injects the bounded reread set; obey "
            "that immediate context before continuing. Any manual post-compaction retry must run "
            f"{frozen_control} check {manifest_record} --trigger post-compaction. Never substitute "
            "writer-relative scripts/coordinator-control. Changed launch controls require only the "
            "reported affected-boundary recheck; they do not stale the generation. "
            "CURRENTNESS_UNKNOWN blocks only actions depending on its unknown component. After "
            "an in-session canonical sync, run "
            f"{frozen_control} check {manifest_record} --trigger post-sync and "
            "reread every returned changed dependency, then recheck only each returned affected "
            "boundary. If the manifest "
            "contains a handoff, read its exact obligations file, then run "
            f"{primary / 'scripts/coordinator-control'} acknowledge {manifest_record}. Only its "
            "ACKNOWLEDGED result transfers those obligations and permits the prior generation "
            "to retire. "
            "This raw Coordinator launch is ordinary and unbound: never call "
            "work_get(api_version=\"1\") without a WorkId to infer current focus. Ground work "
            "through an exact WorkId from Marco's direct assignment or an acknowledged addressed "
            "handoff, and call work_get with that exact ID. When Marco directly assigns new "
            "substantive work without one, resolve and read START HERE 1218327002478382 as its "
            "provider-neutral parent. If the parent exposes an exact canonical_root, create with "
            "work_type=Task, lifecycle_state=CURRENT, owner_key=SELF, "
            "wait_kind=unblock_condition=next_due=NONE, next_action_class=OWNER_CAN_DO, and an "
            "assignment-derived next_action_ref; otherwise use only the legacy create's required "
            "arguments. Use one stable OperationId. Inspect "
            "the complete result and continue only after exact work_get readback of the created "
            "WorkId. Reconcile possible-send ambiguity only with the identical OperationId and "
            "arguments as directed; never mint a second intent. Do not create work for simple questions, status, corrections, "
            "approvals, already-grounded continuation, or inferred/contextual work. If identity "
            "remains unavailable or creation is denied/unresolved, report COVERAGE_GAP / UNKNOWN. "
            "Bare work_get is reserved for trusted launch-bound "
            "managed runs. Native full local-user execution applies to directly operated Root "
            "and sub-Coordinators, but grants no provider, deployment, activation, or other "
            "consequential-effect authority; preserve each exact authority and readback gate. "
            "Built-in Workers are read-only because they share Root's filesystem "
            "profile and hooks are not a security sandbox. Their only shell entry point is "
            f"`{worker_inspector}` with one of `files`, `read`, `search`, `status`, `diff`, or "
            "`log`; the runtime denies every other shell and every file-edit call. Delegate "
            "research/review freely; for implementation, a Worker returns a patch proposal and "
            "Root applies it in this generation's owned writer. The "
            "Coordinator control MCP separately exposes an isolated implementation-worker "
            "spawn/status/cancel path backed by the exact WorkId and a task-private writer. "
            f"Resolved root continuity launch state: mode={continuity_mode}; "
            f"lifetime={lifetime}."
        ),
    ]
    section: tuple[str, ...] = ()
    for path in PREFERENCES:
        value = _lookup(config, path)
        if value is None or path[:-1]:
            continue
        lines.append(f"{path[-1]} = {_toml_value(value)}")
    lines += [
        "",
        "[features]",
        "hooks = true",
        "multi_agent = true",
        "",
        "[mcp_servers.switchstand]",
        f"url = {json.dumps(canonical_mcp['url'])}",
        "required = true",
        'default_tools_approval_mode = "approve"',
        "enabled_tools = " + json.dumps(canonical_mcp["enabled_tools"]),
        "",
        "[mcp_servers.switchstand_coordinator_control]",
        f"command = {json.dumps(str(primary / 'scripts/switchstand-coordinator-control-mcp'))}",
        'required = true',
        'default_tools_approval_mode = "approve"',
        'enabled_tools = ["coordinator_currentness_get", "coordinator_main_sync", '
        '"coordinator_implementation_spawn", "coordinator_implementation_status", '
        '"coordinator_implementation_cancel"]',
        "",
        "[[hooks.PreToolUse]]",
        "",
        "[[hooks.PreToolUse.hooks]]",
        'type = "command"',
        f"command = {json.dumps(guard_command)}",
        "timeout = 10",
        "",
        "[[hooks.SessionStart]]",
        'matcher = "^compact$"',
        "",
        "[[hooks.SessionStart.hooks]]",
        'type = "command"',
        f"command = {json.dumps(compact_command)}",
        "timeout = 10",
        "additionalContextLimit = 1200",
    ]
    if continuity_mode == "PILOT":
        for event in ("UserPromptSubmit", "Stop"):
            lines += [
                "",
                f"[[hooks.{event}]]",
                "",
                f"[[hooks.{event}.hooks]]",
                'type = "command"',
                f"command = {json.dumps(continuity_command)}",
                "timeout = 10",
            ]
    for path in PREFERENCES:
        value = _lookup(config, path)
        if value is None or not path[:-1]:
            continue
        parent = path[:-1]
        if parent != section:
            lines.append("")
            lines.append(f"[{'.'.join(parent)}]")
            section = parent
        lines.append(f"{path[-1]} = {_toml_value(value)}")
    return "\n".join(lines) + ("\n" if lines else "")


def _write(path: Path, output: str, *, exclusive: bool = False, mode: int = 0o600) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        "w", dir=path.parent, prefix=f".{path.name}.", delete=False
    ) as handle:
        temporary = Path(handle.name)
        handle.write(output)
    os.chmod(temporary, mode)
    try:
        if exclusive:
            os.link(temporary, path)
        else:
            os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def render_hooks(hook: Path, primary: Path) -> str:
    command = shlex.join((str(hook), "--coordinator-primary", str(primary)))
    return json.dumps({"description": "Switchstand Coordinator shared-primary guard.",
        "hooks": {"PreToolUse": [{"matcher": "^(Bash|apply_patch)$", "hooks": [
            {"type": "command", "command": command, "timeout": 10}]}]}}, indent=2) + "\n"


def main() -> None:
    if len(sys.argv) != 16:
        raise SystemExit(
            "usage: codex-coordinator-profile SOURCE SNAPSHOT RUNTIME_PROFILE PRIMARY WRITER HOOKS HOOK "
            "CONTINUITY_HOOK COMPACT_HOOK COORDINATOR_CONTROL CONTINUITY_MODE LIFETIME TELEMETRY "
            "START_RECORD MANIFEST_RECORD"
        )
    (source, snapshot, runtime_profile, primary, writer, hooks, hook, continuity_hook,
     compact_hook, coordinator_control,
     continuity_mode, lifetime, telemetry, start_record, manifest_record) = sys.argv[1:]
    (source, snapshot, runtime_profile, primary, writer, hooks, hook, continuity_hook,
     compact_hook, coordinator_control) = map(
        Path, (
            source, snapshot, runtime_profile, primary, writer, hooks, hook, continuity_hook,
            compact_hook, coordinator_control,
        )
    )
    telemetry, start_record, manifest_record = map(Path, (telemetry, start_record, manifest_record))
    if continuity_mode not in {"OFF", "PILOT"}:
        raise SystemExit("continuity mode must be OFF or PILOT")
    if lifetime not in {"ASSIGNMENT", "STANDING"}:
        raise SystemExit("continuity lifetime must be ASSIGNMENT or STANDING")
    resolved_hook = hook.resolve(strict=True)
    if not resolved_hook.is_file() or not os.access(resolved_hook, os.X_OK):
        raise SystemExit("Coordinator hook is unavailable")
    resolved_continuity_hook = continuity_hook.resolve(strict=True)
    if not resolved_continuity_hook.is_file() or not os.access(resolved_continuity_hook, os.X_OK):
        raise SystemExit("Continuity hook is unavailable")
    worker_inspector = resolved_hook.with_name("codex-worker-inspect")
    if not worker_inspector.is_file() or not os.access(worker_inspector, os.X_OK):
        raise SystemExit("Worker repository inspector is unavailable")
    compact_controls = Path(f"{start_record}.compact-controls")
    compact_controls.mkdir(mode=0o700, parents=True)
    compact_hook_snapshot = compact_controls / "codex-compact-hook"
    control_snapshot = compact_controls / "coordinator-control"
    _write(
        compact_hook_snapshot,
        compact_hook.resolve(strict=True).read_text(),
        exclusive=True,
        mode=0o500,
    )
    _write(
        control_snapshot,
        coordinator_control.resolve(strict=True).read_text(),
        exclusive=True,
        mode=0o500,
    )
    with source.open("rb") as handle:
        output = render(
            tomllib.load(handle), primary.resolve(strict=True), writer.resolve(strict=True),
            start_record, manifest_record, resolved_hook, resolved_continuity_hook,
            continuity_mode, lifetime, telemetry, compact_hook_snapshot,
        )
    _write(snapshot, output, exclusive=True, mode=0o400)
    _write(runtime_profile, output, exclusive=True)
    _write(hooks, render_hooks(resolved_hook, primary.resolve(strict=True)))


if __name__ == "__main__":
    main()
