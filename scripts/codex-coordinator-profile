#!/usr/bin/env python3
"""Copy benign user preferences into the isolated Coordinator Codex home."""

from __future__ import annotations

import json
import os
import shlex
import subprocess
import sys
import tempfile
import tomllib
from pathlib import Path
from typing import Any

PREFERENCES = (
    ("model_auto_compact_token_limit",),
    ("model_auto_compact_token_limit_scope",),
    ("tui", "alternate_screen"),
    ("notice", "hide_rate_limit_model_nudge"),
)


def _lookup(config: dict[str, Any], path: tuple[str, ...]) -> Any:
    value: Any = config
    for key in path:
        if not isinstance(value, dict) or key not in value:
            return None
        value = value[key]
    return value


def _toml_value(value: Any) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, int):
        return str(value)
    if isinstance(value, str):
        return json.dumps(value)
    raise TypeError(f"unsupported preference type: {type(value).__name__}")


def _linked_worktrees(primary: Path) -> list[Path]:
    environment = {
        key: value for key, value in os.environ.items()
        if key not in {
            "GIT_DIR", "GIT_WORK_TREE", "GIT_COMMON_DIR", "GIT_CEILING_DIRECTORIES",
            "GIT_DISCOVERY_ACROSS_FILESYSTEM",
        }
    }
    root = subprocess.run(
        ["git", "-C", str(primary), "rev-parse", "--show-toplevel"],
        text=True, capture_output=True, check=False, env=environment,
    )
    if root.returncode or Path(root.stdout.strip()).resolve() != primary.resolve():
        return []
    result = subprocess.run(
        ["git", "-C", str(primary), "worktree", "list", "--porcelain"],
        text=True, capture_output=True, check=False, env=environment,
    )
    if result.returncode:
        return []
    return sorted(
        Path(line.removeprefix("worktree ")).resolve()
        for line in result.stdout.splitlines()
        if line.startswith("worktree ")
    )


def render(
    config: dict[str, Any],
    primary: Path,
    writer: Path,
    start_record: Path,
    manifest_record: Path,
    continuity_hook: Path,
    continuity_mode: str,
    lifetime: str,
    telemetry: Path,
) -> str:
    continuity_command = shlex.join((
        str(continuity_hook), "--mode", continuity_mode, "--lifetime", lifetime,
        "--telemetry", str(telemetry),
    ))
    lines = [
        'approval_policy = "never"',
        'default_permissions = "switchstand-coordinator"',
        "developer_instructions = " + json.dumps(
            f"Coordinator start commit is recorded at {start_record}. "
            f"This generation's owned linked writer is {writer}; make repository mutations "
            "only there. Canonical main may advance without changing this generation's exact "
            "candidate. Its launch-control manifest is "
            f"{manifest_record}. After context compaction, run "
            f"{primary / 'scripts/coordinator-control'} check {manifest_record} "
            "--trigger post-compaction; reread every returned dependency plus current work, "
            "open obligations, and the start commit. Changed launch controls require only the "
            "reported affected-boundary recheck; they do not stale the generation. "
            "CURRENTNESS_UNKNOWN blocks only actions depending on its unknown component. After "
            "an in-session canonical sync, run the same check with --trigger post-sync and "
            "reread every returned changed dependency, then recheck only each returned affected "
            "boundary. If the manifest "
            "contains a handoff, read its exact obligations file, then run "
            f"{primary / 'scripts/coordinator-control'} acknowledge {manifest_record}. Only its "
            "ACKNOWLEDGED result transfers those obligations and permits the prior generation "
            "to retire. "
            f"Resolved root continuity launch state: mode={continuity_mode}; "
            f"lifetime={lifetime}."
        ),
    ]
    section: tuple[str, ...] = ()
    for path in PREFERENCES:
        value = _lookup(config, path)
        if value is None or path[:-1]:
            continue
        lines.append(f"{path[-1]} = {_toml_value(value)}")
    lines += [
        "",
        "[features]",
        "hooks = true",
        "",
        "[mcp_servers.switchstand_coordinator_control]",
        f"command = {json.dumps(str(primary / 'scripts/switchstand-coordinator-control-mcp'))}",
        'required = true',
        'default_tools_approval_mode = "approve"',
        'enabled_tools = ["coordinator_currentness_get", "coordinator_main_sync"]',
        "",
        "[permissions.switchstand-coordinator]",
        'description = "Coordinator host access with the shared primary checkout read-only."',
        "",
        "[permissions.switchstand-coordinator.filesystem]",
        '":root" = "read"',
        f'{json.dumps(str(primary.parent))} = "write"',
        '":tmpdir" = "write"',
        '":slash_tmp" = "write"',
    ]
    linked_worktrees = _linked_worktrees(primary)
    for linked in linked_worktrees:
        if linked != primary:
            access = "write" if linked == writer else "read"
            lines.append(f'{json.dumps(str(linked))} = {json.dumps(access)}')
    if writer not in linked_worktrees:
        lines.append(f'{json.dumps(str(writer))} = "write"')
    lines += [
        "",
        f'[permissions.switchstand-coordinator.filesystem.{json.dumps(str(primary))}]',
        '"." = "read"',
        '".git" = "write"',
        "",
        "[permissions.switchstand-coordinator.network]",
        "enabled = true",
        "dangerously_allow_all_unix_sockets = true",
    ]
    if continuity_mode == "PILOT":
        for event in ("UserPromptSubmit", "Stop"):
            lines += [
                "",
                f"[[hooks.{event}]]",
                "",
                f"[[hooks.{event}.hooks]]",
                'type = "command"',
                f"command = {json.dumps(continuity_command)}",
                "timeout = 10",
            ]
    for path in PREFERENCES:
        value = _lookup(config, path)
        if value is None or not path[:-1]:
            continue
        parent = path[:-1]
        if parent != section:
            lines.append("")
            lines.append(f"[{'.'.join(parent)}]")
            section = parent
        lines.append(f"{path[-1]} = {_toml_value(value)}")
    return "\n".join(lines) + ("\n" if lines else "")


def render_hooks(hook: Path, primary: Path, writer: Path) -> str:
    command = shlex.join((
        str(hook), "--coordinator-primary", str(primary), "--coordinator-writer", str(writer)
    ))
    hooks = {
        "description": "Switchstand Coordinator shared-primary guard.",
        "hooks": {
            "PreToolUse": [{
                "matcher": "^(Bash|apply_patch)$",
                "hooks": [{"type": "command", "command": command, "timeout": 10}],
            }],
        },
    }
    return json.dumps(hooks, indent=2) + "\n"


def _write(path: Path, output: str, *, exclusive: bool = False) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        "w", dir=path.parent, prefix=f".{path.name}.", delete=False
    ) as handle:
        temporary = Path(handle.name)
        handle.write(output)
    os.chmod(temporary, 0o600)
    try:
        if exclusive:
            os.link(temporary, path)
        else:
            os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def main() -> None:
    if len(sys.argv) != 14:
        raise SystemExit(
            "usage: codex-coordinator-profile SOURCE SNAPSHOT RUNTIME_PROFILE PRIMARY WRITER HOOKS HOOK "
            "CONTINUITY_HOOK CONTINUITY_MODE LIFETIME TELEMETRY START_RECORD MANIFEST_RECORD"
        )
    (source, snapshot, runtime_profile, primary, writer, hooks_destination, hook, continuity_hook,
     continuity_mode, lifetime, telemetry, start_record, manifest_record) = sys.argv[1:]
    source, snapshot, runtime_profile, primary, writer, hooks_destination, hook, continuity_hook = map(
        Path, (source, snapshot, runtime_profile, primary, writer, hooks_destination, hook, continuity_hook)
    )
    telemetry, start_record, manifest_record = map(Path, (telemetry, start_record, manifest_record))
    if continuity_mode not in {"OFF", "PILOT"}:
        raise SystemExit("continuity mode must be OFF or PILOT")
    if lifetime not in {"ASSIGNMENT", "STANDING"}:
        raise SystemExit("continuity lifetime must be ASSIGNMENT or STANDING")
    resolved_hook = hook.resolve(strict=True)
    if not resolved_hook.is_file() or not os.access(resolved_hook, os.X_OK):
        raise SystemExit("Coordinator hook is unavailable")
    resolved_continuity_hook = continuity_hook.resolve(strict=True)
    if not resolved_continuity_hook.is_file() or not os.access(resolved_continuity_hook, os.X_OK):
        raise SystemExit("Continuity hook is unavailable")
    with source.open("rb") as handle:
        output = render(
            tomllib.load(handle), primary.resolve(strict=True), writer.resolve(strict=True),
            start_record, manifest_record,
            resolved_continuity_hook, continuity_mode, lifetime, telemetry,
        )
    _write(snapshot, output, exclusive=True)
    _write(runtime_profile, output, exclusive=True)
    _write(
        hooks_destination,
        render_hooks(resolved_hook, primary.resolve(strict=True), writer.resolve(strict=True)),
    )


if __name__ == "__main__":
    main()
