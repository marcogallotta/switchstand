#!/usr/bin/env python3
"""Copy benign user preferences into the isolated Coordinator Codex home."""

from __future__ import annotations

import json
import os
from pathlib import Path
import sys
import tempfile
import tomllib
from typing import Any


PREFERENCES = (
    ("model_auto_compact_token_limit",),
    ("model_auto_compact_token_limit_scope",),
    ("tui", "alternate_screen"),
    ("notice", "hide_rate_limit_model_nudge"),
)


def _lookup(config: dict[str, Any], path: tuple[str, ...]) -> Any:
    value: Any = config
    for key in path:
        if not isinstance(value, dict) or key not in value:
            return None
        value = value[key]
    return value


def _toml_value(value: Any) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, int):
        return str(value)
    if isinstance(value, str):
        return json.dumps(value)
    raise TypeError(f"unsupported preference type: {type(value).__name__}")


def render(config: dict[str, Any]) -> str:
    lines: list[str] = []
    section: tuple[str, ...] = ()
    for path in PREFERENCES:
        value = _lookup(config, path)
        if value is None:
            continue
        parent = path[:-1]
        if parent != section:
            if lines:
                lines.append("")
            lines.append(f"[{'.'.join(parent)}]")
            section = parent
        lines.append(f"{path[-1]} = {_toml_value(value)}")
    return "\n".join(lines) + ("\n" if lines else "")


def main() -> None:
    if len(sys.argv) != 3:
        raise SystemExit("usage: codex-coordinator-profile SOURCE DESTINATION")
    source, destination = map(Path, sys.argv[1:])
    with source.open("rb") as handle:
        output = render(tomllib.load(handle))
    destination.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        "w", dir=destination.parent, prefix=f".{destination.name}.", delete=False
    ) as handle:
        temporary = Path(handle.name)
        handle.write(output)
    os.chmod(temporary, 0o600)
    os.replace(temporary, destination)


if __name__ == "__main__":
    main()
