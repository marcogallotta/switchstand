#!/usr/bin/env python3
"""Copy benign user preferences into the isolated Coordinator Codex home."""

from __future__ import annotations

import json
import os
import shlex
import sys
import tempfile
import tomllib
from pathlib import Path
from typing import Any

PREFERENCES = (
    ("model_auto_compact_token_limit",),
    ("model_auto_compact_token_limit_scope",),
    ("tui", "alternate_screen"),
    ("notice", "hide_rate_limit_model_nudge"),
)


def _lookup(config: dict[str, Any], path: tuple[str, ...]) -> Any:
    value: Any = config
    for key in path:
        if not isinstance(value, dict) or key not in value:
            return None
        value = value[key]
    return value


def _toml_value(value: Any) -> str:
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, int):
        return str(value)
    if isinstance(value, str):
        return json.dumps(value)
    raise TypeError(f"unsupported preference type: {type(value).__name__}")


def render(
    config: dict[str, Any], primary: Path, start_record: Path, manifest_record: Path
) -> str:
    lines = [
        'approval_policy = "never"',
        'default_permissions = "switchstand-coordinator"',
        "developer_instructions = " + json.dumps(
            f"Coordinator start commit is recorded at {start_record}. "
            f"Its launch-control manifest is {manifest_record}. After context compaction, run "
            f"{primary / 'scripts/coordinator-control'} check {manifest_record} "
            "--trigger post-compaction; reread every returned dependency plus current work, "
            "open obligations, and the start commit. CONTROL_STALE is permanent for this "
            "generation: start no new consequential effect; only reconcile already-started "
            "or ambiguous effects, preserve obligations, reach the smallest safe checkpoint, "
            "and hand off. CURRENTNESS_UNKNOWN blocks only actions depending on its unknown "
            "component. After an in-session canonical sync, run the same check with "
            "--trigger post-sync and reread every returned changed dependency. If the manifest "
            "contains a handoff, read its exact obligations file, then run "
            f"{primary / 'scripts/coordinator-control'} acknowledge {manifest_record}. Only its "
            "ACKNOWLEDGED result transfers those obligations and permits the prior generation "
            "to retire."
        ),
    ]
    section: tuple[str, ...] = ()
    for path in PREFERENCES:
        value = _lookup(config, path)
        if value is None or path[:-1]:
            continue
        lines.append(f"{path[-1]} = {_toml_value(value)}")
    lines += [
        "",
        "[features]",
        "hooks = true",
        "",
        "[mcp_servers.switchstand_coordinator_control]",
        f"command = {json.dumps(str(primary / 'scripts/switchstand-coordinator-control-mcp'))}",
        'required = true',
        'default_tools_approval_mode = "approve"',
        'enabled_tools = ["coordinator_currentness_get", "coordinator_main_sync"]',
        "",
        "[permissions.switchstand-coordinator]",
        'description = "Coordinator host access with the shared primary checkout read-only."',
        "",
        "[permissions.switchstand-coordinator.filesystem]",
        '":root" = "read"',
        f'{json.dumps(str(primary.parent))} = "write"',
        '":tmpdir" = "write"',
        '":slash_tmp" = "write"',
        "",
        f'[permissions.switchstand-coordinator.filesystem.{json.dumps(str(primary))}]',
        '"." = "read"',
        '".git" = "write"',
        "",
        "[permissions.switchstand-coordinator.network]",
        "enabled = true",
        "dangerously_allow_all_unix_sockets = true",
    ]
    for path in PREFERENCES:
        value = _lookup(config, path)
        if value is None or not path[:-1]:
            continue
        parent = path[:-1]
        if parent != section:
            lines.append("")
            lines.append(f"[{'.'.join(parent)}]")
            section = parent
        lines.append(f"{path[-1]} = {_toml_value(value)}")
    return "\n".join(lines) + ("\n" if lines else "")


def render_hooks(hook: Path, primary: Path) -> str:
    command = shlex.join((str(hook), "--coordinator-primary", str(primary)))
    hooks = {
        "description": "Switchstand Coordinator shared-primary guard.",
        "hooks": {
            "PreToolUse": [{
                "matcher": "^(Bash|apply_patch)$",
                "hooks": [{"type": "command", "command": command, "timeout": 10}],
            }],
        },
    }
    return json.dumps(hooks, indent=2) + "\n"


def _write(path: Path, output: str, *, exclusive: bool = False) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        "w", dir=path.parent, prefix=f".{path.name}.", delete=False
    ) as handle:
        temporary = Path(handle.name)
        handle.write(output)
    os.chmod(temporary, 0o600)
    try:
        if exclusive:
            os.link(temporary, path)
        else:
            os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def main() -> None:
    if len(sys.argv) != 9:
        raise SystemExit(
            "usage: codex-coordinator-profile SOURCE SNAPSHOT RUNTIME_PROFILE PRIMARY HOOKS HOOK "
            "START_RECORD MANIFEST_RECORD"
        )
    source, snapshot, runtime_profile, primary, hooks_destination, hook, start_record, manifest_record = map(
        Path, sys.argv[1:]
    )
    with source.open("rb") as handle:
        output = render(
            tomllib.load(handle), primary.resolve(strict=True), start_record, manifest_record
        )
    resolved_hook = hook.resolve(strict=True)
    if not resolved_hook.is_file() or not os.access(resolved_hook, os.X_OK):
        raise SystemExit("Coordinator hook is unavailable")
    _write(snapshot, output, exclusive=True)
    _write(runtime_profile, output, exclusive=True)
    _write(hooks_destination, render_hooks(resolved_hook, primary.resolve(strict=True)))


if __name__ == "__main__":
    main()
