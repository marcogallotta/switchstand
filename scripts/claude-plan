#!/usr/bin/env python3
"""Render a source-bound plan inventory; refuse missing or stale dispositions."""

import argparse
import hashlib
import re
from dataclasses import dataclass
from datetime import datetime
from pathlib import Path
from zoneinfo import ZoneInfo

ACTION_SECTIONS = {
    "plan agreed",
    "hr format result",
    "mailbox cron",
    "top priority",
    "running",
    "pick up here",
    "queue",
    "not in plan",
    "stalled",
    "broken list",
    "other open",
}
NONWORK_SECTIONS = {
    "marco's standing orders",
    "marco's rules",
    "owners",
    "done",
    "files",
}
STALL_MARKERS = (
    "deferred",
    "failed",
    "frozen",
    "not activated",
    "not deployed",
    "not launched",
    "not merged",
    "not sent",
    "not started",
    "queued",
    "stale",
    "stopped",
    "waiting",
)
TERMINAL_PREFIXES = ("done", "stopped", "superseded", "pass", "deployed", "checked")


@dataclass(frozen=True)
class Item:
    item_id: str
    name: str
    state: str
    age: str
    source: str
    stalled: bool


def compact(text: str, limit: int = 180) -> str:
    value = " ".join(text.split()).replace("|", "\\|")
    return value if len(value) <= limit else value[: limit - 1] + "…"


def file_hash(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def duration(now: datetime, then: datetime, lower_bound: bool = False) -> tuple[str, int]:
    seconds = max(0, int((now - then).total_seconds()))
    if seconds >= 86400:
        value = f"{seconds // 86400}d"
    elif seconds >= 3600:
        value = f"{seconds // 3600}h"
    else:
        value = f"{seconds // 60}m"
    return (f"≥{value}" if lower_bound else value), seconds


def timestamp(text: str, now: datetime) -> tuple[datetime | None, bool]:
    context = r"(?:since|started|launched|merged|deployed|done|active|checked|rewrite|stopped|failed|waiting|running)"
    patterns = (
        (rf"(?i)\b{context}\s+(\d{{1,2}})-(\d{{1,2}})\s+(\d{{1,2}}):(\d{{2}})", 0),
        (rf"(?i)\b{context}\s+(\d{{1,2}}):(\d{{2}})\s+(\d{{1,2}})-(\d{{1,2}})", 1),
        (
            rf"(?i)\b{context}\s+(\d{{1,2}})-(\d{{1,2}})(?!-)(?!\s+\d{{1,2}}:\d{{2}})",
            2,
        ),
    )
    found: list[tuple[datetime, bool]] = []
    for pattern, order in patterns:
        for match in re.finditer(pattern, text):
            values = [int(value) for value in match.groups()]
            if order == 0:
                month, day, hour, minute = values
            elif order == 1:
                hour, minute, month, day = values
            else:
                month, day = values
                hour = minute = 0
            try:
                if order == 2:
                    hour, minute = 23, 59
                year = now.year - 1 if (month, day) > (now.month, now.day) else now.year
                value = datetime(year, month, day, hour, minute, tzinfo=now.tzinfo)
            except ValueError:
                continue
            if order == 2 and value > now:
                value = now
            if value <= now:
                found.append((value, order == 2))
    return max(found, default=(None, True), key=lambda entry: entry[0] or now)


def age(text: str, path: Path, now: datetime) -> tuple[str, int]:
    seen, lower_bound = timestamp(text, now)
    if seen is not None:
        return duration(now, seen, lower_bound)
    modified = datetime.fromtimestamp(path.stat().st_mtime, tz=now.tzinfo)
    source_age, _ = duration(now, modified)
    return f"UNKNOWN (source {source_age} old)", 0


def is_stalled(text: str, seconds: int, forced: bool = False) -> bool:
    lowered = text.lower()
    if forced or any(re.search(rf"\b{re.escape(marker)}\b", lowered) for marker in STALL_MARKERS):
        return True
    return seconds >= 86400 and not lowered.startswith(TERMINAL_PREFIXES)


def make_item(
    item_id: str, line: str, path: Path, line_number: int, now: datetime, forced: bool = False
) -> Item:
    item_age, seconds = age(line, path, now)
    stripped = re.sub(r"^\s*(?:[-*]|[A-Z]?\d+\.)\s*", "", line).strip()
    return Item(
        item_id=item_id,
        name=compact(stripped.split(":", 1)[0], 70),
        state=compact(stripped),
        age=item_age,
        source=f"{path.name}:{line_number}",
        stalled=is_stalled(stripped, seconds, forced),
    )


def section_kind(heading: str) -> str:
    lowered = heading.lower()
    for prefix in ACTION_SECTIONS | NONWORK_SECTIONS:
        if lowered == prefix or lowered.startswith(
            (f"{prefix} ", f"{prefix} (", f"{prefix} [", f"{prefix}:")
        ):
            return prefix
    raise ValueError(f"unclassified PRIORITIES.md section: {heading}")


def priorities_items(path: Path, now: datetime) -> list[Item]:
    result: list[Item] = []
    section: str | None = None
    for line_number, line in enumerate(path.read_text().splitlines(), 1):
        if line.startswith("## "):
            heading = line[3:].strip()
            section = section_kind(heading)
            if section in {"mailbox cron", "top priority"}:
                result.append(make_item(f"priority:{line_number}", heading, path, line_number, now))
            continue
        if not line.strip() or section not in ACTION_SECTIONS:
            continue
        parts = [line]
        if section == "stalled":
            parts = re.split(
                r";\s+(?=[^;]*(?:\bsince\b|\bnot (?:deployed|activated|sent|started|"
                r"launched|merged)\b|\bfrozen\b))",
                line,
                flags=re.IGNORECASE,
            )
        for part_number, part in enumerate(parts, 1):
            suffix = f":{part_number}" if len(parts) > 1 else ""
            result.append(
                make_item(
                    f"priority:{line_number}{suffix}",
                    part,
                    path,
                    line_number,
                    now,
                    section == "stalled",
                )
            )
    return result


def jobs_items(path: Path, now: datetime) -> list[Item]:
    result: list[Item] = []
    started = False
    for line_number, line in enumerate(path.read_text().splitlines(), 1):
        if line.startswith("Stages:"):
            started = True
            continue
        if not started or not line.strip() or line.startswith("## "):
            continue
        fields = [field.strip() for field in line.strip().strip("|").split("|")]
        if fields[0].lower() in {"job", "session"} or all(
            not field.strip("-:") for field in fields
        ):
            continue
        if len(fields) in {4, 5}:
            name = fields[0]
            state = " — ".join(fields[-2:])
        else:
            name = re.sub(r"^-\s*", "", line).split(":", 1)[0]
            state = line
        result.append(
            make_item(f"job:{compact(name, 60)}:{line_number}", state, path, line_number, now)
        )
    return result


def read_decisions(path: Path, hashes: dict[str, str]) -> dict[str, tuple[str, str]]:
    result: dict[str, tuple[str, str]] = {}
    seen_hashes: dict[str, str] = {}
    for line_number, line in enumerate(path.read_text().splitlines(), 1):
        if not line.strip():
            continue
        if line.startswith("#"):
            if "=" in line:
                key, value = line.lstrip("# ").split("=", 1)
                seen_hashes[key] = value
            continue
        fields = [field.strip() for field in line.split("\t", 2)]
        if len(fields) != 3 or fields[1] not in {"PLAN", "OUT"}:
            raise ValueError(f"{path}:{line_number}: expected ID<TAB>PLAN|OUT<TAB>detail")
        if not fields[2] or fields[2].startswith("<"):
            raise ValueError(f"{path}:{line_number}: finish condition or hard reason required")
        if fields[0] in result:
            raise ValueError(f"{path}:{line_number}: duplicate {fields[0]}")
        result[fields[0]] = (fields[1], fields[2])
    if seen_hashes != hashes:
        raise ValueError(f"{path}: stale source hashes; regenerate")
    return result


def render_template(items: list[Item], hashes: dict[str, str]) -> str:
    lines = ["# Fill every tab-separated record"]
    lines.extend(f"# {key}={value}" for key, value in hashes.items())
    lines.extend(
        f"{entry.item_id}\tOUT\t<hard reason; or PLAN with finish condition>" for entry in items
    )
    return "\n".join(lines)


def render_report(
    items: list[Item], chosen: dict[str, tuple[str, str]], paths: list[Path], now: datetime
) -> str:
    expected = {entry.item_id for entry in items}
    if set(chosen) != expected:
        raise ValueError(
            f"decision coverage mismatch; missing={sorted(expected - set(chosen))}; "
            f"extra={sorted(set(chosen) - expected)}"
        )
    planned = [entry for entry in items if chosen[entry.item_id][0] == "PLAN"]
    held = [entry for entry in items if entry.stalled]
    freshness = "; ".join(
        f"{path.name} {duration(now, datetime.fromtimestamp(path.stat().st_mtime, tz=now.tzinfo))[0]} old"
        for path in paths
    )
    lines = [
        f"# PLAN SNAPSHOT — {now:%Y-%m-%d %H:%M %Z}",
        f"**Sources:** {freshness}",
        f"**Coverage:** {len(items)} source records; {len(planned)} planned; {len(held)} stalled/held.",
        "",
        "## NOW",
    ]
    lines.extend(f"- `{entry.item_id}` {chosen[entry.item_id][1]}" for entry in planned[:5])
    if len(planned) > 5:
        lines.append(f"- +{len(planned) - 5} more planned in the inventory")
    if not planned:
        lines.append("- NONE")
    lines.extend(["", "## STALLED / HELD"])
    lines.extend(f"- `{entry.item_id}` [{entry.age}] {entry.state}" for entry in held[:5])
    if len(held) > 5:
        lines.append(f"- +{len(held) - 5} more flagged in the inventory")
    if not held:
        lines.append("- NONE")
    lines.extend(
        [
            "",
            "## COMPLETE SOURCE INVENTORY",
            "| Item | Age | Flag | State | Disposition | Source |",
            "| --- | --- | --- | --- | --- | --- |",
        ]
    )
    for entry in items:
        disposition, detail = chosen[entry.item_id]
        lines.append(
            f"| `{entry.item_id}` {entry.name} | {entry.age} | "
            f"{'STALLED/HELD' if entry.stalled else '-'} | {entry.state} | "
            f"{disposition}: {compact(detail)} | {entry.source} |"
        )
    return "\n".join(lines)


def main() -> int:
    state = Path.home() / ".local/state/switchstand"
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--priorities",
        type=Path,
        default=state / "independent-audit-claude-20261008/PRIORITIES.md",
    )
    parser.add_argument("--jobs", type=Path, default=state / "codex-runs/JOBS.md")
    parser.add_argument("--decisions", type=Path)
    parser.add_argument("--now")
    args = parser.parse_args()
    try:
        now = (
            datetime.fromisoformat(args.now) if args.now else datetime.now(ZoneInfo("Europe/Rome"))
        )
        if now.tzinfo is None:
            raise ValueError("--now needs a timezone offset")
        items = priorities_items(args.priorities, now) + jobs_items(args.jobs, now)
        hashes = {
            "priorities_sha256": file_hash(args.priorities),
            "jobs_sha256": file_hash(args.jobs),
        }
        if args.decisions is None:
            print(render_template(items, hashes))
            return 2
        chosen = read_decisions(args.decisions, hashes)
        print(render_report(items, chosen, [args.priorities, args.jobs], now))
        return 0
    except (OSError, ValueError) as exc:
        print(f"claude-plan: UNKNOWN: {exc}")
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
