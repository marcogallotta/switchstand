#!/bin/sh
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
git_dir=$(git -C "$repo" rev-parse --absolute-git-dir)
git_common=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)
if [ "$git_dir" = "$git_common" ]; then
    echo "managed launch requires a linked writer worktree" >&2
    exit 1
fi
python=$(dirname "$git_common")/.venv/bin/python
if [ ! -x "$python" ]; then
    echo "run the documented bootstrap in the primary checkout first" >&2
    exit 1
fi
cd "$repo"
PYTHONPATH="$repo/src${PYTHONPATH:+:$PYTHONPATH}" exec "$python" -m switchstand.launch "$@"
