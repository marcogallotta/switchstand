#!/bin/sh
set -eu

repo=${1:-/home/marco/switchstand}
unit_dir=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user
bin_dir=${XDG_DATA_HOME:-$HOME/.local/share}/switchstand/bin

for name in claude-plan claude-sync-checklist claude-sync-reminder; do
    test -x "$repo/scripts/$name"
done
install -d -m 0755 "$bin_dir" "$unit_dir"
install -m 0755 "$repo/scripts/claude-plan" "$bin_dir/claude-plan"
install -m 0755 "$repo/scripts/claude-sync-checklist" "$bin_dir/claude-sync-checklist"
install -m 0755 "$repo/scripts/claude-sync-reminder" "$bin_dir/claude-sync-reminder"

write_unit() {
    target=$1
    shift
    temporary=$(mktemp "$unit_dir/.$target.XXXXXX")
    printf '%s\n' "$@" >"$temporary"
    chmod 0644 "$temporary"
    mv -f "$temporary" "$unit_dir/$target"
}

write_unit switchstand-claude-sync.service \
    '[Unit]' \
    'Description=Run the unified Claude staleness checklist' \
    '' \
    '[Service]' \
    'Type=oneshot' \
    "ExecStart=\"$bin_dir/claude-sync-checklist\"" \
    'TimeoutStartSec=2min'

write_unit switchstand-claude-sync.timer \
    '[Unit]' \
    'Description=Check Claude coordination state every 20 minutes' \
    '' \
    '[Timer]' \
    'OnCalendar=*:0/20' \
    'Persistent=true' \
    'Unit=switchstand-claude-sync.service' \
    '' \
    '[Install]' \
    'WantedBy=timers.target'

write_unit switchstand-claude-mailbox.service \
    '[Unit]' \
    'Description=Mark the bound Claude mailbox check due' \
    '' \
    '[Service]' \
    'Type=oneshot' \
    "ExecStart=\"$bin_dir/claude-sync-checklist\" --mailbox-due" \
    'TimeoutStartSec=30s'

write_unit switchstand-claude-mailbox.timer \
    '[Unit]' \
    'Description=Remind Claude to read its mailbox every 5 minutes' \
    '' \
    '[Timer]' \
    'OnCalendar=*:0/5' \
    'Persistent=true' \
    'Unit=switchstand-claude-mailbox.service' \
    '' \
    '[Install]' \
    'WantedBy=timers.target'

systemctl --user daemon-reload
systemctl --user enable --now switchstand-claude-sync.timer switchstand-claude-mailbox.timer
