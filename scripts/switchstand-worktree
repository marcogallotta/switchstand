#!/bin/sh
set -eu
if [ "$#" -ne 2 ] && [ "$#" -ne 3 ]; then
    echo "usage: scripts/switchstand-worktree <writer-name> <exact-green-sha> [exact-head-sha]" >&2
    exit 2
fi
name=$1
green_sha=$2
head_sha=${3:-$2}
exact_head=false
[ "$#" -ne 3 ] || exact_head=true
case "$name" in *[!a-z0-9-]*|'') echo "writer name must use a-z, 0-9 and hyphens" >&2; exit 2;; esac
for value in "$green_sha" "$head_sha"; do
    case "$value" in *[!0-9a-f]*|'') echo "exact SHA must be hexadecimal" >&2; exit 2;; esac
    if [ "${#value}" -ne 40 ]; then
        echo "exact SHA must contain 40 hexadecimal characters" >&2
        exit 2
    fi
done
repo=$(git rev-parse --show-toplevel)
common_dir=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)
git -C "$repo" cat-file -e "$green_sha^{commit}"
git -C "$repo" cat-file -e "$head_sha^{commit}"
if ! git -C "$repo" merge-base --is-ancestor "$green_sha" "$head_sha"; then
    echo "requested head is not based on the requested green baseline" >&2
    exit 1
fi
target=${TMPDIR:-/tmp}/switchstand-$name
branch=v2-$name
target_exists=false
[ ! -e "$target" ] || target_exists=true
branch_exists=false
if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
    branch_exists=true
fi
if [ "$target_exists" = true ] || [ "$branch_exists" = true ]; then
    if [ "$target_exists" = true ] && [ "$branch_exists" = true ]; then
        actual_root=$(git -C "$target" rev-parse --show-toplevel 2>/dev/null || true)
        actual_branch=$(git -C "$target" branch --show-current 2>/dev/null || true)
        actual_head=$(git -C "$target" rev-parse HEAD 2>/dev/null || true)
        actual_git=$(git -C "$target" rev-parse --absolute-git-dir 2>/dev/null || true)
        actual_common=$(git -C "$target" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
        dirty=$(git -C "$target" status --porcelain 2>/dev/null || printf 'unknown\n')
        recorded_green=
        recorded_head=
        if [ -n "$actual_git" ]; then
            recorded_green=$(cat "$actual_git/switchstand-green-sha" 2>/dev/null || true)
            recorded_head=$(cat "$actual_git/switchstand-candidate-sha" 2>/dev/null || true)
        fi
        based_on_requested=false
        if [ "$actual_head" = "$green_sha" ] \
                || git -C "$target" merge-base --is-ancestor "$green_sha" "$actual_head" 2>/dev/null; then
            based_on_requested=true
        fi
        head_matches=true
        if [ "$exact_head" = true ] && { [ "$actual_head" != "$head_sha" ] || [ "$recorded_head" != "$head_sha" ]; }; then
            head_matches=false
        fi
        registered=false
        if [ -n "$actual_common" ] && [ "$actual_common" = "$common_dir" ] \
                && [ -n "$actual_git" ] && [ "$actual_git" != "$actual_common" ] \
                && git -C "$repo" worktree list --porcelain 2>/dev/null \
                    | awk -v target="$target" '
                        /^worktree / {
                            path = substr($0, 10)
                            if (path == target) found = 1
                        }
                        END { exit found ? 0 : 1 }
                    '
        then
            registered=true
        fi
        if [ "$actual_root" = "$target" ] && [ "$actual_branch" = "$branch" ] \
                && [ "$based_on_requested" = true ] && [ "$head_matches" = true ] \
                && [ "$recorded_green" = "$green_sha" ] && [ -z "$dirty" ] \
                && [ "$registered" = true ]; then
            echo "$target"
            exit 0
        fi
    fi
    echo "existing task writer is not a clean registered linked worktree of the requesting repository at the requested starting point: $target" >&2
    exit 1
fi
git -C "$repo" worktree add -b "$branch" "$target" "$head_sha" >&2
git_dir=$(git -C "$target" rev-parse --absolute-git-dir)
printf '%s\n' "$green_sha" > "$git_dir/switchstand-green-sha"
if [ "$exact_head" = true ]; then
    printf '%s\n' "$head_sha" > "$git_dir/switchstand-candidate-sha"
fi
echo "$target"
