#!/bin/sh
set -eu
cleanup=false
if [ "${1:-}" = "--cleanup" ]; then
    cleanup=true
    shift
fi
if [ "$#" -ne 2 ]; then
    echo "usage: scripts/switchstand-worktree [--cleanup] <writer-name> <exact-green-sha>" >&2
    exit 2
fi
name=$1
sha=$2
case "$name" in *[!a-z0-9-]*|'') echo "writer name must use a-z, 0-9 and hyphens" >&2; exit 2;; esac
case "$sha" in *[!0-9a-f]*|'') echo "exact SHA must be hexadecimal" >&2; exit 2;; esac
if [ "${#sha}" -ne 40 ]; then
    echo "exact SHA must contain 40 hexadecimal characters" >&2
    exit 2
fi
repo=$(git rev-parse --show-toplevel)
common=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)
git -C "$repo" cat-file -e "$sha^{commit}"
target=${TMPDIR:-/tmp}/switchstand-$name
branch=v2-$name

report_state() {
    observed_branch=$(git -C "$target" branch --show-current 2>/dev/null || true)
    observed_head=$(git -C "$target" rev-parse HEAD 2>/dev/null || true)
    observed_common=$(git -C "$target" rev-parse --path-format=absolute --git-common-dir \
        2>/dev/null || true)
    observed_dirty=$(git -C "$target" status --porcelain 2>/dev/null || printf 'unknown\n')
    state=clean
    [ -z "$observed_dirty" ] || state=dirty-or-unknown
    echo "preserving task writer: target=$target branch=$branch observed_branch=${observed_branch:-unknown} head=${observed_head:-unknown} common=${observed_common:-unknown} state=$state" >&2
}

exact_owned_writer() {
    [ -e "$target" ] || return 1
    actual_root=$(git -C "$target" rev-parse --show-toplevel 2>/dev/null || true)
    actual_branch=$(git -C "$target" branch --show-current 2>/dev/null || true)
    actual_head=$(git -C "$target" rev-parse HEAD 2>/dev/null || true)
    actual_git=$(git -C "$target" rev-parse --absolute-git-dir 2>/dev/null || true)
    actual_common=$(git -C "$target" rev-parse --path-format=absolute --git-common-dir \
        2>/dev/null || true)
    dirty=$(git -C "$target" status --porcelain 2>/dev/null || printf 'unknown\n')
    green=
    [ -z "$actual_git" ] || green=$(cat "$actual_git/switchstand-green-sha" 2>/dev/null || true)
    registered=false
    if git -C "$repo" worktree list --porcelain 2>/dev/null | grep -Fqx "worktree $target"; then
        registered=true
    fi
    [ "$actual_root" = "$target" ] && [ "$actual_branch" = "$branch" ] \
        && [ "$actual_head" = "$sha" ] && [ "$green" = "$sha" ] && [ -z "$dirty" ] \
        && [ "$actual_common" = "$common" ] && [ "$registered" = true ]
}

if [ "$cleanup" = true ]; then
    if [ -e "$target" ]; then
        if ! exact_owned_writer; then
            report_state
            exit 0
        fi
        git -C "$repo" worktree remove "$target" || {
            echo "could not remove exact failed-launch writer; preserving $target" >&2
            exit 0
        }
    fi
    if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
        branch_head=$(git -C "$repo" rev-parse "refs/heads/$branch")
        if [ "$branch_head" != "$sha" ] \
                || git -C "$repo" worktree list --porcelain 2>/dev/null \
                    | grep -Fqx "branch refs/heads/$branch"; then
            echo "preserving task writer branch: branch=$branch head=$branch_head" >&2
            exit 0
        fi
        git -C "$repo" update-ref -d "refs/heads/$branch" "$sha" || {
            echo "could not remove exact failed-launch branch; preserving $branch" >&2
            exit 0
        }
    fi
    echo "cleaned untouched failed-launch writer: target=$target branch=$branch" >&2
    exit 0
fi

target_exists=false
[ ! -e "$target" ] || target_exists=true
branch_exists=false
if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
    branch_exists=true
fi
if [ "$target_exists" = true ] || [ "$branch_exists" = true ]; then
    if [ "$target_exists" = true ] && [ "$branch_exists" = true ] && exact_owned_writer; then
        echo "$target"
        exit 0
    fi
    report_state
    echo "existing task writer is not the exact clean owned requested baseline: $target" >&2
    exit 1
fi
git -C "$repo" worktree add -b "$branch" "$target" "$sha" >&2
git_dir=$(git -C "$target" rev-parse --absolute-git-dir)
printf '%s\n' "$sha" > "$git_dir/switchstand-green-sha"
echo "$target"
