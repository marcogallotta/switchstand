#!/usr/bin/env python3
"""Keep an opted-in top-level Codex run active until it deliberately yields."""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
import urllib.request
from datetime import UTC, datetime
from pathlib import Path
from typing import Any

MODES = {"OFF", "PILOT"}
LIFETIMES = {"ASSIGNMENT", "STANDING"}
MARKER_NAMES = ("ASSIGNMENT_COMPLETE", "REAL_BLOCKER", "HANDOFF", "USER_STOP")
MARKERS = frozenset(MARKER_NAMES)
MARKER_PATTERN = "|".join(MARKER_NAMES)
MARKER = re.compile(rf"<!-- SWITCHSTAND_YIELD:({MARKER_PATTERN}) -->")
TERMINAL_MARKER = re.compile(
    rf"\A\s*<!-- SWITCHSTAND_YIELD:({MARKER_PATTERN}) -->\s*\Z"
)
CONTINUATION = (
    "This top-level Codex assignment is still active. Do not end merely because you replied, "
    "reported status, finished one item, received feedback, or hit a partial blocker. Continue "
    "the next owned executable action. If the run is genuinely finished, blocked, stopped, or "
    "handed off, reissue a dedicated final reply containing exactly one permitted hidden yield "
    "marker and no other text: {markers}."
)
PROMPT_CONTEXT = (
    "This user message arrived while the top-level assignment is active. Treat it as an "
    "interrupt or steer, not a replacement unless it explicitly stops, pauses, cancels, "
    "reassigns, or replaces the work. Reply promptly, then resume the suspended owned work."
)


def _arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--mode", required=True)
    parser.add_argument("--lifetime", required=True)
    parser.add_argument("--telemetry", type=Path, required=True)
    return parser.parse_args()


def _append(path: Path, event: dict[str, Any]) -> None:
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    descriptor = os.open(path, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
    with os.fdopen(descriptor, "a") as handle:
        handle.write(json.dumps(event, sort_keys=True, separators=(",", ":")) + "\n")


def _event(payload: dict[str, Any], **values: Any) -> dict[str, Any]:
    return {
        "at": datetime.now(UTC).isoformat(),
        "session_id": payload.get("session_id"),
        "turn_id": payload.get("turn_id"),
        **values,
    }


def _fail_open(telemetry: Path, payload: dict[str, Any], reason: str) -> None:
    try:
        _append(telemetry, _event(payload, event="hook_error", hook_error=reason))
    except OSError:
        pass
    print(json.dumps({
        "continue": True,
        "systemMessage": f"Switchstand continuity hook failed open: {reason}",
    }))


def _subagent(payload: dict[str, Any]) -> bool:
    return any(key in payload for key in ("agent_id", "agent_type", "agent_transcript_path"))


def _local_target(session_id: str) -> bool:
    # This scopes UNKNOWN release only. The edge still validates generation,
    # mailbox, assignments and authority before any corrective action is returned.
    try:
        value = json.loads((Path.home() / ".config/switchstand/codex-stop-head.json").read_text())
        return isinstance(value, dict) and value.get("session_id") == session_id
    except (OSError, ValueError, TypeError):
        return False


def _evidence(session_id: str) -> dict[str, Any]:
    endpoint = os.getenv(
        "SWITCHSTAND_CODEX_STOP_ENDPOINT", "http://127.0.0.1:8790/internal/codex-stop-mailbox",
    )
    request = urllib.request.Request(
        endpoint, data=json.dumps({
            "session_id": session_id, "check_obligations": True,
        }).encode(), headers={"Content-Type": "application/json"}, method="POST",
    )
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    with opener.open(request, timeout=2) as response:
        evidence = json.load(response)
    if not isinstance(evidence, dict):
        raise TypeError("malformed Coordinator evidence")
    return evidence


def _legacy_reason(marker: str | None, lifetime: str) -> str | None:
    if marker in MARKERS and not (marker == "ASSIGNMENT_COMPLETE" and lifetime == "STANDING"):
        return None
    markers = ", ".join(
        f"`<!-- SWITCHSTAND_YIELD:{value} -->`" for value in MARKER_NAMES
        if lifetime == "ASSIGNMENT" or value != "ASSIGNMENT_COMPLETE"
    )
    return CONTINUATION.format(markers=markers)


def main() -> None:
    arguments = _arguments()
    payload: dict[str, Any] = {}
    try:
        raw = json.load(sys.stdin)
        if not isinstance(raw, dict):
            raise ValueError("hook payload is not an object")
        payload = raw
        if arguments.mode not in MODES or arguments.lifetime not in LIFETIMES:
            raise ValueError("generated continuity mode or lifetime is invalid")
        event = payload.get("hook_event_name")
        if event not in {"UserPromptSubmit", "Stop"}:
            raise ValueError("unsupported hook event")
        if arguments.mode == "OFF":
            print("{}")
            return
        if event == "UserPromptSubmit":
            if _subagent(payload):
                print("{}")
                return
            print(json.dumps({"hookSpecificOutput": {
                "hookEventName": "UserPromptSubmit",
                "additionalContext": PROMPT_CONTEXT,
            }}))
            return

        message = payload.get("last_assistant_message")
        if message is not None and not isinstance(message, str):
            raise ValueError("last_assistant_message is not a string or null")
        matches = list(MARKER.finditer(message or ""))
        terminal = TERMINAL_MARKER.search(message or "")
        marker = terminal.group(1) if terminal and len(matches) == 1 else None
        active = payload.get("stop_hook_active")
        if not isinstance(active, bool):
            raise ValueError("missing stop_hook_active")
        action = None
        reason = None
        session_id = payload.get("session_id")
        targeted = isinstance(session_id, str) and _local_target(session_id) and not _subagent(payload)
        if marker != "USER_STOP":
            if not targeted:
                # A global script replacement must not disable the previous
                # continuity policy or make it depend on Tracker availability.
                reason = _legacy_reason(marker, arguments.lifetime)
            elif not active:
                evidence = _evidence(session_id)
                if evidence.get("status") != "ok" or evidence.get("currentness") != "CURRENT":
                    raise ValueError(
                        "UNKNOWN Coordinator evidence; preserve outstanding obligations; "
                        "do not claim completion"
                    )
                actions = evidence.get("actions")
                if not isinstance(actions, list) or not all(isinstance(a, str) and a for a in actions):
                    raise ValueError("malformed Coordinator actions")
                if marker is None:
                    raise ValueError(
                        "UNKNOWN yield intent: Stop has no conversation/completion signal; "
                        "preserve outstanding obligations; do not claim completion"
                    )
                action = actions[0] if actions else None
        _append(arguments.telemetry, _event(
            payload,
            event="stop",
            stop_attempt=2 if active else 1,
            blocked=1 if action or reason else 0,
            attempted_yield_marker=marker,
            # Existing consumers treat ASSIGNMENT_COMPLETE as certified completion.
            # This hook only rejects proven runnable work; release proves no completion.
            yield_marker=None if targeted and marker == "ASSIGNMENT_COMPLETE" else marker,
            hook_error=None,
        ))
        if reason is not None:
            print(json.dumps({"decision": "block", "reason": reason}))
        elif action is None:
            print("{}")
        else:
            print(json.dumps({"decision": "block", "reason": (
                f"Fresh Tracker evidence shows an unfinished Coordinator action: {action}. "
                "Perform that exact action within current authority. This is the only corrective "
                "continuation for this human turn. Explicit STOP takes precedence. If the next "
                "Stop releases with work remaining, preserve it and do not claim completion."
            )}))
    except (OSError, TypeError, ValueError, json.JSONDecodeError) as error:
        _fail_open(arguments.telemetry, payload, str(error))


if __name__ == "__main__":
    main()
