#!/usr/bin/env python3
"""Inactive host bootstrap. issue/revoke require separately approved exact protected effects."""
import argparse
import asyncio
import hashlib
import json
import os
from pathlib import Path

from sqlalchemy.ext.asyncio import create_async_engine

from switchstand.chatgpt_alerts import bootstrap, plan, read_manifest, revoke
from switchstand.grant_state import GrantState


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=["plan", "issue", "check", "revoke"])
    parser.add_argument("--manifest", required=True, type=Path)
    parser.add_argument("--manifest-sha256")
    parser.add_argument("--package")
    args = parser.parse_args()
    if args.action == "plan":
        value = plan(args.package or "")
        raw = value.model_dump_json(indent=2).encode()
        descriptor = os.open(args.manifest, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(raw)
        print(json.dumps({"status": "planned_only", "sha256": hashlib.sha256(raw).hexdigest()}))
        return
    if not args.manifest_sha256:
        parser.error("--manifest-sha256 is required")
    manifest = read_manifest(args.manifest, args.manifest_sha256)

    async def execute():
        # Only an explicit trusted-host invocation supplies its existing DB capability.
        engine = create_async_engine(os.environ["DATABASE_URL"])
        try:
            grants = GrantState(engine)
            if args.action == "revoke":
                await revoke(manifest, grants)
                print(json.dumps({"status": "revoked", "version": 2}))
            else:
                binding = await bootstrap(manifest, grants, issue=args.action == "issue")
                print(json.dumps({"status": "verified", "name": binding.name,
                    "endpoint": str(binding.endpoint_id), "generation": binding.generation,
                    "grant_version": 1}))
        finally:
            await engine.dispose()
    asyncio.run(execute())


if __name__ == "__main__":
    main()
