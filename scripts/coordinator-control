#!/usr/bin/env python3
"""Record and compare the controls loaded by one Coordinator generation."""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import re
import subprocess
import tempfile
import uuid
from datetime import UTC, datetime
from pathlib import Path
from typing import Any
from urllib.parse import urlsplit

LINK = re.compile(r"\[[^]]*\]\(([^)#]+)(?:#[^)]*)?\)")
SHA256 = re.compile(r"[0-9a-f]{64}")
FROZEN_REPOSITORY_FILES = (
    ".codex/config.toml",
    "scripts/codex-dispatch",
    "scripts/codex-coordinator-profile",
    "scripts/codex-continuity-hook",
    "scripts/codex-hook",
    "scripts/coordinator-control",
    "scripts/coordinator-handoff",
)


def digest_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def canonical_digest(payload: dict[str, Any]) -> str:
    unsigned = {key: value for key, value in payload.items() if key != "manifest_digest"}
    encoded = json.dumps(unsigned, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(encoded).hexdigest()


def argv_digest(values: list[str]) -> str:
    digest = hashlib.sha256()
    for value in values:
        encoded = value.encode()
        digest.update(len(encoded).to_bytes(8, "big"))
        digest.update(encoded)
    return digest.hexdigest()


def atomic_json(path: Path, payload: dict[str, Any], *, exclusive: bool = False) -> None:
    output = json.dumps(payload, indent=2, sort_keys=True) + "\n"
    path.parent.mkdir(parents=True, exist_ok=True)
    if exclusive:
        descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(descriptor, "w") as handle:
            handle.write(output)
        return
    with tempfile.NamedTemporaryFile("w", dir=path.parent, delete=False) as handle:
        temporary = Path(handle.name)
        handle.write(output)
    os.chmod(temporary, 0o600)
    os.replace(temporary, path)


def repository_head(repo: Path) -> str:
    return subprocess.check_output(
        ["git", "-C", str(repo), "rev-parse", "HEAD"], text=True, timeout=5
    ).strip()


def markdown_dependencies(
    repo: Path,
) -> tuple[dict[str, str], list[dict[str, str]]]:
    pending = [Path("AGENTS.md")]
    found: dict[str, str] = {}
    visited: set[str] = set()
    unresolved: list[dict[str, str]] = []
    root = repo.resolve()
    while pending:
        relative = pending.pop()
        if relative.as_posix() in visited:
            continue
        visited.add(relative.as_posix())
        candidate = (root / relative).resolve()
        identity = relative.as_posix()
        if not candidate.is_relative_to(root):
            unresolved.append({"source": identity, "target": identity, "reason": "outside_root"})
            continue
        if not candidate.exists():
            unresolved.append({"source": identity, "target": identity, "reason": "missing"})
            continue
        if not candidate.is_file():
            unresolved.append(
                {"source": identity, "target": identity, "reason": "unsupported_file_type"}
            )
            continue
        try:
            content = candidate.read_text()
            found[identity] = digest_file(candidate)
        except OSError, UnicodeError:
            unresolved.append({"source": identity, "target": identity, "reason": "unreadable"})
            continue
        for raw in LINK.findall(content):
            target = raw.split("?", 1)[0]
            if not target.lower().endswith(".md"):
                continue
            parsed = urlsplit(target)
            if parsed.scheme in {"http", "https"}:
                continue
            if parsed.scheme or parsed.netloc:
                unresolved.append(
                    {"source": identity, "target": raw, "reason": "unsupported_scheme"}
                )
                continue
            try:
                resolved = (candidate.parent / parsed.path).resolve()
            except OSError, RuntimeError:
                unresolved.append({"source": identity, "target": raw, "reason": "unresolvable"})
                continue
            if not resolved.is_relative_to(root):
                unresolved.append({"source": identity, "target": raw, "reason": "outside_root"})
                continue
            pending.append(resolved.relative_to(root))
    key = lambda item: (item["source"], item["target"], item["reason"])
    return dict(sorted(found.items())), sorted(unresolved, key=key)


def component(identifier: str, path: Path) -> dict[str, str]:
    return {"id": identifier, "path": str(path), "sha256": digest_file(path)}


def handoff_artifact(start_record: Path, raw: str) -> Path:
    root = (start_record.parent.parent / "handoffs").resolve(strict=True)
    artifact = Path(raw).resolve(strict=True)
    if (
        artifact.parent != root
        or not artifact.name.startswith("handoff-")
        or not artifact.is_dir()
    ):
        raise ValueError("handoff artifact is outside the private handoff root")
    return artifact


def write_launch_manifest(
    destination: Path,
    manifest: dict[str, Any],
    start_record: Path,
    successor_eligible: bool,
) -> None:
    pending = start_record.parent / "pending-handoff.json"
    lock = start_record.parent / "handoff.lock"
    with lock.open("a+") as handle:
        os.chmod(lock, 0o600)
        fcntl.flock(handle, fcntl.LOCK_EX)
        artifact: Path | None = None
        handoff: dict[str, Any] | None = None
        if successor_eligible and pending.exists():
            pointer = json.loads(pending.read_text())
            artifact = handoff_artifact(start_record, pointer["artifact"])
            handoff = json.loads((artifact / "handoff.json").read_text())
            if (
                handoff.get("state") != "AWAITING_SUCCESSOR"
                or handoff.get("handoff_id") != pointer.get("handoff_id")
                or handoff.get("target_commit") != manifest["session"]["start_commit"]
                or handoff.get("obligations_sha256") != digest_file(artifact / "obligations")
            ):
                raise ValueError("pending handoff does not admit this successor launch")
            manifest["handoff"] = {
                "artifact": str(artifact),
                "handoff_id": handoff["handoff_id"],
                "obligations": str(artifact / "obligations"),
            }
        manifest["manifest_digest"] = canonical_digest(manifest)
        atomic_json(destination, manifest, exclusive=True)
        if artifact is not None and handoff is not None:
            proof = {
                "handoff_id": handoff["handoff_id"],
                "manifest": str(destination),
                "manifest_digest": manifest["manifest_digest"],
                "session_generation": manifest["session"]["generation"],
                "start_commit": manifest["session"]["start_commit"],
            }
            atomic_json(artifact / "successor-launch.json", proof, exclusive=True)
            handoff |= {
                "state": "SUCCESSOR_LAUNCHED",
                "successor_generation": manifest["session"]["generation"],
                "successor_manifest_digest": manifest["manifest_digest"],
            }
            atomic_json(artifact / "handoff.json", handoff)


def create(arguments: argparse.Namespace) -> int:
    repo = arguments.repo.resolve(strict=True)
    control_root = arguments.control_root.resolve(strict=True)
    start_record = arguments.start_record.resolve(strict=True)
    start_commit = start_record.read_text().strip()
    if start_commit != repository_head(repo):
        raise SystemExit("start record and repository HEAD differ")
    if not SHA256.fullmatch(arguments.invocation_digest):
        raise SystemExit("invocation digest must be one SHA-256 identity")
    profile_snapshot = arguments.profile.resolve(strict=True)
    runtime_profile = arguments.runtime_profile.resolve(strict=True)
    profile_digest = digest_file(profile_snapshot)
    if profile_digest != digest_file(runtime_profile):
        raise SystemExit("launch profile snapshot and runtime profile differ")
    frozen = [
        component(f"repository:{relative}", control_root / relative)
        for relative in FROZEN_REPOSITORY_FILES
    ]
    frozen += [
        component("host:codex-shim", arguments.shim.resolve(strict=True)),
        component("host:codex-executable", arguments.executable.resolve(strict=True)),
        component("generated:profile-snapshot", profile_snapshot),
        component("generated:hooks", arguments.hooks.resolve(strict=True)),
    ]
    rereadable, unresolved = markdown_dependencies(repo)
    manifest: dict[str, Any] = {
        "schema_version": 2,
        "session": {
            "generation": str(uuid.uuid4()),
            "started_at": datetime.now(UTC).isoformat(),
            "start_commit": start_commit,
            "start_record": str(start_record),
            "repository": str(repo),
            "invocation_digest": arguments.invocation_digest,
        },
        "frozen_controls": frozen,
        "runtime_mutable_controls": [
            {
                "id": "generated:runtime-profile",
                "path": str(runtime_profile),
                "launch_sha256": profile_digest,
                "snapshot": str(profile_snapshot),
            }
        ],
        "rereadable_controls": rereadable,
        "unresolved_rereadable_controls": unresolved,
        "unproved_frozen_controls": [
            {
                "id": "runtime:effective-client-tool-surface",
                "reason": "negotiated after launcher execution",
            }
        ],
    }
    destination = Path(f"{start_record}.manifest.json")
    write_launch_manifest(destination, manifest, start_record, arguments.successor_eligible)
    print(destination)
    return 0


def acknowledge(arguments: argparse.Namespace) -> int:
    manifest_path = arguments.manifest.resolve(strict=True)
    manifest = load_manifest(manifest_path)
    binding = manifest.get("handoff")
    if not isinstance(binding, dict):
        raise SystemExit("this Coordinator generation has no pending handoff")
    start_record = Path(manifest["session"]["start_record"]).resolve(strict=True)
    artifact = handoff_artifact(start_record, binding["artifact"])
    pending = start_record.parent / "pending-handoff.json"
    lock = start_record.parent / "handoff.lock"
    with lock.open("a+") as handle:
        fcntl.flock(handle, fcntl.LOCK_EX)
        handoff = json.loads((artifact / "handoff.json").read_text())
        proof = json.loads((artifact / "successor-launch.json").read_text())
        expected = {
            "handoff_id": handoff["handoff_id"],
            "manifest": str(manifest_path),
            "manifest_digest": manifest["manifest_digest"],
            "session_generation": manifest["session"]["generation"],
            "start_commit": manifest["session"]["start_commit"],
        }
        if (handoff.get("state") != "SUCCESSOR_LAUNCHED" or proof != expected
                or handoff.get("obligations_sha256") != digest_file(artifact / "obligations")):
            raise SystemExit("deterministic successor launch proof is absent or conflicting")
        pointer = json.loads(pending.read_text())
        if pointer.get("handoff_id") != handoff["handoff_id"]:
            raise SystemExit("pending handoff pointer changed before acknowledgement")
        acknowledgement = expected | {
            "acknowledgement": "SECONDARY_COORDINATOR_ACK",
            "acknowledged_at": datetime.now(UTC).isoformat(),
        }
        atomic_json(artifact / "successor-ack.json", acknowledgement, exclusive=True)
        handoff |= {"state": "ACKNOWLEDGED", "acknowledged_at": acknowledgement["acknowledged_at"]}
        atomic_json(artifact / "handoff.json", handoff)
        pending.unlink()
    print(json.dumps({"state": "ACKNOWLEDGED", **expected}, sort_keys=True))
    return 0


def load_manifest(path: Path) -> dict[str, Any]:
    payload = json.loads(path.read_text())
    schema_version = payload.get("schema_version")
    if schema_version not in (1, 2) or payload.get("manifest_digest") != canonical_digest(payload):
        raise ValueError("launch manifest identity is invalid")
    if (
        not isinstance(payload.get("session"), dict)
        or not isinstance(payload.get("frozen_controls"), list)
        or not isinstance(payload.get("rereadable_controls"), dict)
        or not isinstance(payload.get("unresolved_rereadable_controls"), list)
        or not isinstance(payload.get("unproved_frozen_controls"), list)
        or (
            schema_version == 2
            and not isinstance(payload.get("runtime_mutable_controls"), list)
        )
    ):
        raise TypeError("launch manifest structure is invalid")
    return payload


def check(arguments: argparse.Namespace) -> int:
    try:
        manifest_path = arguments.manifest.resolve(strict=True)
        manifest = load_manifest(manifest_path)
    except (OSError, TypeError, ValueError, json.JSONDecodeError) as error:
        print(json.dumps({"state": "CURRENTNESS_UNKNOWN", "reason": str(error)}, sort_keys=True))
        return 2
    state_path = Path(f"{manifest_path}.state.json")
    if state_path.exists():
        try:
            prior = json.loads(state_path.read_text())
        except (OSError, json.JSONDecodeError) as error:
            print(
                json.dumps({"state": "CURRENTNESS_UNKNOWN", "reason": str(error)}, sort_keys=True)
            )
            return 2
        if prior.get("state") == "CONTROL_STALE":
            print(json.dumps(prior, sort_keys=True))
            return 3
    mismatches: list[str] = []
    unknown: list[str] = []
    for item in manifest["frozen_controls"]:
        path = Path(item["path"])
        try:
            current = digest_file(path)
        except OSError:
            unknown.append(item["id"])
        else:
            if current != item["sha256"]:
                mismatches.append(item["id"])
    repo = Path(manifest["session"]["repository"])
    try:
        rereadable, unresolved = markdown_dependencies(repo)
        current_head = repository_head(repo)
    except (OSError, subprocess.SubprocessError) as error:
        output = {"state": "CURRENTNESS_UNKNOWN", "reason": str(error)}
        print(json.dumps(output, sort_keys=True))
        return 2
    original = manifest["rereadable_controls"]
    changed = sorted(
        path
        for path in set(original) | set(rereadable)
        if original.get(path) != rereadable.get(path)
    )
    if mismatches:
        output = {
            "state": "CONTROL_STALE",
            "session_generation": manifest["session"]["generation"],
            "frozen_mismatches": sorted(mismatches),
            "current_commit": current_head,
            "allowed_next": "reconcile_started_effects_preserve_obligations_and_handoff",
        }
        atomic_json(state_path, output)
        print(json.dumps(output, sort_keys=True))
        return 3
    required = sorted(rereadable) if arguments.trigger == "post-compaction" else changed
    output = {
        "state": "CURRENTNESS_UNKNOWN" if unknown or unresolved else "CURRENT",
        "session_generation": manifest["session"]["generation"],
        "current_commit": current_head,
        "unknown_components": sorted(unknown),
        "unresolved_rereadable_controls": unresolved,
        "reread_required": required,
        "required_live_reads": ["CURRENT_WORK", "OPEN_OBLIGATIONS", "START_COMMIT"],
        "unproved_frozen_controls": manifest["unproved_frozen_controls"],
        "component_currentness": {
            **{item["id"]: "CURRENTNESS_UNKNOWN" for item in manifest["unproved_frozen_controls"]},
            **{
                f"rereadable:{item['source']}->{item['target']}": "CURRENTNESS_UNKNOWN"
                for item in unresolved
            },
        },
    }
    print(json.dumps(output, sort_keys=True))
    return 2 if unknown or unresolved else 0


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser()
    commands = result.add_subparsers(dest="command", required=True)
    launch = commands.add_parser("create")
    launch.add_argument("--repo", type=Path, required=True)
    launch.add_argument("--control-root", type=Path, required=True)
    launch.add_argument("--start-record", type=Path, required=True)
    launch.add_argument("--profile", type=Path, required=True)
    launch.add_argument("--runtime-profile", type=Path, required=True)
    launch.add_argument("--hooks", type=Path, required=True)
    launch.add_argument("--executable", type=Path, required=True)
    launch.add_argument("--shim", type=Path, required=True)
    launch.add_argument("--invocation-digest", required=True)
    launch.add_argument("--successor-eligible", action="store_true")
    launch.set_defaults(function=create)
    current = commands.add_parser("check")
    current.add_argument("manifest", type=Path)
    current.add_argument("--trigger", choices=("post-compaction", "post-sync"), required=True)
    current.set_defaults(function=check)
    invocation = commands.add_parser("digest-argv")
    invocation.add_argument("values", nargs=argparse.REMAINDER)
    invocation.set_defaults(function=lambda arguments: print(argv_digest(arguments.values)) or 0)
    ack = commands.add_parser("acknowledge")
    ack.add_argument("manifest", type=Path)
    ack.set_defaults(function=acknowledge)
    return result


if __name__ == "__main__":
    parsed = parser().parse_args()
    raise SystemExit(parsed.function(parsed))
