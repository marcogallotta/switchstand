#!/bin/sh
set -eu

repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
common=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)
python=$(dirname "$common")/.venv/bin/python
[ -x "$python" ] || { echo "Switchstand environment is missing; run scripts/bootstrap" >&2; exit 1; }
exec env PYTHONPATH="$repo/src${PYTHONPATH:+:$PYTHONPATH}" \
    "$python" -m switchstand.edge_maintenance "$@"
