#!/bin/sh
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
common=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)
python=$(dirname "$common")/.venv/bin/python
if [ ! -x "$python" ]; then
    echo "run scripts/bootstrap before starting Coordinator control" >&2
    exit 1
fi
PYTHONPATH="$repo/src" exec "$python" -m switchstand.coordinator_sync
