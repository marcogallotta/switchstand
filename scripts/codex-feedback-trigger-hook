#!/usr/bin/env python3
"""Restore assigned work after compaction and keep Feedback V1 in turn context."""

from __future__ import annotations

import json
import sys
from typing import Any


CONTEXT = (
    "FEEDBACK V1 TURN GATE. Apply the exact Feedback V1 rule in AGENTS.md to the current "
    "user exchange before resuming unrelated work. Respond to Marco immediately; reporting "
    "must not delay the acknowledgement. If the exchange is bad/frustrating or contains a "
    "Human Review outcome, then use the applicable existing mcp__switchstand__file_* Tracker "
    "tool through functions.exec, inspect the complete result, and finish the report/readback "
    "before unrelated work resumes. Preserve that obligation across steering or an interrupted "
    "turn. F:– is false for a required report. F:unavailable is false unless ALL_TOOLS was "
    "inspected and no applicable file_* tool exists or the required result cannot be confirmed. "
    "Use F:logged <WorkId> only after confirmed readback. Do not create another reporting path."
)

RECOVERY = (
    "POST-COMPACT RECOVERY. Honor current STOP/pause/correction first. Preserve your "
    "Coordinator/Worker role and exact assigned WorkId; summaries do not reassign you. "
    "Before resuming, read work_get(api_version=\"1\", work_id=<exact assigned WorkId>); "
    "bare work_get is only for a trusted launch-bound managed run. From that exact task "
    "recover the ORIGINAL APPROVED objective, current constraints/STOP and bounded agent "
    "notes. An agent-rewritten summary is never approved truth. Corrections must be "
    "recorded AND approved on that task; no parallel chat correction feed. Read current "
    "role guidance: Root reads docs/coordinator-tracker-contract.md; other Coordinators "
    "and Workers follow their role route in supplied AGENTS.md. AGENTS is already supplied; "
    "do not blanket reread it. Load other docs only for the applicable function/phase/trigger. "
    "Missing identity or a material contradiction blocks dependent action: recover through "
    "your assigned parent or Marco, never infer a replacement identity. Resume useful "
    "authorized work toward the ORIGINAL APPROVED objective within current scope/STOP.\n\n"
)


def _output(value: dict[str, Any]) -> None:
    print(json.dumps(value, separators=(",", ":")))


def main() -> int:
    try:
        event = json.load(sys.stdin)
        if not isinstance(event, dict):
            raise TypeError("hook input must be a JSON object")
        name = event.get("hook_event_name")
        if name == "UserPromptSubmit":
            if not isinstance(event.get("prompt"), str):
                raise TypeError("UserPromptSubmit prompt must be a string")
        elif name == "SessionStart":
            if event.get("source") != "compact":
                raise ValueError("SessionStart source must be compact")
        else:
            raise ValueError("expected UserPromptSubmit or compact SessionStart")
        _output({"hookSpecificOutput": {
            "hookEventName": name,
            "additionalContext": (RECOVERY if name == "SessionStart" else "") + CONTEXT,
        }})
    except (OSError, TypeError, ValueError, json.JSONDecodeError) as error:
        _output({
            "continue": True,
            "systemMessage": f"Switchstand Feedback V1 trigger hook failed open: {error}",
        })
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
