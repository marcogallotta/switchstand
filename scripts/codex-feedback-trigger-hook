#!/usr/bin/env python3
"""Restore assigned work after compaction and keep Feedback V1 in turn context."""

from __future__ import annotations

import json
import sys
from typing import Any


CONTEXT = (
    "FEEDBACK V1. Respond to Marco immediately. During assigned work, notice concrete failures "
    "and hidden friction, including bad code/specs, missed findings, blockers, avoidable delay "
    "and agent-caused Marco frustration. Once observed, file it with the Feedback file_* tools "
    "before unrelated work; preserve this obligation across interruption. File every Human "
    "Review outcome, good or bad, with file_review_feedback. Classify honestly; never invent a "
    "defect. Respect STOP and explicit no-logging. Record approximate time when known. Inspect "
    "complete file_* results. Inspect ALL_TOOLS before saying Feedback is unavailable."
)

RECOVERY = (
    "POST-COMPACT RECOVERY. Honor current STOP/pause/correction first. "
    "Resume only your existing assignment; a question does not create work or a Coordinator role. "
    "If you have an assigned WorkId, read work_get(api_version=\"1\", work_id=<exact assigned WorkId>); "
    "bare work_get is only for a trusted launch-bound managed run. From that exact task "
    "recover the ORIGINAL APPROVED objective, current constraints/STOP and bounded agent "
    "notes. An agent-rewritten summary is never approved truth. Corrections must be "
    "recorded AND approved on that task; no parallel chat correction feed. Read current "
    "guidance for your assigned function in supplied AGENTS.md. Ordinary sessions work directly; "
    "Coordinator procedures apply only when explicitly assigned that role. AGENTS is already supplied; "
    "do not blanket reread it. Load other docs only for the applicable function/phase/trigger. "
    "Missing required task identity or a material contradiction blocks dependent assigned action: recover through "
    "your assigned parent or Marco, never infer a replacement identity. Resume useful "
    "authorized work toward the ORIGINAL APPROVED objective within current scope/STOP.\n\n"
)


def _output(value: dict[str, Any]) -> None:
    print(json.dumps(value, separators=(",", ":")))


def main() -> int:
    try:
        event = json.load(sys.stdin)
        if not isinstance(event, dict):
            raise TypeError("hook input must be a JSON object")
        name = event.get("hook_event_name")
        if name == "PostToolUse":
            # An older session may still have the removed registration loaded.
            _output({})
            return 0
        if name == "UserPromptSubmit":
            if not isinstance(event.get("prompt"), str):
                raise TypeError("UserPromptSubmit prompt must be a string")
        elif name == "SessionStart":
            if event.get("source") != "compact":
                raise ValueError("SessionStart source must be compact")
        else:
            raise ValueError("expected UserPromptSubmit, PostToolUse or compact SessionStart")
        _output({"hookSpecificOutput": {
            "hookEventName": name,
            "additionalContext": (RECOVERY if name == "SessionStart" else "") + CONTEXT,
        }})
    except (OSError, TypeError, ValueError, KeyError, json.JSONDecodeError) as error:
        _output({
            "continue": True,
            "systemMessage": f"Switchstand Feedback V1 trigger hook failed open: {error}",
        })
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
