#!/usr/bin/env python3
"""Switchstand-owned Codex guard for visible destructive shell commands."""

from __future__ import annotations

import json
import os
import shlex
import subprocess
import sys
from pathlib import Path

MUTATIONS = {
    "add", "am", "apply", "checkout", "cherry-pick", "clean", "commit", "merge",
    "fast-import", "gc", "init", "maintenance", "mv", "pull", "rebase", "replace",
    "reset", "restore", "revert", "rm", "stage", "submodule", "switch", "tag",
    "unstage", "update-index", "update-ref",
}
SHELLS = {"bash", "dash", "sh", "zsh"}


def deny(reason: str, event: str) -> dict[str, object]:
    return {"hookSpecificOutput": {"hookEventName": event,
            "permissionDecision": "deny", "permissionDecisionReason": reason}}


def segments(command: str) -> list[list[str]]:
    lexer = shlex.shlex(command, posix=True, punctuation_chars=";&|")
    lexer.whitespace_split = True
    lexer.commenters = ""
    result: list[list[str]] = []
    current: list[str] = []
    for token in lexer:
        if token and all(char in ";&|" for char in token):
            if current:
                result.append(current)
                current = []
        else:
            current.append(token)
    if current:
        result.append(current)
    return result


def git_parts(tokens: list[str], cwd: str) -> tuple[list[str], str, list[str], str] | None:
    if not tokens or Path(tokens[0]).name != "git":
        return None
    prefix: list[str] = []
    pos = 1
    command_cwd = cwd
    aliases: dict[str, str] = {}
    while pos < len(tokens):
        token = tokens[pos]
        if token == "-C" and pos + 1 < len(tokens):
            value = tokens[pos + 1]
            command_cwd = os.path.realpath(os.path.join(command_cwd, value))
            pos += 2
        elif token == "-c" and pos + 1 < len(tokens):
            value = tokens[pos + 1]
            prefix += [token, value]
            if value.startswith("alias.") and "=" in value:
                name, expansion = value.split("=", 1)
                aliases[name.removeprefix("alias.")] = expansion
            pos += 2
        elif token.startswith("-"):
            prefix.append(token)
            pos += 1
        else:
            break
    if pos == len(tokens):
        return None
    subcommand = tokens[pos]
    tail = tokens[pos + 1:]
    if subcommand in aliases:
        expansion = aliases[subcommand]
        nested = expansion[1:] if expansion.startswith("!") else "git " + expansion
        return git_parts(shlex.split(nested) + tail, command_cwd)
    return prefix, subcommand, tail, command_cwd


def inline_alias(tokens: list[str]) -> str | None:
    if not tokens or Path(tokens[0]).name != "git":
        return None
    aliases: dict[str, str] = {}
    pos = 1
    while pos < len(tokens):
        if tokens[pos] in {"-C", "-c"} and pos + 1 < len(tokens):
            if tokens[pos] == "-c" and tokens[pos + 1].startswith("alias.") and "=" in tokens[pos + 1]:
                name, expansion = tokens[pos + 1].split("=", 1)
                aliases[name.removeprefix("alias.")] = expansion
            pos += 2
        elif tokens[pos].startswith("-"):
            pos += 1
        else:
            break
    if pos == len(tokens) or tokens[pos] not in aliases:
        return None
    expansion = aliases[tokens[pos]]
    command = expansion[1:] if expansion.startswith("!") else "git " + expansion
    return command + (" " + shlex.join(tokens[pos + 1:]) if tokens[pos + 1:] else "")


def unwrap_env(tokens: list[str], cwd: str, reject_split: bool = False) -> tuple[list[str], str]:
    if tokens and "=" in tokens[0] and tokens[0].partition("=")[0].isidentifier():
        return tokens[1:], cwd
    if not tokens or Path(tokens[0]).name not in {"env", "command", "exec"}:
        return tokens, cwd
    wrapper = Path(tokens[0]).name
    pos = 1
    while pos < len(tokens):
        token = tokens[pos]
        if token == "--":
            return tokens[pos + 1:], cwd
        if reject_split and (token.startswith("--split-string") or token.startswith("-") and not token.startswith("--") and "S" in token[1:]):
            raise ValueError("env split-string is denied by the writer-bound guard")
        if wrapper == "env" and token.startswith("-") and not token.startswith("--") \
                and "S" in token[1:]:
            split_at = token.index("S")
            value = token[split_at + 1:] or tokens[pos + 1]
            consumed = 1 if token[split_at + 1:] else 2
            return unwrap_env(
                ["env", *shlex.split(value), *tokens[pos + consumed:]], cwd, reject_split
            )
        attached = wrapper == "env" and len(token) > 2 and token[:2] in {"-C", "-S"}
        option = token[:2] if attached else token.split("=", 1)[0]
        if wrapper == "env" and option in {"-C", "--chdir", "-S", "--split-string"}:
            inline = attached or "=" in token
            value = token[2:] if attached else token.split("=", 1)[1] if inline else tokens[pos + 1]
            pos += 1 if inline else 2
            if option in {"-C", "--chdir"}:
                cwd = os.path.realpath(os.path.join(cwd, value))
            else:
                return unwrap_env(["env", *shlex.split(value), *tokens[pos:]], cwd, reject_split)
        elif wrapper == "env" and token in {"-u", "--unset"} \
                or wrapper == "exec" and token == "-a":
            pos += 2
        elif token.startswith("-") or wrapper == "env" and "=" in token:
            pos += 1
        else:
            break
    return tokens[pos:], cwd


def _exact_task_writer(root: str, git_dir: str, common: str) -> bool:
    expected = os.environ.get("SWITCHSTAND_TASK_WRITER")
    task = os.environ.get("SWITCHSTAND_TASK_ID")
    if not expected or not task or os.path.realpath(expected) != os.path.realpath(root):
        return False
    if os.path.realpath(git_dir) != os.path.realpath(common):
        return False
    metadata = Path(common) / "switchstand-active-task"
    try:
        return metadata.is_file() and metadata.read_text().strip() == task
    except OSError:
        return False


def checkout_identity(prefix: list[str], cwd: str) -> tuple[str, str, str] | None:
    try:
        result = subprocess.run(
            ["git", *prefix, "rev-parse", "--path-format=absolute", "--show-toplevel",
             "--git-dir", "--git-common-dir"], cwd=cwd, text=True, capture_output=True,
            timeout=5, check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    lines = result.stdout.splitlines()
    if result.returncode or len(lines) != 3:
        return None
    if _exact_task_writer(lines[0], lines[1], lines[2]):
        return None
    return os.path.realpath(lines[0]), os.path.realpath(lines[1]), os.path.realpath(lines[2])


def primary_checkout(prefix: list[str], cwd: str) -> str | None:
    identity = checkout_identity(prefix, cwd)
    if identity is None:
        return None
    root, git_dir, common = identity
    return root if git_dir == common else None


def severe(tokens: list[str], cwd: str) -> str | None:
    if not tokens:
        return None
    name, args = Path(tokens[0]).name, tokens[1:]
    git = git_parts(tokens, cwd)
    if git:
        _prefix, subcommand, tail, _cwd = git
        if subcommand == "reset" and "--hard" in tail:
            return "git reset --hard"
        if subcommand == "clean":
            return "git clean"
        if subcommand == "push" and any(
            arg in {"-f", "--force", "--force-with-lease", "--mirror"}
            or arg.startswith(("--force-with-lease=", "+"))
            or (arg.startswith("-") and not arg.startswith("--") and "f" in arg[1:])
            for arg in tail
        ):
            return "git force push"
    if name == "rm" and any(arg in {"-r", "-R", "--recursive"}
            or (arg.startswith("-") and not arg.startswith("--") and "r" in arg.lower())
            for arg in args):
        return "recursive rm"
    if name in {"apt", "apt-get"} and any(arg in {"remove", "purge"} for arg in args):
        return "apt package removal"
    if name == "docker":
        words = [arg for arg in args if not arg.startswith("-")]
        joined = " ".join(words)
        if "volume rm" in joined or "volume prune" in joined:
            return "docker volume removal"
        if "system prune" in joined:
            return "docker system prune"
        if "compose" in words and "down" in words and any(arg in {"-v", "--volumes"} for arg in args):
            return "docker compose down --volumes"
    return None


def classify(
    command: str,
    cwd: str,
    coordinator_primary: str | None = None,
    coordinator_writer: str | None = None,
) -> str | None:
    current = cwd
    for tokens in segments(command):
        unwrapped, wrapped_cwd = unwrap_env(tokens, current)
        if unwrapped != tokens or wrapped_cwd != current:
            if reason := classify(shlex.join(unwrapped), wrapped_cwd,
                                  coordinator_primary, coordinator_writer):
                return reason
            continue
        if tokens and Path(tokens[0]).name in SHELLS:
            positions = [pos for pos, token in enumerate(tokens[:-1])
                         if token == "-c" or token.startswith("-") and token.endswith("c")]
            if positions:
                nested = classify(
                    tokens[positions[0] + 1], current, coordinator_primary,
                    coordinator_writer,
                )
                if nested:
                    return nested
        alias = inline_alias(tokens)
        if alias:
            nested = classify(alias, current, coordinator_primary, coordinator_writer)
            if nested:
                return nested
        if coordinator_primary is None:
            danger = severe(tokens, current)
            if danger:
                return f"[destructive-command] {danger} is forbidden."
        if tokens and Path(tokens[0]).name == "git-commit":
            identity = checkout_identity([], current)
            root = identity[0] if identity else None
            if root and (coordinator_primary is None or root == coordinator_primary):
                return (f"[primary-checkout] git git-commit is denied in {root}; "
                        "use a linked writer worktree.")
        git = git_parts(tokens, current)
        if git:
            prefix, subcommand, args, command_cwd = git
            branch_reads = {"--show-current", "--list", "-l", "--contains", "--no-contains",
                            "--merged", "--no-merged", "--points-at", "--format", "--sort",
                            "--all", "-a", "--remotes", "-r", "--verbose", "-v", "-vv"}
            branch_options = [arg for arg in args if arg.startswith("-")]
            branch_has_read = any(arg == flag or arg.startswith(flag + "=")
                                  for arg in branch_options for flag in branch_reads)
            branch_has_unknown_option = any(
                not any(arg == flag or arg.startswith(flag + "=") for flag in branch_reads)
                for arg in branch_options
            )
            branch_write = (subcommand == "branch" and bool(args)
                            and (branch_has_unknown_option or not branch_has_read))
            worktree_write = subcommand == "worktree" and bool(args) and (
                args[0] not in {"list", "add"}
            )
            tag_read = subcommand == "tag" and (not args or args[0].startswith(("--list", "--contains", "--points-at", "-l", "-n")))
            stash_read = subcommand == "stash" and args[:1] in (["list"], ["show"])
            config_actions = [arg for arg in args if not arg.startswith("-")]
            config_write_option = any(arg.startswith(("--add", "--edit", "--rename-section",
                                                       "--remove-section", "--replace-all",
                                                       "--unset")) for arg in args)
            config_read = subcommand == "config" and not config_write_option and (
                any(arg.startswith(("--get", "--list", "--show-")) or arg == "-l"
                    for arg in args)
                or len(config_actions) <= 1
                or config_actions[:1] in (["get"], ["get-all"], ["get-regexp"],
                                          ["get-urlmatch"], ["list"])
            )
            config_write = subcommand == "config" and not config_read
            remote_write = subcommand == "remote" and bool(args) and args[0] not in {
                "-v", "--verbose", "get-url", "show",
            }
            notes_read = subcommand == "notes" and (
                not args or args[:1] in (["get-ref"], ["list"], ["show"])
            )
            notes_write = subcommand == "notes" and not notes_read
            reflog_write = subcommand == "reflog" and args[:1] in (
                ["delete"], ["drop"], ["expire"], ["write"],
            )
            if ((subcommand in MUTATIONS and not tag_read and not stash_read)
                    or branch_write or worktree_write or config_write or remote_write
                    or notes_write or reflog_write):
                root = primary_checkout(prefix, command_cwd)
                if root and (coordinator_primary is None
                        or os.path.realpath(root) == coordinator_primary):
                    return (f"[primary-checkout] git {subcommand} is denied in {root}; "
                            "use a linked writer worktree.")
        if tokens[:1] == ["cd"] and len(tokens) == 2:
            current = os.path.realpath(os.path.join(current, tokens[1]))
    return None


def _inside(path: str, root: str) -> bool:
    try:
        return os.path.commonpath((path, root)) == root
    except ValueError:
        return False


def foreign_write(target: str, primary: str, writer: str | None) -> str | None:
    if _inside(target, primary):
        return (f"[primary-checkout] writing {target} is denied; "
                "use a linked writer worktree.")
    return None


def friction_binding(candidate: str, primary: str, writer: str | None) -> bool:
    logical = os.path.abspath(candidate)
    if writer is None:
        return logical == os.path.join(primary, "friction.md")
    bindings = {os.path.join(root, "friction.md") for root in (primary, writer)}
    durable = {
        os.path.realpath(os.path.expanduser("~/.local/state/switchstand/friction.md")),
        os.path.realpath(os.path.expanduser("~/.local/state/switchstand/friction/friction.md")),
    }
    return logical in bindings and os.path.islink(logical) and os.path.realpath(logical) in durable


def classify_patch(command: str, cwd: str, primary: str, writer: str | None) -> str | None:
    prefixes = ("*** Add File: ", "*** Update File: ", "*** Delete File: ", "*** Move to: ")
    for line in command.splitlines():
        raw = next((line.removeprefix(prefix) for prefix in prefixes
                    if line.startswith(prefix)), None)
        if raw is None:
            continue
        candidate = raw if os.path.isabs(raw) else os.path.join(cwd, raw)
        target = os.path.abspath(candidate) if writer is None else os.path.realpath(candidate)
        if not friction_binding(candidate, primary, writer):
            reason = foreign_write(target, primary, writer)
            if reason:
                return reason
    return None


EDIT_TOOLS = {"Edit", "MultiEdit", "NotebookEdit", "Write"}


def classify_edit(tool_input: dict, cwd: str, primary: str, writer: str | None) -> str | None:
    raw = tool_input.get("file_path") or tool_input.get("notebook_path")
    if not isinstance(raw, str):
        return None
    candidate = raw if os.path.isabs(raw) else os.path.join(cwd, raw)
    target = os.path.realpath(candidate)
    if friction_binding(candidate, primary, writer):
        return None
    return foreign_write(target, primary, writer)


def main() -> int:
    try:
        return run()
    except Exception as error:
        if len(sys.argv) in {3, 5} and sys.argv[1] == "--coordinator-primary":
            print(json.dumps(deny(f"[primary-checkout] guard failed closed: {error}",
                                  "PreToolUse")))
            return 0
        raise


def run() -> int:
    coordinator_primary = None
    coordinator_writer = None
    if len(sys.argv) == 5 and sys.argv[1] == "--coordinator-primary" \
            and sys.argv[3] == "--coordinator-writer":
        coordinator_primary = os.path.realpath(sys.argv[2])
        coordinator_writer = os.path.realpath(sys.argv[4])
    elif len(sys.argv) == 3 and sys.argv[1] == "--coordinator-primary":
        coordinator_primary = os.path.realpath(sys.argv[2])
    elif len(sys.argv) != 1:
        raise SystemExit(
            "usage: codex-hook [--coordinator-primary PATH [--coordinator-writer PATH]]"
        )
    payload = json.load(sys.stdin)
    event = str(payload.get("hook_event_name") or payload.get("hookEventName") or "PreToolUse")
    tool = payload.get("tool_name")
    if event not in {"PreToolUse", "PermissionRequest"}:
        return 0
    tool_input = payload.get("tool_input") or {}
    command = tool_input.get("command")
    cwd = str(payload.get("cwd") or os.getcwd())
    declared_workdir = tool_input.get("workdir")
    if isinstance(declared_workdir, str):
        cwd = os.path.realpath(os.path.join(cwd, declared_workdir))
    agent_id = payload.get("agent_id")
    if isinstance(agent_id, str) and agent_id and tool in EDIT_TOOLS | {"apply_patch", "Bash"}:
        print(json.dumps(deny(
            "[worker-read-only] delegated Workers cannot use shell or file-edit tools; "
            "return a patch or findings to Root.", event,
        )))
        return 0
    raw = tool_input.get("file_path") or tool_input.get("notebook_path")
    target = os.path.realpath(os.path.join(cwd, raw)) if isinstance(raw, str) else ""
    memory_root = os.path.realpath(os.path.expanduser("~/.claude/projects"))
    if tool in EDIT_TOOLS and _inside(target, memory_root):
        parts = Path(os.path.relpath(target, memory_root)).parts
        if len(parts) >= 3 and parts[1] == "memory":
            print(json.dumps(deny(f"[memory-write] blocked: auto-memory is not allowed ({target}).", event)))
            return 0
    if tool in EDIT_TOOLS and coordinator_primary is not None:
        reason = classify_edit(tool_input, cwd, coordinator_primary, coordinator_writer)
    elif not isinstance(command, str):
        return 0
    elif tool == "Bash":
        reason = classify(command, cwd, coordinator_primary, coordinator_writer)
    elif tool == "apply_patch" and coordinator_primary is not None:
        reason = classify_patch(command, cwd, coordinator_primary, coordinator_writer)
    else:
        return 0
    if reason:
        print(json.dumps(deny(reason, event)))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
