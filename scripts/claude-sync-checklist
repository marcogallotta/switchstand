#!/usr/bin/env python3
"""One durable sync checklist, used by both Claude and the systemd timers.

The unified pass does these steps in order:
1. list every open PRIORITIES.md/JOBS.md item with its age;
2. flag an item older than four hours when no matching Codex job is live;
3. count heavy and total live jobs, flag missing class markers and counts over
   four heavy or six total;
4. flag stale PRIORITIES.md, duplicate JOBS.md rows, dead declared jobs, and
   live jobs missing from JOBS.md;
5. atomically persist one SYNC-ALERT.md for SessionStart and Stop hooks.
The five-minute --mailbox-due pass persists an alert for bound Claude to read
and acknowledge because systemd has no mailbox session.
"""

import argparse
import fcntl
import importlib.machinery
import importlib.util
import os
import re
import subprocess
import sys
from collections import Counter
from datetime import datetime
from pathlib import Path
from zoneinfo import ZoneInfo

STALE_ITEM_SECONDS = 4 * 60 * 60
STALE_PRIORITIES_SECONDS = 20 * 60
MAX_HEAVY_JOBS = 4
MAX_TOTAL_JOBS = 6
TERMINAL = {"DONE", "STOPPED", "FAILED", "SUPERSEDED"}
OPEN_REMAINDERS = ("not deployed", "not activated", "not checked", "unverified")
WAITING_MARCO = re.compile(r"\bWAITING[- ]MARCO\b", re.IGNORECASE)


def atomic_write(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    temporary.write_text(text)
    os.replace(temporary, path)


def load_plan(script: Path):
    loader = importlib.machinery.SourceFileLoader("claude_plan_for_sync", str(script))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None:
        raise RuntimeError(f"cannot load {script}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[loader.name] = module
    loader.exec_module(module)
    return module


def normalized(value: str) -> str:
    return re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")


def live_job(unit: str) -> tuple[str, str, str | None] | None:
    value = unit.strip()
    match = re.fullmatch(
        r"ss-codex-(?:(heavy|light)-)?(.+?)(?:-\d{6})?\.scope", value
    )
    return (value, normalized(match.group(2)), match.group(1)) if match else None


def read_live_units(
    supplied: list[str] | None,
) -> tuple[list[tuple[str, str, str | None]], str | None]:
    if supplied is not None:
        return [job for unit in supplied if (job := live_job(unit))], None
    result = subprocess.run(
        [
            "systemctl",
            "--user",
            "list-units",
            "ss-codex-*.scope",
            "--state=running",
            "--plain",
            "--no-legend",
            "--no-pager",
        ],
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode:
        detail = result.stderr.strip() or f"systemctl exited {result.returncode}"
        return [], detail
    units = [line.split()[0] for line in result.stdout.splitlines() if line.split()]
    return [job for unit in units if (job := live_job(unit))], None


def parse_job_rows(path: Path) -> list[dict[str, str | int]]:
    rows: list[dict[str, str | int]] = []
    started = False
    for line in path.read_text().splitlines():
        if line.startswith("Stages:"):
            started = True
            continue
        if not started or not line.strip() or line.startswith("## "):
            continue
        fields = [field.strip() for field in line.strip().strip("|").split("|")]
        if len(fields) not in {4, 5}:
            plain = re.match(r"-?\s*([\w-]+)(?:\s*\([^)]*\))?:\s*(.+)", line)
            if not plain:
                continue
            fields = [plain.group(1), "", plain.group(2), ""]
        if len(fields) not in {4, 5} or fields[0].lower() in {"job", "session"}:
            continue
        if all(not field.strip("-: ") for field in fields):
            continue
        stage = fields[-2]
        rows.append(
            {
                "name": fields[0],
                "key": normalized(fields[0]),
                "stage": stage,
                "next": fields[-1],
            }
        )
    return rows


def stage_word(stage: str) -> str:
    match = re.match(r"\s*([A-Za-z]+)", stage)
    return match.group(1).upper() if match else ""


def closed(stage: str, next_step: str) -> bool:
    joined = f"{stage} {next_step}".lower()
    return (
        stage_word(stage) in TERMINAL
        and next_step.strip().lower() in {"", "-", "none"}
        and not any(marker in joined for marker in OPEN_REMAINDERS)
    )


def age_of(module, text: str, now: datetime) -> tuple[str, int | None]:
    seen, lower_bound = module.timestamp(text, now)
    if seen is None:
        return "UNKNOWN", None
    return module.duration(now, seen, lower_bound)


def matches_live(name: str, live: set[str]) -> bool:
    key = normalized(name)
    return bool(key) and any(
        key == running or key.startswith(f"{running}-") or running.startswith(f"{key}-")
        for running in live
    )


def pickup_item_names(path: Path) -> set[str]:
    names: set[str] = set()
    in_pickup = False
    for line in path.read_text().splitlines():
        if line.startswith("## "):
            in_pickup = line[3:].strip().upper().startswith("PICK UP HERE")
        elif line.strip() and (in_pickup or "PICK UP HERE" in line.upper()):
            item = re.sub(r"^\s*(?:[-*]|[A-Z]?\d+\.)\s*", "", line).strip()
            names.add(normalized(item.split(":", 1)[0]))
    return names


def waiting_key(name: str, waiting: dict[str, tuple[str, bool]]) -> str:
    key = normalized(name)
    return next(
        (
            existing
            for existing in waiting
            if key == existing or key.startswith(f"{existing}-") or existing.startswith(f"{key}-")
        ),
        key,
    )


def scan(args: argparse.Namespace, now: datetime) -> tuple[str, str]:
    module = load_plan(args.plan_script)
    live_jobs, live_error = read_live_units(args.live_unit)
    live = {name for _, name, _ in live_jobs}
    blockers: list[str] = []
    info: list[str] = []
    item_lines: list[str] = []
    unknown_ages = 0
    waiting: dict[str, tuple[str, bool]] = {}

    priority_age = int(now.timestamp() - args.priorities.stat().st_mtime)
    if priority_age > STALE_PRIORITIES_SECONDS:
        blockers.append(
            f"PRIORITIES_STALE: {module.duration(now, datetime.fromtimestamp(args.priorities.stat().st_mtime, tz=now.tzinfo))[0]} old"
        )
    if live_error:
        blockers.append(f"LIVE_JOBS_UNKNOWN: {live_error}")
    else:
        unclassified = [unit for unit, _, job_class in live_jobs if job_class is None]
        heavy_jobs = sum(job_class == "heavy" for _, _, job_class in live_jobs)
        total_jobs = len(live_jobs)
        for unit in unclassified:
            blockers.append(
                f"JOB_CLASS_UNKNOWN: {unit} must identify heavy or light after ss-codex-"
            )
        if heavy_jobs > MAX_HEAVY_JOBS:
            blockers.append(
                f"HEAVY_CAPACITY_EXCEEDED: {heavy_jobs} running; max {MAX_HEAVY_JOBS}"
            )
        if total_jobs > MAX_TOTAL_JOBS:
            blockers.append(
                f"TOTAL_CAPACITY_EXCEEDED: {total_jobs} running; max {MAX_TOTAL_JOBS}"
            )

    priority_items = module.priorities_items(args.priorities, now)
    pickup_names = pickup_item_names(args.priorities)
    for item in priority_items:
        if closed(item.state, "-"):
            continue
        age, seconds = age_of(module, item.state, now)
        running = None if live_error else matches_live(item.name, live)
        flags: list[str] = []
        is_waiting = bool(WAITING_MARCO.search(item.state))
        if is_waiting:
            key = waiting_key(item.name, waiting)
            waiting[key] = (f"{item.item_id} {item.name} [{age}]", matches_live(item.name, pickup_names))
        elif seconds is None:
            unknown_ages += 1
        elif seconds > STALE_ITEM_SECONDS and running is False:
            flags.append("STALE_NO_JOB")
        if flags:
            blockers.append(f"{','.join(flags)}: {item.item_id} {item.name} [{age}]")
        item_lines.append(
            f"- {item.item_id} | age {age} | job {'UNKNOWN' if running is None else ('LIVE' if running else 'NONE')} | {item.state}"
        )

    rows = parse_job_rows(args.jobs)
    counts = Counter(str(row["key"]) for row in rows)
    latest: dict[str, dict[str, str | int]] = {}
    for row in rows:
        latest[str(row["key"])] = row
    for key, count in sorted(counts.items()):
        if count > 1:
            blockers.append(f"JOBS_DRIFT: {key} has {count} rows; latest row wins")
    for key, row in latest.items():
        stage = str(row["stage"])
        next_step = str(row["next"])
        if closed(stage, next_step):
            continue
        age, seconds = age_of(module, f"{stage} {next_step}", now)
        running = None if live_error else matches_live(str(row["name"]), live)
        flags: list[str] = []
        is_waiting = bool(WAITING_MARCO.search(stage))
        if is_waiting:
            wait_key = waiting_key(str(row["name"]), waiting)
            prior = waiting.get(wait_key)
            covered = matches_live(str(row["name"]), pickup_names) or bool(prior and prior[1])
            waiting[wait_key] = (f"job:{key} [{age}] {stage}", covered)
        elif seconds is None:
            unknown_ages += 1
        elif seconds > STALE_ITEM_SECONDS and running is False:
            flags.append("STALE_NO_JOB")
        if stage_word(stage) == "RUNNING" and running is False:
            flags.append("DEAD_JOB")
        if flags:
            blockers.append(f"{','.join(flags)}: job:{key} [{age}] {stage}")
        item_lines.append(
            f"- job:{key} | age {age} | job {'UNKNOWN' if running is None else ('LIVE' if running else 'NONE')} | {stage} — {next_step}"
        )
    if not live_error:
        declared_running = {
            key for key, row in latest.items() if stage_word(str(row["stage"])) == "RUNNING"
        }
        for name in sorted(live):
            if not any(matches_live(key, {name}) for key in declared_running):
                blockers.append(f"UNTRACKED_JOB: {name} is live without a RUNNING JOBS.md row")
    for detail, covered in waiting.values():
        info.append(f"WAITING_MARCO: {detail}")
        if not covered:
            blockers.append(f"WAITING_MARCO_NO_PICK_UP: {detail}")
    if unknown_ages:
        info.append(f"AGE_UNKNOWN: {unknown_ages} open items; add a status timestamp")

    report = [f"# SYNC CHECK — {now:%Y-%m-%d %H:%M %Z}", "", "## Flags"]
    report.extend(f"- {finding}" for finding in [*blockers, *info])
    if not blockers and not info:
        report.append("- none")
    report.extend(
        [
            "",
            "## Capacity",
            (
                "- UNKNOWN"
                if live_error
                else f"- heavy {heavy_jobs}/{MAX_HEAVY_JOBS} | total {total_jobs}/{MAX_TOTAL_JOBS}"
            ),
            "",
            "## Every open item",
            *(item_lines or ["- none"]),
        ]
    )
    text = "\n".join(report) + "\n"
    alert = [f"# SYNC ALERT — {now:%Y-%m-%d %H:%M %Z}"]
    if blockers:
        alert.extend(["", "## Blocking", *(f"- {finding}" for finding in blockers)])
    if info:
        alert.extend(["", "## Info", *(f"- {finding}" for finding in info)])
    return text, "\n".join(alert) + "\n" if blockers or info else ""


def render_alert(state_dir: Path) -> None:
    scan_text = (
        (state_dir / ".sync-scan-alert").read_text()
        if (state_dir / ".sync-scan-alert").exists()
        else ""
    )
    mailbox = state_dir / ".mailbox-check-due"
    parts: list[str] = []
    if mailbox.exists():
        parts.append(
            "# MAILBOX CHECK DUE\n\nCall `agent_message_pending`, handle/ack messages, then run "
            "`$SWITCHSTAND_PRIMARY/scripts/claude-sync-checklist --ack-mailbox`.\n"
        )
    if scan_text:
        parts.append(scan_text)
    alert = state_dir / "SYNC-ALERT.md"
    if parts:
        atomic_write(alert, "\n".join(parts))
    else:
        alert.unlink(missing_ok=True)


def parser() -> argparse.ArgumentParser:
    state = Path.home() / ".local/state/switchstand"
    result = argparse.ArgumentParser(description=__doc__)
    result.add_argument(
        "--priorities", type=Path, default=state / "independent-audit-claude-20261008/PRIORITIES.md"
    )
    result.add_argument("--jobs", type=Path, default=state / "codex-runs/JOBS.md")
    result.add_argument(
        "--state-dir", type=Path, default=state / "independent-audit-claude-20261008"
    )
    result.add_argument("--plan-script", type=Path, default=Path(__file__).with_name("claude-plan"))
    result.add_argument("--now")
    result.add_argument("--live-unit", action="append", default=None)
    modes = result.add_mutually_exclusive_group()
    modes.add_argument("--mailbox-due", action="store_true")
    modes.add_argument("--ack-mailbox", action="store_true")
    return result


def main() -> int:
    args = parser().parse_args()
    args.state_dir.mkdir(parents=True, exist_ok=True)
    lock_path = args.state_dir / ".sync-alert.lock"
    report = ""
    with lock_path.open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if args.mailbox_due:
            atomic_write(
                args.state_dir / ".mailbox-check-due",
                f"{datetime.now().astimezone().isoformat()}\n",
            )
        elif args.ack_mailbox:
            (args.state_dir / ".mailbox-check-due").unlink(missing_ok=True)
        else:
            try:
                now = (
                    datetime.fromisoformat(args.now)
                    if args.now
                    else datetime.now(ZoneInfo("Europe/Rome"))
                )
                if now.tzinfo is None:
                    raise ValueError("--now needs a timezone offset")
                report, alert = scan(args, now)
                atomic_write(args.state_dir / ".sync-scan-alert", alert)
            except (OSError, RuntimeError, ValueError) as exc:
                atomic_write(
                    args.state_dir / ".sync-scan-alert",
                    f"# SYNC ALERT\n\n## Blocking\n- SCAN_UNKNOWN: {exc}\n",
                )
        render_alert(args.state_dir)
        if not args.mailbox_due and not args.ack_mailbox:
            alert = args.state_dir / "SYNC-ALERT.md"
            if alert.exists():
                print(alert.read_text(), end="")
            print(report, end="")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
