#!/bin/sh
set -eu

repo=${1:-/home/marco/switchstand}
source_script=$repo/scripts/sync-canonical-main
runner=${XDG_DATA_HOME:-$HOME/.local/share}/switchstand/bin/sync-canonical-main
unit_dir=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user

test -x "$source_script"
install -d -m 0755 "$(dirname "$runner")" "$unit_dir"
install -m 0755 "$source_script" "$runner"

service_tmp=$(mktemp "$unit_dir/.switchstand-canonical-main-sync.service.XXXXXX")
timer_tmp=$(mktemp "$unit_dir/.switchstand-canonical-main-sync.timer.XXXXXX")
trap 'rm -f "$service_tmp" "$timer_tmp"' EXIT

cat >"$service_tmp" <<EOF
[Unit]
Description=Fast-forward clean Switchstand canonical main
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart="$runner"
TimeoutStartSec=2min
Nice=10
IOSchedulingClass=idle
EOF

cat >"$timer_tmp" <<'EOF'
[Unit]
Description=Keep Switchstand canonical main current

[Timer]
OnBootSec=2min
OnUnitInactiveSec=5min
RandomizedDelaySec=30s
Persistent=true
Unit=switchstand-canonical-main-sync.service

[Install]
WantedBy=timers.target
EOF

chmod 0644 "$service_tmp" "$timer_tmp"
mv -f "$service_tmp" "$unit_dir/switchstand-canonical-main-sync.service"
mv -f "$timer_tmp" "$unit_dir/switchstand-canonical-main-sync.timer"
systemctl --user daemon-reload
systemctl --user enable --now switchstand-canonical-main-sync.timer
