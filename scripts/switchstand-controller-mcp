#!/bin/sh
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ "${SWITCHSTAND_MANAGED:-}" = 1 ]; then
    profile=${SWITCHSTAND_MANAGED_PROFILE:-full}
    if [ "$profile" = launch-bound ]; then
        : "${ACTIVE_WORK_ID:?launch-bound managed controller requires ACTIVE_WORK_ID}"
        : "${SWITCHSTAND_GRANT_ID:?launch-bound managed controller requires grant identity}" \
          "${SWITCHSTAND_GRANT_VERSION:?launch-bound managed controller requires grant version}"
        cd "$repo"
        set -- docker compose run --rm -T --no-deps \
            -e SWITCHSTAND_MANAGED_PROFILE=launch-bound \
            -e SWITCHSTAND_GRANT_ID -e SWITCHSTAND_GRANT_VERSION \
            -e SWITCHSTAND_PRIORITY_CLAIMS \
            -e "SWITCHSTAND_BUGS_PROJECT_ID=${SWITCHSTAND_BUGS_PROJECT_ID:-}" \
            -e "SWITCHSTAND_FEATURES_PROJECT_ID=${SWITCHSTAND_FEATURES_PROJECT_ID:-}" \
            -e "SWITCHSTAND_PROCESS_PROJECT_ID=${SWITCHSTAND_PROCESS_PROJECT_ID:-}" \
            -e "SWITCHSTAND_PERFORMANCE_PROJECT_ID=${SWITCHSTAND_PERFORMANCE_PROJECT_ID:-}" \
            -e "SWITCHSTAND_HUMAN_REVIEW_PROJECT_ID=${SWITCHSTAND_HUMAN_REVIEW_PROJECT_ID:-}" \
            -e "SWITCHSTAND_FORK_MANAGEMENT_PROJECT_ID=${SWITCHSTAND_FORK_MANAGEMENT_PROJECT_ID:-}" \
            -e SWITCHSTAND_ACTIVATION_CONTINUITY=0
        if [ "${SWITCHSTAND_ACTIVATION_CONTINUITY:-0}" = 1 ]; then
            : "${SWITCHSTAND_ACTIVATION_CONTRACTS_PATH:?required}" \
              "${SWITCHSTAND_PRODUCT_CURRENTNESS_QUALIFICATION_RECEIPT:?required}" \
              "${SWITCHSTAND_PRODUCT_CURRENTNESS_QUALIFICATION_KEY:?required}"
            [ "${SWITCHSTAND_PRODUCT_CURRENTNESS:-}" = 1 ] || {
                echo "SWITCHSTAND_PRODUCT_CURRENTNESS must be 1" >&2; exit 1;
            }
            for value in "$SWITCHSTAND_ACTIVATION_CONTRACTS_PATH" \
                "$SWITCHSTAND_PRODUCT_CURRENTNESS_QUALIFICATION_RECEIPT" \
                "$SWITCHSTAND_PRODUCT_CURRENTNESS_QUALIFICATION_KEY"; do
                case "$value" in /*) ;; *) echo "activation input must be absolute" >&2; exit 1;; esac
                [ "$(realpath "$value")" = "$value" ] && [ -f "$value" ] && \
                    [ -r "$value" ] && [ ! -L "$value" ] || {
                    echo "activation input must be a readable regular non-symlink" >&2; exit 1;
                }
            done
            set -- "$@" -e SWITCHSTAND_ACTIVATION_CONTINUITY=1 \
                -e SWITCHSTAND_PRODUCT_CURRENTNESS \
                -e SWITCHSTAND_PRODUCT_CURRENTNESS_RUNTIME_SHA \
                -e SWITCHSTAND_PRODUCT_CURRENTNESS_SELECTED_RUNTIME_SHA \
                -e SWITCHSTAND_PRODUCT_CURRENTNESS_RUN_ID \
                -e SWITCHSTAND_PRODUCT_CURRENTNESS_EXPECTED_TOOLS_SCHEMA_SHA256 \
                -e SWITCHSTAND_PRODUCT_CURRENTNESS_TOOL_NAMES \
                -e SWITCHSTAND_ACTIVATION_CONTRACTS_PATH=/run/switchstand/contracts.json \
                -e SWITCHSTAND_PRODUCT_CURRENTNESS_QUALIFICATION_RECEIPT=/run/switchstand/receipt.json \
                -e SWITCHSTAND_PRODUCT_CURRENTNESS_QUALIFICATION_KEY=/run/switchstand/qualification.key \
                -v "$(realpath "$SWITCHSTAND_ACTIVATION_CONTRACTS_PATH"):/run/switchstand/contracts.json:ro" \
                -v "$(realpath "$SWITCHSTAND_PRODUCT_CURRENTNESS_QUALIFICATION_RECEIPT"):/run/switchstand/receipt.json:ro" \
                -v "$(realpath "$SWITCHSTAND_PRODUCT_CURRENTNESS_QUALIFICATION_KEY"):/run/switchstand/qualification.key:ro"
        fi
        exec "$@" controller
    fi
    [ "$profile" = full ] || {
        echo "unknown managed MCP profile: $profile" >&2
        exit 1
    }
    : "${ACTIVE_WORK_ID:?managed controller requires ACTIVE_WORK_ID}"
    : "${SWITCHSTAND_WORKTREE:?managed controller requires SWITCHSTAND_WORKTREE}"
    : "${SWITCHSTAND_BRANCH:?managed controller requires SWITCHSTAND_BRANCH}"
    : "${SWITCHSTAND_GIT_DIR:?managed controller requires SWITCHSTAND_GIT_DIR}"
    : "${SWITCHSTAND_RUN_ID:?managed controller requires SWITCHSTAND_RUN_ID}"
    cd "$repo"
    exec docker compose run --rm -T --no-deps \
        -e SWITCHSTAND_WORKTREE -e SWITCHSTAND_BRANCH -e SWITCHSTAND_GIT_DIR \
        -e SWITCHSTAND_RUN_ID -e SWITCHSTAND_PROC_ROOT=/host/proc \
        -v "$SWITCHSTAND_WORKTREE:$SWITCHSTAND_WORKTREE:ro" \
        -v "$SWITCHSTAND_GIT_DIR:$SWITCHSTAND_GIT_DIR:ro" \
        -v /proc:/host/proc:ro controller
fi
common=$(git -C "$repo" rev-parse --path-format=absolute --git-common-dir)
python=$(dirname "$common")/.venv/bin/python
if [ ! -x "$python" ]; then
    echo "run scripts/bootstrap before starting Codex" >&2
    exit 1
fi
unset ASANA_TOKEN DATABASE_URL ACTIVE_WORK_ID REFERENCE_WORK_IDS
PYTHONPATH="$repo/src" exec "$python" -m switchstand.mcp
