#!/bin/sh
set -eu

repo=${1:-/home/marco/switchstand}
runner=$repo/.venv/bin/switchstand-disk-pressure
unit_dir=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user

if [ ! -x "$runner" ]; then
    echo "disk-pressure runner is unavailable: $runner" >&2
    exit 1
fi

install -d -m 0755 "$unit_dir"
service_tmp=$(mktemp "$unit_dir/.switchstand-disk-pressure.service.XXXXXX")
timer_tmp=$(mktemp "$unit_dir/.switchstand-disk-pressure.timer.XXXXXX")
trap 'rm -f "$service_tmp" "$timer_tmp"' EXIT

cat >"$service_tmp" <<EOF
[Unit]
Description=Switchstand disk-pressure Wakeful producer

[Service]
Type=oneshot
ExecStart="$runner" check --state-root=%h/.local/state/switchstand
TimeoutStartSec=30s
Nice=10
IOSchedulingClass=idle
EOF

cat >"$timer_tmp" <<'EOF'
[Unit]
Description=Periodically audit Switchstand disk pressure

[Timer]
OnBootSec=10min
OnUnitInactiveSec=15min
RandomizedDelaySec=2min
Persistent=true
Unit=switchstand-disk-pressure.service

[Install]
WantedBy=timers.target
EOF

chmod 0644 "$service_tmp" "$timer_tmp"
mv -f "$service_tmp" "$unit_dir/switchstand-disk-pressure.service"
mv -f "$timer_tmp" "$unit_dir/switchstand-disk-pressure.timer"
systemctl --user daemon-reload
systemctl --user enable --now switchstand-disk-pressure.timer
