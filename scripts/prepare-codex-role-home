#!/usr/bin/env bash
set -euo pipefail

legacy_home="$HOME/.local/state/switchstand/codex/coordinator"
auth_source="$HOME/.codex/auth.json"
export CODEX_HOME="${CODEX_HOME:-$HOME/.local/state/switchstand/codex/switchstand}"

[[ -f "$auth_source" && -f "$legacy_home/config.toml" ]] || {
    echo "Codex auth or legacy Switchstand config is missing" >&2; exit 1;
}
[[ "$CODEX_HOME" != "$legacy_home" && "$CODEX_HOME" != "$HOME/.codex" ]] || {
    echo "Switchstand home must be separate from existing Codex homes" >&2; exit 1;
}

if [[ ! -e "$CODEX_HOME" && ! -L "$CODEX_HOME" ]]; then
    mkdir -p -- "$(dirname -- "$CODEX_HOME")"
    staging="$(mktemp -d "$(dirname -- "$CODEX_HOME")/.codex-home.XXXXXXXX")"
    trap 'rm -rf -- "$staging"' EXIT
    chmod 700 "$staging"
    cp -- "$legacy_home/config.toml" "$staging/config.toml"
    ln -s -- "$auth_source" "$staging/auth.json"
    printf 'switchstand\n' > "$staging/.switchstand-home"
    # A concurrent first launch may have published the complete home already.
    if ! mv -Tn -- "$staging" "$CODEX_HOME"; then
        [[ -e "$CODEX_HOME" || -L "$CODEX_HOME" ]] || {
            echo "Could not publish Switchstand home: $CODEX_HOME" >&2; exit 1;
        }
    fi
    [[ ! -e "$staging" ]] || rm -rf -- "$staging"
    trap - EXIT
fi

[[ -d "$CODEX_HOME" && ! -L "$CODEX_HOME" &&
   -f "$CODEX_HOME/.switchstand-home" &&
   "$(cat "$CODEX_HOME/.switchstand-home")" == switchstand &&
   -L "$CODEX_HOME/auth.json" &&
   "$(readlink -- "$CODEX_HOME/auth.json")" == "$auth_source" &&
   -f "$CODEX_HOME/config.toml" && ! -L "$CODEX_HOME/config.toml" &&
   ! -e "$CODEX_HOME/AGENTS.md" && ! -L "$CODEX_HOME/AGENTS.md" &&
   ! -e "$CODEX_HOME/hooks.json" && ! -L "$CODEX_HOME/hooks.json" ]] || {
    echo "Unexpected Switchstand home identity, auth or config: $CODEX_HOME" >&2; exit 1;
}
