#!/usr/bin/env python3
"""Fast-forward canonical main and prepare one real successor handoff."""

from __future__ import annotations

import hashlib
import json
import os
import re
import subprocess
import sys
import tempfile
import uuid
from collections.abc import Callable
from pathlib import Path
from typing import NoReturn

SHA = re.compile(r"[0-9a-f]{40}")
_evidence: Path | None = None
_stage = "startup"
_known_head: str | None = None


def fail(message: str) -> NoReturn:
    if _evidence is not None:
        payload = {"status": "FAILED", "stage": _stage, "message": message}
        if _known_head is not None:
            payload["known_head"] = _known_head
        (_evidence / "result.json").write_text(json.dumps(payload, sort_keys=True) + "\n")
        message = f"{message}; evidence: {_evidence}"
    raise SystemExit(message)

def stage(name: str) -> None:
    global _stage
    _stage = name


def require_start_record(home: Path, raw: str) -> tuple[Path, str]:
    path = Path(raw)
    expected = home / ".local/state/switchstand/codex/coordinator"
    try:
        resolved = path.resolve(strict=True)
    except OSError as error:
        fail(f"Coordinator start record is unavailable: {error}")
    if resolved.parent != expected.resolve() or not resolved.name.startswith("start-commit."):
        fail("start record must be the exact Coordinator start-commit file")
    if path.is_symlink() or not resolved.is_file():
        fail("start record must be a regular file")
    value = resolved.read_text().strip()
    if not SHA.fullmatch(value):
        fail("start record does not contain one exact Git commit")
    return resolved, value


def manifest_digest(payload: dict[str, object]) -> str:
    unsigned = {key: value for key, value in payload.items() if key != "manifest_digest"}
    encoded = json.dumps(unsigned, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(encoded).hexdigest()


def require_launch_manifest(start_record: Path, started: str) -> dict[str, object]:
    path = Path(f"{start_record}.manifest.json")
    try:
        payload = json.loads(path.read_text())
        session = payload["session"]
    except (OSError, KeyError, TypeError, json.JSONDecodeError) as error:
        fail(f"outgoing launch manifest is unavailable: {error}")
    if (
        payload.get("manifest_digest") != manifest_digest(payload)
        or session.get("start_commit") != started
        or session.get("start_record") != str(start_record)
    ):
        fail("outgoing launch manifest identity does not match the current generation")
    return payload


def require_obligations(home: Path, raw: str) -> Path:
    path = Path(raw)
    root = home / ".local/state/switchstand"
    try:
        resolved = path.resolve(strict=True)
    except OSError as error:
        fail(f"handoff obligations are unavailable: {error}")
    if (
        not resolved.is_relative_to(root.resolve())
        or path.is_symlink()
        or not resolved.is_file()
        or resolved.stat().st_size > 65536
    ):
        fail("handoff obligations must be one regular private state file up to 64 KiB")
    return resolved


def write_json(path: Path, payload: dict[str, object], *, exclusive: bool = False) -> None:
    output = json.dumps(payload, indent=2, sort_keys=True) + "\n"
    with tempfile.NamedTemporaryFile("w", dir=path.parent, delete=False) as handle:
        temporary = Path(handle.name)
        handle.write(output)
        handle.flush()
        os.fsync(handle.fileno())
    os.chmod(temporary, 0o600)
    try:
        if exclusive:
            os.link(temporary, path)
        else:
            os.replace(temporary, path)
    finally:
        temporary.unlink(missing_ok=True)


def synchronize_main(home: Path, started: str) -> dict[str, object]:
    command = home / "switchstand/scripts/switchstand-coordinator-control-mcp"
    try:
        result = subprocess.run(
            [str(command), "handoff", started],
            text=True, capture_output=True, check=False, timeout=60,
            env=os.environ | {"GIT_TERMINAL_PROMPT": "0"},
        )
    except (OSError, subprocess.TimeoutExpired) as error:
        fail(f"Coordinator sync control unavailable: {type(error).__name__}")
    try:
        payload = json.loads(result.stdout)
    except (TypeError, json.JSONDecodeError):
        detail = result.stderr.strip() or "invalid structured response"
        fail(f"Coordinator sync control failed: {detail}")
    if not isinstance(payload, dict):
        fail("Coordinator sync control returned invalid structured response")
    return payload


def main(
    argv: list[str] | None = None,
    synchronize: Callable[[Path, str], dict[str, object]] = synchronize_main,
) -> None:
    global _evidence, _known_head
    arguments = sys.argv[1:] if argv is None else argv
    if len(arguments) != 2:
        fail("usage: scripts/coordinator-handoff <start-commit-record> <obligations-file>")
    home_raw = os.environ.get("HOME")
    if not home_raw or not Path(home_raw).is_absolute():
        fail("HOME must be an absolute path")
    home = Path(home_raw).resolve()
    os.umask(0o077)
    repo = home / "switchstand"
    artifact_root = home / ".local/state/switchstand/codex/handoffs"
    artifact_root.mkdir(parents=True, exist_ok=True, mode=0o700)
    os.chmod(artifact_root, 0o700)
    _evidence = Path(tempfile.mkdtemp(prefix="handoff-", dir=artifact_root))
    os.chmod(_evidence, 0o700)
    stage("validate-inputs")
    if not repo.is_dir():
        fail("canonical Switchstand checkout is unavailable")
    start_record, started = require_start_record(home, arguments[0])
    outgoing_manifest = require_launch_manifest(start_record, started)
    obligations = require_obligations(home, arguments[1])
    pending = start_record.parent / "pending-handoff.json"
    if pending.exists():
        fail("a prior Coordinator handoff is still pending")
    stage("sync-main")
    sync = synchronize(home, started)
    known = sync.get("resulting_sha") or sync.get("previous_sha")
    if isinstance(known, str) and SHA.fullmatch(known):
        _known_head = known
    if sync.get("status") != "ready":
        reason = str(sync.get("reason") or "unknown")
        messages = {
            "dirty_canonical_checkout": "handoff refuses dirty main; local work is intact",
            "canonical_main_is_not_ancestor": (
                "handoff refuses divergent main; local commits are intact"
            ),
            "canonical_remote_identity_mismatch": "handoff refuses noncanonical origin",
            "recorded_start_commit_unavailable": (
                "start record commit is unavailable in canonical history"
            ),
            "recorded_start_commit_is_not_ancestor": (
                "recorded Coordinator start commit is not an ancestor of final main"
            ),
        }
        fail(messages.get(reason, f"handoff Git boundary rejected: {reason}"))
    accepted = sync.get("resulting_sha")
    if not isinstance(accepted, str) or not SHA.fullmatch(accepted):
        fail("handoff Git boundary returned invalid final main identity")
    _known_head = accepted

    stage("prepare-successor")
    handoff_id = str(uuid.uuid4())
    obligation_copy = _evidence / "obligations"
    obligation_copy.write_bytes(obligations.read_bytes())
    os.chmod(obligation_copy, 0o600)
    handoff = {
        "handoff_id": handoff_id,
        "state": "AWAITING_SUCCESSOR",
        "target_commit": accepted,
        "outgoing_generation": outgoing_manifest["session"]["generation"],
        "outgoing_manifest_digest": outgoing_manifest["manifest_digest"],
        "obligations_sha256": hashlib.sha256(obligation_copy.read_bytes()).hexdigest(),
        "old_session_retirement": "BLOCKED_UNTIL_ACKNOWLEDGED",
    }
    write_json(_evidence / "handoff.json", handoff)
    write_json(
        _evidence / "result.json",
        {"status": "WAITING_FOR_SUCCESSOR", "stage": _stage, "known_head": accepted},
    )
    try:
        write_json(
            pending,
            {"handoff_id": handoff_id, "artifact": str(_evidence)},
            exclusive=True,
        )
    except FileExistsError:
        fail("another Coordinator handoff became pending concurrently")

    print(f"Git boundary: {start_record} {started}..{accepted}")
    print(f"Handoff: WAITING_FOR_SUCCESSOR {handoff_id}")
    print("Launch one fresh Coordinator with plain `codex`; do not resume the old session.")
    print("Obligations transfer and old-session retirement remain blocked until ACKNOWLEDGED.")
    print(f"Evidence: {_evidence}")


if __name__ == "__main__":
    main()
