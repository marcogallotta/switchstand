#!/usr/bin/env python3
"""Disposable loopback test only. Usage: prototype-inbound-wake CONTROL STATE PORT."""
import asyncio
import json
import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path[:0] = [str(ROOT / "src"), str(ROOT / "tests")]
from disposable_postgres import disposable_postgres
from fastmcp import FastMCP
from fastmcp.server.dependencies import get_context
from switchstand.chatgpt_edge import resource_service, runtime_identity_from_meta
from switchstand.chatgpt_mcp import build_ordinary_tools
from switchstand.grants import PrincipalContext


async def run(control, state, port):
    with disposable_postgres() as (environment, directory):
        os.environ["DATABASE_URL"] = environment["DATABASE_URL"]
        os.environ["SWITCHSTAND_CODEX_WAKE_CONTROL"] = str(control)
        async with resource_service() as (service, _runtime):
            async def principal():
                return PrincipalContext(issuer="prototype-loopback", subject="disposable",
                                        client_id="prototype", assurance="test")
            service.principal = principal
            def identity():
                meta = get_context().request_context.meta
                return runtime_identity_from_meta({} if meta is None else dict(meta))
            server = FastMCP("Disposable inbound wake test")
            for name, function in build_ordinary_tools(service, agent_identity=identity):
                if name in {"agent_register", "agent_message_send", "agent_message_pending",
                            "agent_message_receive", "agent_message_result_send",
                            "agent_message_acknowledge", "agent_message_disposition"}:
                    server.tool(function, name=name)
            state.write_text(json.dumps({"pid": os.getpid(), "directory": str(directory),
                "database_pid": int((directory / "data/postmaster.pid").read_text().splitlines()[0])}))
            await server.run_http_async(host="127.0.0.1", port=port, path="/mcp", show_banner=False)


if __name__ == "__main__":
    for key in list(os.environ):
        if key.startswith("SWITCHSTAND_") or key in {"DATABASE_URL", "TEST_DATABASE_URL"}:
            os.environ.pop(key)
    asyncio.run(run(Path(sys.argv[1]), Path(sys.argv[2]), int(sys.argv[3])))
