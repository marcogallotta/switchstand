#!/usr/bin/env python3
"""Disposable loopback MCP with synthetic identity; never a production/OAuth qualification."""

import argparse
import asyncio
import json
import logging
import os
import subprocess
import sys
from contextlib import asynccontextmanager
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path[:0] = [str(ROOT / "src"), str(ROOT / "tests")]

from disposable_postgres import disposable_postgres
from fastmcp import FastMCP
from fastmcp.server.dependencies import get_context
from starlette.responses import JSONResponse

from switchstand.chatgpt_edge import resource_service, runtime_identity_from_meta
from switchstand.chatgpt_mcp import build_ordinary_tools
from switchstand.grants import PrincipalContext


async def run(args):
    source_sha = subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT, text=True).strip()
    # Only disposable_postgres supplies DATABASE_URL. Never consume an ambient URL.
    with disposable_postgres() as (environment, directory):
        os.environ["DATABASE_URL"] = environment["DATABASE_URL"]
        os.environ["SWITCHSTAND_CODEX_WAKE_CONTROL"] = str(args.control)
        async with resource_service() as (service, _runtime):
            async def principal():
                return PrincipalContext(issuer="prototype-loopback", subject="disposable",
                                        client_id="prototype", assurance="test")
            service.principal = principal

            def identity():
                meta = get_context().request_context.meta
                return runtime_identity_from_meta({} if meta is None else dict(meta))

            @asynccontextmanager
            async def lifespan(_server):
                yield {}

            server = FastMCP("Disposable inbound wake prototype", lifespan=lifespan)
            names = {"agent_register", "agent_message_send", "agent_message_pending",
                     "agent_message_receive", "agent_message_result_send", "agent_message_acknowledge"}
            for name, function in build_ordinary_tools(service, agent_identity=identity):
                if name in names:
                    server.tool(function, name=name)

            @server.custom_route("/health", methods=["GET"])
            async def health(_request):
                wake = service.messages.on_delivery.__self__
                return JSONResponse({"status": "running", "database": "switchstand_test",
                    "source_sha": source_sha, "pid": os.getpid(),
                    "outcomes": {str(k): v for k, v in wake.outcomes.items()}})

            state = {"pid": os.getpid(), "database_pid": int((directory / "data/postmaster.pid")
                     .read_text().splitlines()[0]), "endpoint": f"http://127.0.0.1:{args.port}/mcp",
                     "database": "switchstand_test", "directory": str(directory),
                     "writer": str(ROOT), "source_sha": source_sha, "control": str(args.control)}
            args.state.write_text(json.dumps(state, indent=2) + "\n")
            print(json.dumps(state), flush=True)
            await server.run_http_async(host="127.0.0.1", port=args.port, path="/mcp",
                                        show_banner=False)


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--control", type=Path, required=True)
    parser.add_argument("--state", type=Path, required=True)
    parser.add_argument("--port", type=int, required=True)
    selected = parser.parse_args()
    # Remove all unrelated activation/provider environment rather than copy production state.
    for key in list(os.environ):
        if key.startswith("SWITCHSTAND_") or key in {"DATABASE_URL", "TEST_DATABASE_URL"}:
            os.environ.pop(key)
    logging.basicConfig(level=logging.INFO)
    asyncio.run(run(selected))
