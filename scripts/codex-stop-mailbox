#!/usr/bin/env python3
"""Give a stock Codex root one chance to handle pending mailbox deliveries."""

from __future__ import annotations

import json
import os
import re
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path
from typing import Any
from uuid import UUID

DEFAULT_ENDPOINT = "http://127.0.0.1:8790/internal/codex-stop-mailbox"
TIMEOUT_SECONDS = 2.0


def _emit(value: dict[str, Any]) -> None:
    print(json.dumps(value, separators=(",", ":")))


def _fail_open(reason: str) -> None:
    _emit({
        "continue": True,
        "systemMessage": f"Switchstand mailbox Stop check failed open: {reason}",
    })


def _page(endpoint: str, session_id: str, cursor: str | None, timeout: float) -> Any:
    body = json.dumps({"session_id": session_id, "cursor": cursor}).encode()
    request = urllib.request.Request(
        endpoint, data=body, headers={"Content-Type": "application/json"}, method="POST",
    )
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    with opener.open(request, timeout=timeout) as response:
        return json.load(response)


def _pending(endpoint: str, session_id: str) -> tuple[list[str], bool]:
    deadline = time.monotonic() + TIMEOUT_SECONDS
    cursor = None
    seen_cursors: set[str] = set()
    delivery_ids: list[str] = []
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            raise TimeoutError("read timed out")
        page = _page(endpoint, session_id, cursor, remaining)
        if not isinstance(page, dict):
            raise TypeError("response is not an object")
        if page.get("status") != "ok":
            status = page.get("status", "missing_status")
            reason = page.get("reason", "missing_reason")
            raise ValueError(f"mailbox unavailable ({status}: {reason})")
        coordinator = page.get("coordinator")
        if not isinstance(coordinator, bool):
            raise ValueError("missing Coordinator binding evidence")
        ids = page.get("delivery_ids")
        has_more = page.get("has_more")
        next_cursor = page.get("next_cursor")
        if (
            not isinstance(ids, list)
            or not all(isinstance(value, str) for value in ids)
            or not isinstance(has_more, bool)
            or (next_cursor is not None and not isinstance(next_cursor, str))
        ):
            raise ValueError("malformed mailbox page")
        for delivery_id in ids:
            UUID(delivery_id)
        delivery_ids.extend(ids)
        if not has_more:
            if next_cursor is not None:
                raise ValueError("terminal mailbox page has a cursor")
            return delivery_ids, coordinator
        if not ids or next_cursor is None or next_cursor in seen_cursors:
            raise ValueError("mailbox pagination did not advance")
        seen_cursors.add(next_cursor)
        cursor = next_cursor


def main() -> None:
    try:
        payload = json.load(sys.stdin)
        if not isinstance(payload, dict) or payload.get("hook_event_name") != "Stop":
            raise ValueError("expected a Stop hook object")
        active = payload.get("stop_hook_active")
        if not isinstance(active, bool):
            raise TypeError("missing stop_hook_active")
        if active:
            _emit({})
            return
        if any(key in payload for key in ("agent_id", "agent_type", "agent_transcript_path")):
            _emit({})
            return
        message = payload.get("last_assistant_message")
        if isinstance(message, str) and re.fullmatch(
            r"\s*<!-- SWITCHSTAND_YIELD:USER_STOP -->\s*", message,
        ):
            _emit({})
            return
        session_id = payload.get("session_id")
        if not isinstance(session_id, str) or not session_id:
            raise ValueError("missing Stop hook identity")
        endpoint = os.getenv("SWITCHSTAND_CODEX_STOP_ENDPOINT", DEFAULT_ENDPOINT)
        delivery_ids, coordinator = _pending(endpoint, session_id)
        try:
            value = json.loads((Path.home() / ".config/switchstand/codex-stop-head.json").read_text())
            targeted = isinstance(value, dict) and value.get("session_id") == session_id
        except (OSError, ValueError, TypeError):
            targeted = False
        if (coordinator or targeted) and not (
            isinstance(message, str) and re.fullmatch(
                r"\s*<!-- SWITCHSTAND_YIELD:(HANDOFF|REAL_BLOCKER|ASSIGNMENT_COMPLETE) -->\s*",
                message,
            )
        ):
            _fail_open(
                "UNKNOWN yield intent: Stop has no conversation/completion signal; "
                "preserve outstanding deliveries; do not claim completion"
            )
            return
        if not delivery_ids:
            _emit({})
            return
        joined = ", ".join(delivery_ids)
        _emit({
            "decision": "block",
            "reason": (
                f"Before stopping, handle {len(delivery_ids)} pending Switchstand mailbox "
                f"deliveries: {joined}. This is the only automatic continuation for this turn."
            ),
        })
    except (
        OSError, TimeoutError, TypeError, ValueError, json.JSONDecodeError,
        urllib.error.URLError,
    ) as error:
        _fail_open(str(error))


if __name__ == "__main__":
    main()
