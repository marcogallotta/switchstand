#!/usr/bin/env python3
"""Run the isolated V1-A pre-production E2E qualification."""

import argparse
import hashlib
import hmac
import json
import os
import re
import subprocess
import sys
import tempfile
from datetime import UTC, datetime
from pathlib import Path
from urllib.parse import urlparse
from uuid import uuid4
from xml.etree import ElementTree

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))

from switchstand.secure_file import create_new_private_bytes, read_private_bytes  # noqa: E402

WORK_ID = "946b593d-1f2b-5442-96f8-cf1a12482351"
FAULTS = ("missing-tool", "codex-absent", "duplicate-append")
SHA = re.compile(r"[0-9a-f]{40}")
RECEIPT_SCHEMA = 1


def now():
    return datetime.now(UTC).isoformat()


def git(*args):
    return subprocess.run(
        ["git", "-C", str(ROOT), *args], check=True, text=True, capture_output=True,
    ).stdout.strip()


def inherited_target():
    if os.getenv("DATABASE_URL") or os.getenv("TEST_DATABASE_URL"):
        return "inherited database URL"
    exact = {
        "SWITCHSTAND_MCP_RESOURCE_URL", "SWITCHSTAND_MCP_PUBLIC_URL",
        "SWITCHSTAND_CERTIFICATION_RESOURCE_URL", "SWITCHSTAND_AUTH_INTERNAL_URL",
    }
    for key, value in os.environ.items():
        if not value or not (key in exact or (
            "MCP" in key and any(word in key for word in ("URL", "URI", "ENDPOINT"))
        )):
            continue
        host = urlparse(value).hostname
        if host not in {"127.0.0.1", "localhost", "::1"}:
            return f"inherited non-loopback endpoint in {key}"
    return ""


def counts(report):
    if not report.exists():
        return 0, 0, 0
    root = ElementTree.parse(report).getroot()
    suites = [root] if root.tag == "testsuite" else list(root.iter("testsuite"))
    suites = [suite for suite in suites if suite.get("tests") is not None]
    return tuple(sum(int(suite.get(name, "0")) for suite in suites)
                 for name in ("tests", "skipped", "failures"))


def scenario(label, test, fault, python, scratch):
    report = scratch / f"{label}.xml"
    marker = scratch / "codex-call"
    command = ["env", f"SWITCHSTAND_E2E_FAULT={fault or ''}"]
    if label == "S2":
        binary = "" if fault == "codex-absent" else (
            os.getenv("CODEX_EXEC_PATH") or subprocess.run(
                ["sh", "-c", "command -v codex || true"], text=True,
                capture_output=True, check=False,
            ).stdout.strip()
        )
        command += [f"CODEX_EXEC_PATH={binary}",
                    f"SWITCHSTAND_E2E_CODEX_CALL_MARKER={marker}"]
    command += [str(python), "-m", "pytest", "-q", test, f"--junitxml={report}"]
    run = subprocess.run(
        [str(python), str(ROOT / "tests/disposable_postgres.py"), *command],
        cwd=ROOT, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
        check=False,
    )
    tests, skipped, failures = counts(report)
    teardown = "Disposable PostgreSQL teardown: ok" in run.stdout
    if tests == 0 or skipped or (label == "S2" and (
        tests != 1 or not marker.exists()
    )):
        status = "NOT_RUN"
    else:
        status = "PASS" if run.returncode == 0 and failures == 0 and teardown else "FAIL"
    return status, tests - skipped, skipped, teardown


def release_baseline(value, candidate):
    if not SHA.fullmatch(value):
        raise ValueError("release baseline must be an exact lowercase 40-character Git SHA")
    resolved = git("rev-parse", f"{value}^{{commit}}")
    if resolved != value:
        raise ValueError("release baseline did not resolve to the exact supplied commit")
    if value == candidate:
        raise ValueError("release baseline must precede the candidate")
    ancestor = subprocess.run(
        ["git", "-C", str(ROOT), "merge-base", "--is-ancestor", value, candidate],
        check=False,
    )
    if ancestor.returncode != 0:
        raise ValueError("release baseline is not an ancestor of the candidate")
    return value


def require_clean_candidate(candidate):
    if git("rev-parse", "HEAD") != candidate:
        raise ValueError("candidate HEAD changed during qualification")
    if git("status", "--porcelain=v1", "--untracked-files=all"):
        raise ValueError("candidate worktree is not clean")


def migration_status(baseline, candidate):
    changed = git("diff", "--name-only", baseline, candidate, "--",
                  "migrations", "alembic.ini").splitlines()
    return "HOLD" if changed else "NOT_APPLICABLE"


def canonical(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode()


def receipt_key(path):
    if not path.is_absolute():
        raise ValueError("receipt key path must be absolute")
    key = read_private_bytes(path, max_bytes=32)
    if len(key) != 32:
        raise ValueError("receipt key must contain exactly 32 bytes")
    return key


def verify_receipt(path, key, expected=None):
    if not path.is_absolute():
        raise ValueError("receipt path must be absolute")
    raw = read_private_bytes(path, max_bytes=64 * 1024)
    receipt = json.loads(raw)
    if not isinstance(receipt, dict) or receipt.get("receipt_schema") != RECEIPT_SCHEMA:
        raise ValueError("receipt schema is invalid")
    seal = receipt.pop("seal", None)
    if not isinstance(seal, str):
        raise ValueError("receipt seal is missing")
    calculated = hmac.new(key, canonical(receipt), hashlib.sha256).hexdigest()
    if not hmac.compare_digest(seal, calculated):
        raise ValueError("receipt seal is invalid")
    if expected is not None and receipt != expected:
        raise ValueError("receipt readback does not match the completed run")
    return receipt, hashlib.sha256(raw).hexdigest()


def accepted(result):
    return (all(result[key] == "PASS" for key in ("S1", "S2", "S3"))
            and result["M"] in {"PASS", "NOT_APPLICABLE"}
            and result["teardown_ok"])


def publish(result, key):
    directory = Path.home() / ".local/state/switchstand/e2e-runs"
    directory.mkdir(mode=0o700, parents=True, exist_ok=True)
    path = directory / f"{result['run_id']}.json"
    seal = hmac.new(key, canonical(result), hashlib.sha256).hexdigest()
    receipt = {**result, "seal": seal}
    create_new_private_bytes(path, canonical(receipt))
    verified, digest = verify_receipt(path, key, result)
    print(f"{path} sha256={digest}")
    return verified, digest


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--fault", choices=FAULTS, help="test-only negative control")
    parser.add_argument("--release-baseline", required=True,
                        help="exact approved release SHA preceding the candidate")
    parser.add_argument("--receipt-key", required=True, type=Path,
                        help="absolute path to an existing private 32-byte HMAC key")
    args = parser.parse_args()
    started, run_id = now(), str(uuid4())
    candidate = git("rev-parse", "HEAD")
    try:
        baseline = release_baseline(args.release_baseline, candidate)
        key = receipt_key(args.receipt_key)
        require_clean_candidate(candidate)
    except (OSError, ValueError) as error:
        parser.error(str(error))
    migration = migration_status(baseline, candidate)
    result = {
        "run_id": run_id, "work_id": WORK_ID, "candidate_sha": candidate,
        "release_baseline_sha": baseline, "receipt_schema": RECEIPT_SCHEMA,
        "suite_version": "v1-a.2", "started_at": started, "ended_at": None,
        "S1": "NOT_RUN", "S2": "NOT_RUN", "S3": "NOT_RUN", "M": migration,
        "executed": 0, "skipped": 0, "teardown_ok": False, "failure_reason": None,
    }
    refused = inherited_target()
    if refused:
        result["failure_reason"] = refused
    elif migration == "HOLD":
        result["failure_reason"] = "migration testing is not built yet"
    else:
        common = Path(git("rev-parse", "--path-format=absolute", "--git-common-dir"))
        python = common.parent / ".venv/bin/python"
        if not python.is_file():
            result["failure_reason"] = "pinned test Python is unavailable"
        else:
            with tempfile.TemporaryDirectory(prefix="switchstand-e2e-") as value:
                scratch = Path(value)
                specs = (
                    ("S1", "tests/test_chatgpt_edge_process.py::test_e2e_expected_tools_over_real_http"),
                    ("S3", "tests/test_chatgpt_edge_process.py::test_process_replays_durable_database_append_after_restart"),
                    ("S2", "tests/test_codex_stateful_client.py::test_current_codex_app_server_calls_work_get_over_stateful_http"),
                )
                teardown = []
                for label, test in specs:
                    status, executed, skipped, clean = scenario(
                        label, test, args.fault, python, scratch,
                    )
                    result[label] = status
                    result["executed"] += executed
                    result["skipped"] += skipped
                    teardown.append(clean)
                result["teardown_ok"] = all(teardown)
            if not all(result[key] == "PASS" for key in ("S1", "S2", "S3")):
                result["failure_reason"] = "one or more required scenarios did not pass"
    result["ended_at"] = now()
    try:
        require_clean_candidate(candidate)
    except ValueError as error:
        parser.error(str(error))
    verified, _ = publish(result, key)
    return 0 if accepted(verified) else 1


if __name__ == "__main__":
    raise SystemExit(main())
