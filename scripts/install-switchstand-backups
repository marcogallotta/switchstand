#!/bin/sh
set -eu

repo=${1:-/home/marco/switchstand}
source_script=$repo/scripts/switchstand-backup
runner=${XDG_DATA_HOME:-$HOME/.local/share}/switchstand/bin/switchstand-backup
unit_dir=${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user

test -x "$source_script"
install -d -m 0755 "$(dirname "$runner")" "$unit_dir"
install -m 0755 "$source_script" "$runner"

service_tmp=$(mktemp "$unit_dir/.switchstand-backup.service.XXXXXX")
timer_tmp=$(mktemp "$unit_dir/.switchstand-backup.timer.XXXXXX")
stale_service_tmp=$(mktemp "$unit_dir/.switchstand-backup-stale.service.XXXXXX")
stale_timer_tmp=$(mktemp "$unit_dir/.switchstand-backup-stale.timer.XXXXXX")
trap 'rm -f "$service_tmp" "$timer_tmp" "$stale_service_tmp" "$stale_timer_tmp"' EXIT

cat >"$service_tmp" <<EOF
[Unit]
Description=Back up Switchstand PostgreSQL
After=docker.service

[Service]
Type=oneshot
ExecStart="$runner" run
TimeoutStartSec=15min
Nice=10
IOSchedulingClass=idle
EOF

cat >"$timer_tmp" <<'EOF'
[Unit]
Description=Run hourly Switchstand backups

[Timer]
OnActiveSec=10s
OnCalendar=hourly
Persistent=true
Unit=switchstand-backup.service

[Install]
WantedBy=timers.target
EOF

cat >"$stale_service_tmp" <<EOF
[Unit]
Description=Alert when Switchstand backups are stale

[Service]
Type=oneshot
ExecStart="$runner" check-stale --max-age-hours=2
EOF

cat >"$stale_timer_tmp" <<'EOF'
[Unit]
Description=Check Switchstand backup freshness

[Timer]
OnCalendar=*:0/15
Persistent=true
Unit=switchstand-backup-stale.service

[Install]
WantedBy=timers.target
EOF

chmod 0644 "$service_tmp" "$timer_tmp" "$stale_service_tmp" "$stale_timer_tmp"
mv -f "$service_tmp" "$unit_dir/switchstand-backup.service"
mv -f "$timer_tmp" "$unit_dir/switchstand-backup.timer"
mv -f "$stale_service_tmp" "$unit_dir/switchstand-backup-stale.service"
mv -f "$stale_timer_tmp" "$unit_dir/switchstand-backup-stale.timer"
systemctl --user daemon-reload
systemctl --user enable --now switchstand-backup.timer switchstand-backup-stale.timer
systemctl --user restart switchstand-backup.timer switchstand-backup-stale.timer
