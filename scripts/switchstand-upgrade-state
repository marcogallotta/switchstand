#!/bin/sh
set -eu

[ "$#" -ge 2 ] && [ "$1" = --target ] \
    || { echo "usage: scripts/switchstand-upgrade-state --target production|disposable:NAME [rehearse|apply|abort-pre-authority [receipt]]" >&2; exit 2; }
target_identity=$2
shift 2
[ "$#" -le 2 ] || { echo "too many state-upgrade arguments" >&2; exit 2; }
umask 077

operation=${1:-apply}
case "$operation" in rehearse|apply|abort-pre-authority) ;; *) echo "unknown state-upgrade operation: $operation" >&2; exit 2;; esac
receipt=${2:-}
prior_receipt=
EXPECTED_NEW=0010_work_metadata_authority
case "$target_identity" in
    production) PROJECT=switchstand; target_name=production ;;
    disposable:*)
        target_name=${target_identity#disposable:}
        case "$target_name" in ''|*[!a-z0-9-]*|-*|*-) echo "invalid disposable target name" >&2; exit 2;; esac
        PROJECT=switchstand-rehearsal-$target_name ;;
    *) echo "unknown state-upgrade target: $target_identity" >&2; exit 2 ;;
esac
SERVICE=postgres
VOLUME=${PROJECT}_postgres-data
NETWORK=${PROJECT}_default
IMAGE=postgres:18-alpine
backup=
backup_ready=false
rehearsal=
shared_migration_attempted=false
outcome=NOT_RUN
terminal_written=false
resume_attempt=false

state_dir=$HOME/.local/state/switchstand
if [ "$target_identity" != production ]; then
    rehearsals=$state_dir/rehearsals
    state_dir=$rehearsals/$target_name
    python - "$rehearsals" "$state_dir" "${SWITCHSTAND_BACKUP_DIR:-}" "$receipt" <<'PY'
import os, pathlib, stat, sys
parent, target = (pathlib.Path(value) for value in sys.argv[1:3])
for path in (parent, target):
    try:
        info = path.stat()
    except OSError as error:
        raise SystemExit(f"disposable state root is unavailable: {error}")
    if (not path.is_absolute() or not path.is_dir() or path.resolve() != path
            or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700):
        raise SystemExit("disposable state root is not canonical, owned, and private")
if target.parent != parent:
    raise SystemExit("disposable target is outside the canonical rehearsals root")
if sys.argv[3]:
    raise SystemExit("disposable target does not accept a backup-directory override")
if sys.argv[4]:
    receipt = pathlib.Path(sys.argv[4])
    if (not receipt.is_absolute() or receipt.resolve(strict=False) != receipt
            or not receipt.resolve(strict=False).is_relative_to(target)):
        raise SystemExit("disposable receipt path escapes its private state directory")
backup = target / "backups"
try:
    backup.mkdir(mode=0o700)
except FileExistsError:
    pass
info = backup.lstat()
if (not stat.S_ISDIR(info.st_mode) or backup.resolve() != backup
        or info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700):
    raise SystemExit("disposable backup directory is not exact, owned, and private")
PY
fi

control=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
head=$(git -C "$control" rev-parse HEAD)
branch=$(git -C "$control" branch --show-current)
common=$(git -C "$control" rev-parse --path-format=absolute --git-common-dir)
dirty=$(git -C "$control" status --porcelain --untracked-files=all)

if [ -n "${SWITCHSTAND_CONTROL_PATH:-}${SWITCHSTAND_CONTROL_SHA:-}${SWITCHSTAND_CONTROL_COMMON:-}" ]; then
    [ "$control" = "${SWITCHSTAND_CONTROL_PATH:-}" ] \
        && [ "$head" = "${SWITCHSTAND_CONTROL_SHA:-}" ] \
        && [ "$common" = "${SWITCHSTAND_CONTROL_COMMON:-}" ] \
        && [ -z "$branch" ] && [ -z "$dirty" ] \
        || { echo "state upgrade CONTROL does not match selector identity" >&2; exit 1; }
else
    git -C "$control" fetch --quiet --no-tags origin \
        '+refs/heads/main:refs/remotes/origin/main'
    accepted=$(git -C "$control" rev-parse origin/main)
    [ "$branch" = main ] && [ "$head" = "$accepted" ] && [ -z "$dirty" ] \
        || { echo "state upgrade requires clean current main CONTROL" >&2; exit 1; }
fi

if [ "$operation" = abort-pre-authority ]; then
    prior_receipt=$receipt
    [ -n "$prior_receipt" ] \
        || { echo "abort-pre-authority requires the exact apply receipt" >&2; exit 2; }
    [ -f "$prior_receipt" ] \
        || { echo "abort-pre-authority requires the exact apply receipt" >&2; exit 2; }
    receipt=
    receipt_values=$(python - "$prior_receipt" "$head" "$EXPECTED_NEW" "$target_identity" "$PROJECT" "$VOLUME" "$NETWORK" <<'PY'
import json, sys
records = [json.loads(line) for line in open(sys.argv[1])]
data, terminal = records[0], records[-1]
identity = dict(zip(("sha", "new", "target", "project", "volume", "network"), sys.argv[2:]))
if (data.get("outcome") != "ATTEMPTING" or terminal.get("outcome") != "APPLIED"
        or any(data.get(key) != value or terminal.get(key) != value for key, value in identity.items())):
    raise SystemExit("stale or mismatched apply receipt")
print(data["old"], data["before_counts"], data["before_schema"], data["before_data"],
      data["after_counts"], data["after_schema"], data["after_data"], sep=";")
PY
    ) || { echo "stale or mismatched apply receipt" >&2; exit 1; }
    IFS=';' read -r EXPECTED_OLD before_counts before_schema before_data expected_counts expected_schema expected_data <<EOF
$receipt_values
EOF
fi
if [ -z "$receipt" ]; then
    receipt="$state_dir/state-upgrade-$operation-$head-$(date -u +%Y%m%dT%H%M%SZ)-$$.json"
fi
case "$receipt" in /*) ;; *) echo "receipt path must be absolute" >&2; exit 2;; esac
if [ -e "$receipt" ]; then
    [ "$operation" = apply ] || { echo "receipt already exists: $receipt" >&2; exit 1; }
    receipt_values=$(python - "$receipt" "$head" "$EXPECTED_NEW" "$target_identity" "$PROJECT" "$VOLUME" "$NETWORK" <<'PY'
import json, sys
records = [json.loads(line) for line in open(sys.argv[1])]
data, terminal = records[0], records[-1]
identity = dict(zip(("sha", "new", "target", "project", "volume", "network"), sys.argv[2:]))
if (data.get("outcome") != "ATTEMPTING" or terminal.get("outcome") not in ("ATTEMPTING", "UNKNOWN")
        or any(data.get(key) != value or terminal.get(key) != value for key, value in identity.items())):
    raise SystemExit("stale or terminal apply receipt")
print(data["old"], data["before_counts"], data["before_schema"], data["before_data"],
      data["after_counts"], data["after_schema"], data["after_data"], sep=";")
PY
    ) || { echo "stale or terminal apply receipt" >&2; exit 1; }
    IFS=';' read -r EXPECTED_OLD before_counts before_schema before_data expected_counts expected_schema expected_data <<EOF
$receipt_values
EOF
    resume_attempt=true
fi

write_receipt() {
    receipt_mode=$1
    RECEIPT_MODE=$receipt_mode RECEIPT_PATH=$receipt RECEIPT_OPERATION=$operation RECEIPT_OUTCOME=$outcome \
    RECEIPT_SHA=$head RECEIPT_OLD=${EXPECTED_OLD:-UNKNOWN} RECEIPT_NEW=$EXPECTED_NEW \
    RECEIPT_TARGET=$target_identity RECEIPT_PROJECT=$PROJECT RECEIPT_VOLUME=$VOLUME RECEIPT_NETWORK=$NETWORK \
    RECEIPT_BEFORE_COUNTS=${before_counts:-UNKNOWN} RECEIPT_AFTER_COUNTS=${after_counts:-UNKNOWN} \
    RECEIPT_BEFORE_SCHEMA=${before_schema:-UNKNOWN} RECEIPT_AFTER_SCHEMA=${after_schema:-UNKNOWN} \
    RECEIPT_BEFORE_DATA=${before_data:-UNKNOWN} RECEIPT_AFTER_DATA=${after_data:-UNKNOWN} \
    RECEIPT_BACKUP=${backup:-NONE} python - <<'PY'
import json, os
from pathlib import Path
p = Path(os.environ["RECEIPT_PATH"])
p.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
names = ("PATH", "OPERATION", "OUTCOME", "SHA", "OLD", "NEW", "BEFORE_COUNTS",
         "AFTER_COUNTS", "BEFORE_SCHEMA", "AFTER_SCHEMA", "BEFORE_DATA",
         "AFTER_DATA", "BACKUP", "TARGET", "PROJECT", "VOLUME", "NETWORK")
payload = {name.lower(): os.environ[f"RECEIPT_{name}"] for name in names if name != "PATH"}
flags = os.O_WRONLY | os.O_CREAT | (os.O_EXCL if os.environ["RECEIPT_MODE"] == "create" else os.O_APPEND)
fd = os.open(p, flags, 0o600)
with os.fdopen(fd, "w") as stream:
    json.dump(payload, stream, sort_keys=True)
    stream.write("\n")
    stream.flush()
    os.fsync(stream.fileno())
directory = os.open(p.parent, os.O_RDONLY)
try: os.fsync(directory)
finally: os.close(directory)
PY
}

lock_dir=$state_dir/state-upgrade.lock
mkdir -p "$state_dir"
mkdir "$lock_dir" 2>/dev/null \
    || { echo "another Switchstand state upgrade is active; refusing concurrent execution" >&2; exit 1; }
cleanup() {
    status=$?
    [ -z "$rehearsal" ] || docker rm -f "$rehearsal" >/dev/null 2>&1 || true
    if [ "$status" -ne 0 ] && [ "$shared_migration_attempted" = true ] \
        && [ "$terminal_written" = false ] && [ -f "$receipt" ]; then
        outcome=UNKNOWN
        after_counts=$(sql "$counts_sql" 2>/dev/null || printf UNAVAILABLE)
        after_schema=$(dump_digest "$container" schema 2>/dev/null || printf UNAVAILABLE)
        after_data=$(dump_digest "$container" data 2>/dev/null || printf UNAVAILABLE)
        write_receipt append 2>/dev/null || true
        terminal_written=true
    fi
    if [ "$status" -ne 0 ] && [ "$backup_ready" = true ]; then
        observed_revision=$(sql 'SELECT version_num FROM alembic_version' 2>/dev/null || printf UNAVAILABLE)
        observed_counts=$(sql "$counts_sql" 2>/dev/null || printf UNAVAILABLE)
        message="shared migration NOT_RUN; operation aborted"
        [ "$shared_migration_attempted" = false ] \
            || message="shared migration outcome UNKNOWN"
        printf 'state upgrade %s; backup %s; observed revision %s; observed counts %s; no retry or rollback attempted\n' \
            "$message" "$backup" "$observed_revision" "$observed_counts" >&2
    fi
    rmdir "$lock_dir" >/dev/null 2>&1 || true
    exit "$status"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

compose() { docker compose -p "$PROJECT" --project-directory "$control" -f "$control/compose.state.yaml" "$@"; }
container=$(compose ps -q "$SERVICE")
[ -n "$container" ] && [ "$(printf '%s\n' "$container" | wc -l)" -eq 1 ] \
    || { echo "expected exactly one running Switchstand PostgreSQL service" >&2; exit 1; }
identity=$(docker inspect --format \
    '{{index .Config.Labels "com.docker.compose.project"}}|{{index .Config.Labels "com.docker.compose.service"}}|{{.Config.Image}}|{{.State.Health.Status}}' \
    "$container")
[ "$identity" = "$PROJECT|$SERVICE|$IMAGE|healthy" ] \
    || { echo "Switchstand PostgreSQL service identity or health mismatch" >&2; exit 1; }
mounts=$(docker inspect --format \
    '{{range .Mounts}}{{if eq .Destination "/var/lib/postgresql"}}{{.Name}}|{{.RW}}{{end}}{{end}}' \
    "$container")
[ "$mounts" = "$VOLUME|true" ] \
    || { echo "Switchstand PostgreSQL volume identity mismatch" >&2; exit 1; }
volume_identity=$(docker volume inspect --format \
    '{{index .Labels "com.docker.compose.project"}}|{{index .Labels "com.docker.compose.volume"}}' \
    "$VOLUME")
[ "$volume_identity" = "$PROJECT|postgres-data" ] \
    || { echo "Switchstand PostgreSQL volume labels mismatch" >&2; exit 1; }

sql() { docker exec "$container" psql -X -v ON_ERROR_STOP=1 -U switchstand -d switchstand -At -c "$1"; }
revision=$(sql 'SELECT version_num FROM alembic_version')
case "$revision" in
    0010_work_metadata_authority)
        [ "$operation" = abort-pre-authority ] || [ "$resume_attempt" = true ] \
            || { echo "schema is already $EXPECTED_NEW without an exact reconcilable receipt; outcome UNKNOWN" >&2; exit 1; }
        [ "$EXPECTED_OLD" = 0007_agent_chat_identity ] \
            || { echo "abort receipt has unsupported original revision: $EXPECTED_OLD" >&2; exit 1; }
        counts_sql="SELECT (SELECT count(*) FROM work_handles)||'|'||(SELECT count(*) FROM work_grants)||'|'||(SELECT count(*) FROM effect_intents)||'|'||(SELECT count(*) FROM messages)||'|'||(SELECT count(*) FROM message_deliveries)||'|'||(SELECT count(*) FROM message_projection)||'|'||(SELECT count(*) FROM lifecycle_obligations)||'|'||(SELECT count(*) FROM work_event_handles)||'|'||(SELECT count(*) FROM agent_mailboxes)"
        ;;
    0007_agent_chat_identity)
        counts_sql="SELECT (SELECT count(*) FROM work_handles)||'|'||(SELECT count(*) FROM work_grants)||'|'||(SELECT count(*) FROM effect_intents)||'|'||(SELECT count(*) FROM messages)||'|'||(SELECT count(*) FROM message_deliveries)||'|'||(SELECT count(*) FROM message_projection)||'|'||(SELECT count(*) FROM lifecycle_obligations)||'|'||(SELECT count(*) FROM work_event_handles)||'|'||(SELECT count(*) FROM agent_mailboxes)"
        ;;
    *)
        echo "unsupported shared schema: expected exact source 0007_agent_chat_identity or $EXPECTED_NEW; actual ${revision:-<none>}" >&2
        exit 1
        ;;
esac
if [ "$operation" != abort-pre-authority ] && [ "$resume_attempt" = false ]; then
    EXPECTED_OLD=$revision
    before_counts=$(sql "$counts_sql")
fi
dump_digest() {
    target=$1 kind=$2
    python - "$state_dir" "$target" "$kind" <<'PY'
import hashlib, os, subprocess, sys, tempfile
fd, path = tempfile.mkstemp(dir=sys.argv[1], prefix="state-upgrade-", suffix=".sql")
try:
    with os.fdopen(fd, "w+b") as output:
        subprocess.run(["docker", "exec", sys.argv[2], "pg_dump", "-U", "switchstand",
            "-d", "switchstand", f"--{sys.argv[3]}-only", "--no-owner", "--no-privileges",
            "--restrict-key=SWITCHSTANDSTATEDIGEST"], stdout=output, check=True)
        output.flush()
        output.seek(0)
        print(hashlib.file_digest(output, "sha256").hexdigest(), end="")
finally:
    os.unlink(path)
PY
}
marker_state() {
    target=$1 table=$2
    exists=$(docker exec "$target" psql -X -v ON_ERROR_STOP=1 -U switchstand -d switchstand -At \
        -c "SELECT to_regclass('public.$table') IS NOT NULL") || return 1
    [ "$exists" = f ] && { printf absent; return; }
    rows=$(docker exec "$target" psql -X -v ON_ERROR_STOP=1 -U switchstand -d switchstand -At \
        -c "SELECT count(*) FROM $table") || return 1
    [ "$rows" = 0 ] && printf absent || printf active
}
quiescence_sql="SELECT count(*) FROM pg_stat_activity WHERE datname=current_database() AND pid<>pg_backend_pid() AND backend_type='client backend'"
assert_quiescent() {
    clients=$(sql "$quiescence_sql")
    [ "$clients" = 0 ] \
        || { echo "shared state has $clients other database client(s); stop Switchstand writers before upgrading" >&2; exit 1; }
    container_name=$(docker inspect --format '{{.Name}}' "$container")
    container_name=${container_name#/}
    network_members=$(docker network inspect --format '{{range .Containers}}{{.Name}}{{"\n"}}{{end}}' "$NETWORK")
    [ "$network_members" = "$container_name" ] \
        || { echo "shared state network has an attached application container; stop Switchstand writers before upgrading" >&2; exit 1; }
}
assert_quiescent
if [ "$resume_attempt" = true ]; then
    current_schema=$(dump_digest "$container" schema)
    current_data=$(dump_digest "$container" data)
    current_counts=$(sql "$counts_sql")
    if [ "$revision|$current_counts|$current_schema|$current_data" = "$EXPECTED_NEW|$expected_counts|$expected_schema|$expected_data" ]; then
        outcome=APPLIED after_counts=$current_counts after_schema=$current_schema after_data=$current_data
        write_receipt append
        printf 'state upgrade APPLIED reconciled from exact receipt %s\n' "$receipt"
        exit 0
    fi
    if [ "$revision|$current_counts|$current_schema|$current_data" != "$EXPECTED_OLD|$before_counts|$before_schema|$before_data" ]; then
        outcome=UNKNOWN after_counts=$current_counts after_schema=$current_schema after_data=$current_data
        write_receipt append
        echo "shared state does not match receipt before or after identity; outcome UNKNOWN" >&2
        exit 1
    fi
fi
if [ "$operation" != abort-pre-authority ] && [ "$resume_attempt" = false ]; then
    before_schema=$(dump_digest "$container" schema)
    before_data=$(dump_digest "$container" data)
fi

if [ "$target_identity" = production ]; then
    backup_dir=${SWITCHSTAND_BACKUP_DIR:-$HOME/.local/state/switchstand/backups}
else
    backup_dir=$state_dir/backups
fi
if [ "$target_identity" = production ]; then
    mkdir -p "$backup_dir"
    chmod 700 "$backup_dir"
fi
backup="$backup_dir/state-$revision-$head-$(date -u +%Y%m%dT%H%M%SZ)-$$.dump"
set -C
docker exec "$container" pg_dump -U switchstand -d switchstand -Fc >"$backup"
set +C
[ -s "$backup" ] || { echo "state backup is empty" >&2; exit 1; }
backup_ready=true

rehearsal="switchstand-upgrade-rehearsal-$(printf '%.12s' "$head")-$$"
migration_image="switchstand-upgrade:$head"
if [ "$operation" = abort-pre-authority ]; then
    rehearsal=
fi
if [ "$operation" != abort-pre-authority ]; then
docker run -d --rm --name "$rehearsal" --tmpfs /var/lib/postgresql \
    -e POSTGRES_DB=switchstand -e POSTGRES_USER=switchstand \
    -e POSTGRES_PASSWORD=switchstand "$IMAGE" >/dev/null
i=0
until docker exec "$rehearsal" pg_isready -U switchstand >/dev/null 2>&1; do
    i=$((i + 1)); [ "$i" -lt 31 ] || { echo "rehearsal PostgreSQL did not become healthy" >&2; exit 1; }
    sleep 1
done
docker cp "$backup" "$rehearsal:/tmp/state.dump"
docker exec "$rehearsal" pg_restore --exit-on-error --no-owner --no-privileges \
    -U switchstand -d switchstand /tmp/state.dump
rehearsal_sql() { docker exec "$rehearsal" psql -X -v ON_ERROR_STOP=1 -U switchstand -d switchstand -At -c "$1"; }
[ "$(rehearsal_sql 'SELECT version_num FROM alembic_version')" = "$EXPECTED_OLD" ]
[ "$(rehearsal_sql "$counts_sql")" = "$before_counts" ]
fi

docker build --quiet --target runtime --tag "$migration_image" "$control" >/dev/null
heads=$(docker run --rm "$migration_image" uv run --no-sync alembic -c /app/alembic.ini heads 2>/dev/null)
[ "$heads" = "$EXPECTED_NEW (head)" ] \
    || { echo "candidate migration head mismatch: expected $EXPECTED_NEW (head); actual ${heads:-<none>}" >&2; exit 1; }
migrate() {
    target=$1 destination=${2:-$EXPECTED_NEW}
    docker run --rm --network "container:$target" \
        -e DATABASE_URL=postgresql+psycopg://switchstand:switchstand@127.0.0.1/switchstand \
        "$migration_image" uv run --no-sync alembic -c /app/alembic.ini \
        "$([ "$destination" = "$EXPECTED_NEW" ] && printf upgrade || printf downgrade)" "$destination"
}
if [ "$operation" != abort-pre-authority ]; then
migrate "$rehearsal"
[ "$(rehearsal_sql 'SELECT version_num FROM alembic_version')" = "$EXPECTED_NEW" ]
new_schema=$(dump_digest "$rehearsal" schema)
new_data=$(dump_digest "$rehearsal" data)
migrate "$rehearsal" "$EXPECTED_OLD"
[ "$(rehearsal_sql 'SELECT version_num FROM alembic_version')" = "$EXPECTED_OLD" ]
[ "$(rehearsal_sql "$counts_sql")" = "$before_counts" ]
[ "$(dump_digest "$rehearsal" schema)" = "$before_schema" ]
[ "$(dump_digest "$rehearsal" data)" = "$before_data" ]
migrate "$rehearsal"
[ "$(rehearsal_sql 'SELECT version_num FROM alembic_version')" = "$EXPECTED_NEW" ]
[ "$(dump_digest "$rehearsal" schema)" = "$new_schema" ]
[ "$(dump_digest "$rehearsal" data)" = "$new_data" ]

if [ "$operation" = rehearse ]; then
    after_counts=$before_counts after_schema=$new_schema after_data=$new_data outcome=REHEARSED
    write_receipt create
    printf 'state upgrade rehearsal passed: %s -> %s -> %s -> %s; receipt %s\n' \
        "$EXPECTED_OLD" "$EXPECTED_NEW" "$EXPECTED_OLD" "$EXPECTED_NEW" "$receipt"
    exit 0
fi
fi

assert_quiescent
revision=$(sql 'SELECT version_num FROM alembic_version')
current_counts=$(sql "$counts_sql")
[ "$revision" = "$([ "$operation" = abort-pre-authority ] && printf %s "$EXPECTED_NEW" || printf %s "$EXPECTED_OLD")" ] \
    || { echo "shared state changed after rehearsal; refusing migration" >&2; exit 1; }
if [ "$operation" = abort-pre-authority ]; then
    current_schema=$(dump_digest "$container" schema)
    current_data=$(dump_digest "$container" data)
    [ "$current_counts|$current_schema|$current_data" = "$expected_counts|$expected_schema|$expected_data" ] \
        || { echo "shared state no longer matches exact applied receipt; outcome UNKNOWN" >&2; exit 1; }
    stage1=$(marker_state "$container" work_authority) || { echo "Stage 1 marker unreadable; outcome UNKNOWN" >&2; exit 1; }
    stage2=$(marker_state "$container" work_metadata_authority) || { echo "Stage 2 marker unreadable; outcome UNKNOWN" >&2; exit 1; }
    [ "$stage1|$stage2" = absent\|absent ] \
        || { echo "POSTGRES_AUTHORITY present; downgrade forbidden; forward-fix only" >&2; exit 1; }
    original_counts=$before_counts original_schema=$before_schema original_data=$before_data
    before_counts=$expected_counts before_schema=$expected_schema before_data=$expected_data
    after_counts=$original_counts after_schema=$original_schema after_data=$original_data outcome=ATTEMPTING
    write_receipt create
    shared_migration_attempted=true
    migrate "$container" "$EXPECTED_OLD"
else
if [ "$current_counts" != "$before_counts" ]; then
    echo "shared state changed after rehearsal; refusing migration" >&2; exit 1
fi
if [ "$resume_attempt" = false ]; then
    after_counts=$before_counts after_schema=$new_schema after_data=$new_data outcome=ATTEMPTING
    write_receipt create
fi
shared_migration_attempted=true
migrate "$container" || {
    stage1=$(marker_state "$container" work_authority) || { echo "authority marker unreadable; outcome UNKNOWN" >&2; exit 1; }
    stage2=$(marker_state "$container" work_metadata_authority) || { echo "authority marker unreadable; outcome UNKNOWN" >&2; exit 1; }
    [ "$stage1|$stage2" = absent\|absent ] || { echo "POSTGRES_AUTHORITY present; outcome UNKNOWN; forward-fix only" >&2; exit 1; }
    failed_revision=$(sql 'SELECT version_num FROM alembic_version') \
        || { echo "Alembic revision unreadable; outcome UNKNOWN" >&2; exit 1; }
    case "$failed_revision" in
        "$EXPECTED_OLD"|0008_work_index_authority|0009_human_trajectory|"$EXPECTED_NEW") ;;
        *) echo "ambiguous Alembic revision $failed_revision; outcome UNKNOWN" >&2; exit 1;;
    esac
    migrate "$container" "$EXPECTED_OLD" || { echo "pre-authority abort failed; outcome UNKNOWN" >&2; exit 1; }
    shared_migration_attempted=false
    [ "$(sql 'SELECT version_num FROM alembic_version')" = "$EXPECTED_OLD" ] \
        && [ "$(sql "$counts_sql")" = "$before_counts" ] \
        && [ "$(dump_digest "$container" schema)" = "$before_schema" ] \
        && [ "$(dump_digest "$container" data)" = "$before_data" ] \
        || { echo "pre-authority abort verification failed; outcome UNKNOWN" >&2; exit 1; }
    outcome=ABORTED after_counts=$before_counts after_schema=$before_schema after_data=$before_data
    write_receipt append
    terminal_written=true
    echo "migration failed; pre-authority downgrade completed and original state verified" >&2
    exit 1
}
fi
revision=$(sql 'SELECT version_num FROM alembic_version')
after_counts=$(sql "$counts_sql")
[ "$revision" = "$([ "$operation" = abort-pre-authority ] && printf %s "$EXPECTED_OLD" || printf %s "$EXPECTED_NEW")" ] \
    || { echo "shared state upgrade readback failed; preserve backup $backup" >&2; exit 1; }
after_schema=$(dump_digest "$container" schema)
after_data=$(dump_digest "$container" data)
if [ "$operation" = abort-pre-authority ]; then
    [ "$after_counts|$after_schema|$after_data" = "$original_counts|$original_schema|$original_data" ] \
        || { echo "pre-authority abort digest mismatch; outcome UNKNOWN" >&2; exit 1; }
    outcome=ABORTED_PRE_AUTHORITY
else
    [ "$after_schema|$after_data" = "$new_schema|$new_data" ] \
        || { echo "shared state digest mismatch; outcome UNKNOWN" >&2; exit 1; }
    outcome=APPLIED
fi
write_receipt append
terminal_written=true

printf 'state upgrade %s: %s -> %s; preserved counts %s; backup %s; receipt %s\n' \
    "$outcome" "$EXPECTED_OLD" "$revision" "$after_counts" "$backup" "$receipt"
