#!/bin/sh
set -eu

case "$*" in
    "--target production") mode=legacy; target=production ;;
    "--mode prepare --target production"|"--mode prepare --target disposable")
        mode=prepare; target=$4 ;;
    "--mode apply --target production --image-id "*|"--mode apply --target disposable --image-id "*)
        [ "$#" -eq 6 ] && [ "$5" = --image-id ] || exit 2
        mode=apply; target=$4; image_id=$6 ;;
    *)
        echo "usage: scripts/switchstand-upgrade-state --mode prepare|apply --target production [--image-id sha256:...]" >&2; exit 2 ;;
esac
umask 077

EXPECTED_NEW=0025_task_control_checkpoints
SERVICE=postgres
IMAGE=postgres:18-alpine
backup=
backup_ready=false
rehearsal=
shared_migration_attempted=false

control=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
if [ "$target" = disposable ]; then
    root=${SWITCHSTAND_REHEARSAL_ROOT:-}
    case "$root" in
        /home/marco/.local/state/switchstand/rehearsals/[a-z0-9]* ) ;;
        *) echo "disposable upgrade root is invalid" >&2; exit 1 ;;
    esac
    [ -d "$root" ] && [ ! -L "$root" ] \
        && [ "$(stat -c '%u:%a' "$root")" = "$(id -u):700" ] \
        || { echo "disposable upgrade root is not private" >&2; exit 1; }
    name=${root##*/}
    case "$name" in *[!a-z0-9-]*|""|switchstand) echo "disposable upgrade name is invalid" >&2; exit 1;; esac
    PROJECT="rehearsal-$name"
    VOLUME="${PROJECT}_postgres-data"
    state_dir=$root/state
else
    PROJECT=switchstand
    VOLUME=switchstand_postgres-data
    state_dir=$HOME/.local/state/switchstand
fi
head=$(git -C "$control" rev-parse HEAD)
branch=$(git -C "$control" branch --show-current)
common=$(git -C "$control" rev-parse --path-format=absolute --git-common-dir)
dirty=$(git -C "$control" status --porcelain --untracked-files=all)

if [ -n "${SWITCHSTAND_CONTROL_PATH:-}${SWITCHSTAND_CONTROL_SHA:-}${SWITCHSTAND_CONTROL_COMMON:-}" ]; then
    [ "$control" = "${SWITCHSTAND_CONTROL_PATH:-}" ] \
        && [ "$head" = "${SWITCHSTAND_CONTROL_SHA:-}" ] \
        && [ "$common" = "${SWITCHSTAND_CONTROL_COMMON:-}" ] \
        && [ -z "$branch" ] && [ -z "$dirty" ] \
        || { echo "state upgrade CONTROL does not match selector identity" >&2; exit 1; }
else
    git -C "$control" fetch --quiet --no-tags origin \
        '+refs/heads/main:refs/remotes/origin/main'
    accepted=$(git -C "$control" rev-parse origin/main)
    [ "$branch" = main ] && [ "$head" = "$accepted" ] && [ -z "$dirty" ] \
        || { echo "state upgrade requires clean current main CONTROL" >&2; exit 1; }
fi

lock_dir=$state_dir/state-upgrade.lock
mkdir -p "$state_dir"
mkdir "$lock_dir" 2>/dev/null \
    || { echo "another Switchstand state upgrade is active; refusing concurrent execution" >&2; exit 1; }
cleanup() {
    status=$?
    [ -z "$rehearsal" ] || docker rm -f "$rehearsal" >/dev/null 2>&1 || true
    [ "$mode" = apply ] || [ "$shared_migration_attempted" = true ] || [ -z "$backup" ] || rm -f "$backup"
    if [ "$status" -ne 0 ] && [ "$backup_ready" = true ]; then
        observed_revision=$(sql 'SELECT version_num FROM alembic_version' 2>/dev/null || printf UNAVAILABLE)
        observed_counts=$(sql "$counts_sql" 2>/dev/null || printf UNAVAILABLE)
        outcome="shared migration NOT_RUN; operation aborted"
        [ "$shared_migration_attempted" = false ] \
            || outcome="shared migration outcome UNKNOWN"
        printf 'state upgrade %s; backup %s; observed revision %s; observed counts %s; no retry or rollback attempted\n' \
            "$outcome" "$backup" "$observed_revision" "$observed_counts" >&2
    fi
    rmdir "$lock_dir" >/dev/null 2>&1 || true
    exit "$status"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

compose() { docker compose --project-name "$PROJECT" --project-directory "$control" -f "$control/compose.state.yaml" "$@"; }
container=$(compose ps -q "$SERVICE")
[ -n "$container" ] && [ "$(printf '%s\n' "$container" | wc -l)" -eq 1 ] \
    || { echo "expected exactly one running Switchstand PostgreSQL service" >&2; exit 1; }
identity=$(docker inspect --format \
    '{{index .Config.Labels "com.docker.compose.project"}}|{{index .Config.Labels "com.docker.compose.service"}}|{{.Config.Image}}|{{.State.Health.Status}}' \
    "$container")
[ "$identity" = "$PROJECT|$SERVICE|$IMAGE|healthy" ] \
    || { echo "Switchstand PostgreSQL service identity or health mismatch" >&2; exit 1; }
mounts=$(docker inspect --format \
    '{{range .Mounts}}{{if eq .Destination "/var/lib/postgresql"}}{{.Name}}|{{.RW}}{{end}}{{end}}' \
    "$container")
[ "$mounts" = "$VOLUME|true" ] \
    || { echo "Switchstand PostgreSQL volume identity mismatch" >&2; exit 1; }
volume_identity=$(docker volume inspect --format \
    '{{index .Labels "com.docker.compose.project"}}|{{index .Labels "com.docker.compose.volume"}}' \
    "$VOLUME")
[ "$volume_identity" = "$PROJECT|postgres-data" ] \
    || { echo "Switchstand PostgreSQL volume labels mismatch" >&2; exit 1; }

if [ "$mode" = apply ]; then
    digest=${image_id#sha256:}
    [ "$digest" != "$image_id" ] && [ "${#digest}" -eq 64 ] \
        || { echo "apply requires an exact sha256 image ID" >&2; exit 1; }
    case "$digest" in
        *[!0-9a-f]*) echo "apply requires an exact sha256 image ID" >&2; exit 1 ;;
    esac
    [ "$(docker image inspect --format '{{.Id}}' "$image_id" 2>/dev/null)" = "$image_id" ] \
        || { echo "prepared migration image is unavailable or mismatched" >&2; exit 1; }
fi

sql() { docker exec "$container" psql -X -v ON_ERROR_STOP=1 -U switchstand -d switchstand -At -c "$1"; }
revision=$(sql 'SELECT version_num FROM alembic_version')
case "$revision" in
    "$EXPECTED_NEW")
        [ "$mode" != prepare ] || {
            migration_image="switchstand-upgrade:$head"; docker build --quiet --target runtime --tag "$migration_image" "$control" >/dev/null
            docker image inspect --format '{{.Id}}' "$migration_image"; exit 0
        }
        printf 'SWITCHSTAND_STATE_UPGRADE_RESULT=NO_EFFECT revision=%s\n' "$EXPECTED_NEW"
        exit 0
        ;;
    0002_grants_and_effects)
        counts_sql="SELECT (SELECT count(*) FROM work_handles)||'|'||(SELECT count(*) FROM work_grants)||'|'||(SELECT count(*) FROM effect_intents)"
        ;;
    0004_required_result_persistence)
        counts_sql="SELECT (SELECT count(*) FROM work_handles)||'|'||(SELECT count(*) FROM work_grants)||'|'||(SELECT count(*) FROM effect_intents)||'|'||(SELECT count(*) FROM messages)||'|'||(SELECT count(*) FROM message_deliveries)||'|'||(SELECT count(*) FROM message_projection)||'|'||(SELECT count(*) FROM lifecycle_obligations)"
        ;;
    0005_work_event_handles)
        counts_sql="SELECT (SELECT count(*) FROM work_handles)||'|'||(SELECT count(*) FROM work_grants)||'|'||(SELECT count(*) FROM effect_intents)||'|'||(SELECT count(*) FROM messages)||'|'||(SELECT count(*) FROM message_deliveries)||'|'||(SELECT count(*) FROM message_projection)||'|'||(SELECT count(*) FROM lifecycle_obligations)||'|'||(SELECT count(*) FROM work_event_handles)"
        ;;
    0006_agent_mailboxes|0007_agent_chat_identity)
        counts_sql="SELECT (SELECT count(*) FROM work_handles)||'|'||(SELECT count(*) FROM work_grants)||'|'||(SELECT count(*) FROM effect_intents)||'|'||(SELECT count(*) FROM messages)||'|'||(SELECT count(*) FROM message_deliveries)||'|'||(SELECT count(*) FROM message_projection)||'|'||(SELECT count(*) FROM lifecycle_obligations)||'|'||(SELECT count(*) FROM work_event_handles)||'|'||(SELECT count(*) FROM agent_mailboxes)"
        ;;
    0012_outcome_state)
        counts_sql="SELECT (SELECT count(*) FROM work_handles)||'|'||(SELECT count(*) FROM work_grants)||'|'||(SELECT count(*) FROM effect_intents)||'|'||(SELECT count(*) FROM messages)||'|'||(SELECT count(*) FROM message_deliveries)||'|'||(SELECT count(*) FROM message_projection)||'|'||(SELECT count(*) FROM lifecycle_obligations)||'|'||(SELECT count(*) FROM work_event_handles)||'|'||(SELECT count(*) FROM agent_mailboxes)||'|'||(SELECT count(*) FROM canonical_work)||'|'||(SELECT count(*) FROM human_trajectory_revisions)||'|'||(SELECT count(*) FROM outcome_state_revisions)"
        ;;
    0013_failure_journal|0014_canonical_routing|0015_work_admission_time)
        counts_sql="SELECT (SELECT count(*) FROM work_handles)||'|'||(SELECT count(*) FROM work_grants)||'|'||(SELECT count(*) FROM effect_intents)||'|'||(SELECT count(*) FROM messages)||'|'||(SELECT count(*) FROM message_deliveries)||'|'||(SELECT count(*) FROM message_projection)||'|'||(SELECT count(*) FROM lifecycle_obligations)||'|'||(SELECT count(*) FROM work_event_handles)||'|'||(SELECT count(*) FROM agent_mailboxes)||'|'||(SELECT count(*) FROM canonical_work)||'|'||(SELECT count(*) FROM human_trajectory_revisions)||'|'||(SELECT count(*) FROM outcome_state_revisions)||'|'||(SELECT count(*) FROM work_migration_receipts)||'|'||(SELECT count(*) FROM failure_records)||'|'||(SELECT count(*) FROM failure_resolutions)"
        ;;
    0016_agent_mailbox_transfers)
        counts_sql="SELECT (SELECT count(*) FROM work_handles)||'|'||(SELECT count(*) FROM work_grants)||'|'||(SELECT count(*) FROM effect_intents)||'|'||(SELECT count(*) FROM messages)||'|'||(SELECT count(*) FROM message_deliveries)||'|'||(SELECT count(*) FROM message_projection)||'|'||(SELECT count(*) FROM lifecycle_obligations)||'|'||(SELECT count(*) FROM work_event_handles)||'|'||(SELECT count(*) FROM agent_mailboxes)||'|'||(SELECT count(*) FROM canonical_work)||'|'||(SELECT count(*) FROM human_trajectory_revisions)||'|'||(SELECT count(*) FROM outcome_state_revisions)||'|'||(SELECT count(*) FROM work_migration_receipts)||'|'||(SELECT count(*) FROM failure_records)||'|'||(SELECT count(*) FROM failure_resolutions)||'|'||(SELECT count(*) FROM agent_mailbox_transfer_requests)"
        ;;
    0017_priority_claims)
        counts_sql="SELECT (SELECT count(*) FROM work_handles)||'|'||(SELECT count(*) FROM work_grants)||'|'||(SELECT count(*) FROM effect_intents)||'|'||(SELECT count(*) FROM messages)||'|'||(SELECT count(*) FROM message_deliveries)||'|'||(SELECT count(*) FROM message_projection)||'|'||(SELECT count(*) FROM lifecycle_obligations)||'|'||(SELECT count(*) FROM work_event_handles)||'|'||(SELECT count(*) FROM agent_mailboxes)||'|'||(SELECT count(*) FROM canonical_work)||'|'||(SELECT count(*) FROM human_trajectory_revisions)||'|'||(SELECT count(*) FROM outcome_state_revisions)||'|'||(SELECT count(*) FROM work_migration_receipts)||'|'||(SELECT count(*) FROM failure_records)||'|'||(SELECT count(*) FROM failure_resolutions)||'|'||(SELECT count(*) FROM agent_mailbox_transfer_requests)||'|'||(SELECT count(*) FROM priority_claims)"
        ;;
    0018_task_runs)
        counts_sql="SELECT (SELECT count(*) FROM work_handles)||'|'||(SELECT count(*) FROM work_grants)||'|'||(SELECT count(*) FROM effect_intents)||'|'||(SELECT count(*) FROM messages)||'|'||(SELECT count(*) FROM message_deliveries)||'|'||(SELECT count(*) FROM message_projection)||'|'||(SELECT count(*) FROM lifecycle_obligations)||'|'||(SELECT count(*) FROM work_event_handles)||'|'||(SELECT count(*) FROM agent_mailboxes)||'|'||(SELECT count(*) FROM canonical_work)||'|'||(SELECT count(*) FROM human_trajectory_revisions)||'|'||(SELECT count(*) FROM outcome_state_revisions)||'|'||(SELECT count(*) FROM work_migration_receipts)||'|'||(SELECT count(*) FROM failure_records)||'|'||(SELECT count(*) FROM failure_resolutions)||'|'||(SELECT count(*) FROM agent_mailbox_transfer_requests)||'|'||(SELECT count(*) FROM priority_claims)||'|'||(SELECT count(*) FROM task_run_requests)"
        ;;
    0019_task_run_executions)
        counts_sql="SELECT (SELECT count(*) FROM work_handles)||'|'||(SELECT count(*) FROM work_grants)||'|'||(SELECT count(*) FROM effect_intents)||'|'||(SELECT count(*) FROM messages)||'|'||(SELECT count(*) FROM message_deliveries)||'|'||(SELECT count(*) FROM message_projection)||'|'||(SELECT count(*) FROM lifecycle_obligations)||'|'||(SELECT count(*) FROM work_event_handles)||'|'||(SELECT count(*) FROM agent_mailboxes)||'|'||(SELECT count(*) FROM canonical_work)||'|'||(SELECT count(*) FROM human_trajectory_revisions)||'|'||(SELECT count(*) FROM outcome_state_revisions)||'|'||(SELECT count(*) FROM work_migration_receipts)||'|'||(SELECT count(*) FROM failure_records)||'|'||(SELECT count(*) FROM failure_resolutions)||'|'||(SELECT count(*) FROM agent_mailbox_transfer_requests)||'|'||(SELECT count(*) FROM priority_claims)||'|'||(SELECT count(*) FROM task_run_requests)||'|'||(SELECT count(*) FROM task_run_executions)"
        ;;
    0020_task_run_results)
        counts_sql="SELECT (SELECT count(*) FROM work_handles)||'|'||(SELECT count(*) FROM work_grants)||'|'||(SELECT count(*) FROM effect_intents)||'|'||(SELECT count(*) FROM messages)||'|'||(SELECT count(*) FROM message_deliveries)||'|'||(SELECT count(*) FROM message_projection)||'|'||(SELECT count(*) FROM lifecycle_obligations)||'|'||(SELECT count(*) FROM work_event_handles)||'|'||(SELECT count(*) FROM agent_mailboxes)||'|'||(SELECT count(*) FROM canonical_work)||'|'||(SELECT count(*) FROM human_trajectory_revisions)||'|'||(SELECT count(*) FROM outcome_state_revisions)||'|'||(SELECT count(*) FROM work_migration_receipts)||'|'||(SELECT count(*) FROM failure_records)||'|'||(SELECT count(*) FROM failure_resolutions)||'|'||(SELECT count(*) FROM agent_mailbox_transfer_requests)||'|'||(SELECT count(*) FROM priority_claims)||'|'||(SELECT count(*) FROM task_run_requests)||'|'||(SELECT count(*) FROM task_run_executions)||'|'||(SELECT count(*) FROM task_run_results)"
        ;;
    0021_human_reviews|0022_implementation_requests)
        counts_sql="SELECT (SELECT count(*) FROM work_handles)||'|'||(SELECT count(*) FROM work_grants)||'|'||(SELECT count(*) FROM effect_intents)||'|'||(SELECT count(*) FROM messages)||'|'||(SELECT count(*) FROM message_deliveries)||'|'||(SELECT count(*) FROM message_projection)||'|'||(SELECT count(*) FROM lifecycle_obligations)||'|'||(SELECT count(*) FROM work_event_handles)||'|'||(SELECT count(*) FROM agent_mailboxes)||'|'||(SELECT count(*) FROM canonical_work)||'|'||(SELECT count(*) FROM human_trajectory_revisions)||'|'||(SELECT count(*) FROM outcome_state_revisions)||'|'||(SELECT count(*) FROM work_migration_receipts)||'|'||(SELECT count(*) FROM failure_records)||'|'||(SELECT count(*) FROM failure_resolutions)||'|'||(SELECT count(*) FROM agent_mailbox_transfer_requests)||'|'||(SELECT count(*) FROM priority_claims)||'|'||(SELECT count(*) FROM task_run_requests)||'|'||(SELECT count(*) FROM task_run_executions)||'|'||(SELECT count(*) FROM task_run_results)||'|'||(SELECT count(*) FROM human_review_consequences)"
        ;;
    0023_activation_continuity)
        counts_sql="SELECT (SELECT count(*) FROM work_handles)||'|'||(SELECT count(*) FROM work_grants)||'|'||(SELECT count(*) FROM effect_intents)||'|'||(SELECT count(*) FROM messages)||'|'||(SELECT count(*) FROM message_deliveries)||'|'||(SELECT count(*) FROM message_projection)||'|'||(SELECT count(*) FROM lifecycle_obligations)||'|'||(SELECT count(*) FROM work_event_handles)||'|'||(SELECT count(*) FROM agent_mailboxes)||'|'||(SELECT count(*) FROM canonical_work)||'|'||(SELECT count(*) FROM human_trajectory_revisions)||'|'||(SELECT count(*) FROM outcome_state_revisions)||'|'||(SELECT count(*) FROM work_migration_receipts)||'|'||(SELECT count(*) FROM failure_records)||'|'||(SELECT count(*) FROM failure_resolutions)||'|'||(SELECT count(*) FROM agent_mailbox_transfer_requests)||'|'||(SELECT count(*) FROM priority_claims)||'|'||(SELECT count(*) FROM task_run_requests)||'|'||(SELECT count(*) FROM task_run_executions)||'|'||(SELECT count(*) FROM task_run_results)||'|'||(SELECT count(*) FROM human_review_consequences)||'|'||(SELECT count(*) FROM activation_obligation_revisions)"
        ;;
    0024_mcp_operation_timings)
        counts_sql="SELECT (SELECT count(*) FROM work_handles)||'|'||(SELECT count(*) FROM work_grants)||'|'||(SELECT count(*) FROM effect_intents)||'|'||(SELECT count(*) FROM messages)||'|'||(SELECT count(*) FROM message_deliveries)||'|'||(SELECT count(*) FROM message_projection)||'|'||(SELECT count(*) FROM lifecycle_obligations)||'|'||(SELECT count(*) FROM work_event_handles)||'|'||(SELECT count(*) FROM agent_mailboxes)||'|'||(SELECT count(*) FROM canonical_work)||'|'||(SELECT count(*) FROM human_trajectory_revisions)||'|'||(SELECT count(*) FROM outcome_state_revisions)||'|'||(SELECT count(*) FROM work_migration_receipts)||'|'||(SELECT count(*) FROM failure_records)||'|'||(SELECT count(*) FROM failure_resolutions)||'|'||(SELECT count(*) FROM agent_mailbox_transfer_requests)||'|'||(SELECT count(*) FROM priority_claims)||'|'||(SELECT count(*) FROM task_run_requests)||'|'||(SELECT count(*) FROM task_run_executions)||'|'||(SELECT count(*) FROM task_run_results)||'|'||(SELECT count(*) FROM human_review_consequences)||'|'||(SELECT count(*) FROM activation_obligation_revisions)||'|'||(SELECT count(*) FROM mcp_operation_timings)"
        ;;
    *)
        echo "unsupported shared schema: expected 0002, 0004, 0005, 0006, 0007, 0012, 0013, 0014, 0015, 0016, 0017, 0018, 0019, 0020, 0021, 0022, 0023, 0024, or $EXPECTED_NEW; actual ${revision:-<none>}" >&2
        exit 1
        ;;
esac
EXPECTED_OLD=$revision
quiescence_sql="SELECT count(*) FROM pg_stat_activity WHERE datname=current_database() AND pid<>pg_backend_pid() AND backend_type='client backend'"
assert_quiescent() {
    clients=$(sql "$quiescence_sql")
    [ "$clients" = 0 ] \
        || { echo "shared state has $clients other database client(s); stop Switchstand writers before upgrading" >&2; exit 1; }
    container_name=$(docker inspect --format '{{.Name}}' "$container")
    container_name=${container_name#/}
    network_members=$(docker network inspect --format '{{range .Containers}}{{.Name}}{{"\n"}}{{end}}' "${PROJECT}_default")
    [ "$network_members" = "$container_name" ] \
        || { echo "shared state network has an attached application container; stop Switchstand writers before upgrading" >&2; exit 1; }
}

if [ "$mode" = prepare ]; then
    backup="$state_dir/rehearsal-$EXPECTED_OLD-$head-$$.dump"
else
    assert_quiescent
    before_counts=$(sql "$counts_sql")
    if [ "$target" = disposable ]; then
        backup_dir=$root/backups
    else
        backup_dir=${SWITCHSTAND_BACKUP_DIR:-$HOME/.local/state/switchstand/backups}
    fi
    mkdir -p "$backup_dir"
    chmod 700 "$backup_dir"
    backup="$backup_dir/state-$EXPECTED_OLD-$head-$(date -u +%Y%m%dT%H%M%SZ)-$$.dump"
fi
set -C
docker exec "$container" pg_dump -U switchstand -d switchstand -Fc >"$backup"
set +C
[ -s "$backup" ] || { echo "state backup is empty" >&2; exit 1; }
backup_ready=true
[ "$mode" != prepare ] || backup_ready=false

if [ "$mode" != apply ]; then
rehearsal="switchstand-upgrade-rehearsal-$(printf '%.12s' "$head")-$$"
migration_image="switchstand-upgrade:$head"
docker run -d --rm --name "$rehearsal" --tmpfs /var/lib/postgresql \
    -e POSTGRES_DB=switchstand -e POSTGRES_USER=switchstand \
    -e POSTGRES_PASSWORD=switchstand "$IMAGE" >/dev/null
i=0
ready=0
while [ "$ready" -lt 2 ]; do
    if docker exec "$rehearsal" pg_isready -U switchstand >/dev/null 2>&1; then
        ready=$((ready + 1))
    else
        ready=0
    fi
    if [ "$ready" -ge 2 ]; then
        continue
    fi
    i=$((i + 1)); [ "$i" -lt 31 ] || { echo "rehearsal PostgreSQL did not become healthy" >&2; exit 1; }
    sleep 1
done
docker cp "$backup" "$rehearsal:/tmp/state.dump"
docker exec "$rehearsal" pg_restore --exit-on-error --no-owner --no-privileges \
    -U switchstand -d switchstand /tmp/state.dump
rehearsal_sql() { docker exec "$rehearsal" psql -X -v ON_ERROR_STOP=1 -U switchstand -d switchstand -At -c "$1"; }
[ "$(rehearsal_sql 'SELECT version_num FROM alembic_version')" = "$EXPECTED_OLD" ]
rehearsal_counts=$(rehearsal_sql "$counts_sql")
[ "$mode" != prepare ] || before_counts=$rehearsal_counts

docker build --quiet --target runtime --tag "$migration_image" "$control" >/dev/null
migration_image=$(docker image inspect --format '{{.Id}}' "$migration_image")
fi

migrate() {
    target=$1
    docker run --rm --network "container:$target" \
        -e DATABASE_URL=postgresql+psycopg://switchstand:switchstand@127.0.0.1/switchstand \
        "$migration_image" uv run --no-sync alembic -c /app/alembic.ini upgrade "$EXPECTED_NEW"
}

if [ "$mode" != apply ]; then
migrate "$rehearsal"
[ "$(rehearsal_sql 'SELECT version_num FROM alembic_version')" = "$EXPECTED_NEW" ]
[ "$(rehearsal_sql "$counts_sql")" = "$rehearsal_counts" ]
fi
if [ "$mode" = prepare ]; then
printf '%s\n' "$migration_image"
exit 0
fi

[ "$mode" != apply ] || migration_image=$image_id
assert_quiescent
revision=$(sql 'SELECT version_num FROM alembic_version')
current_counts=$(sql "$counts_sql")
[ "$revision" = "$EXPECTED_OLD" ] && [ "$current_counts" = "$before_counts" ] \
    || { echo "shared state changed after rehearsal; refusing migration" >&2; exit 1; }
shared_migration_attempted=true
migrate "$container"
revision=$(sql 'SELECT version_num FROM alembic_version')
after_counts=$(sql "$counts_sql")
[ "$revision" = "$EXPECTED_NEW" ] && [ "$after_counts" = "$before_counts" ] \
    || { echo "shared state upgrade readback failed; preserve backup $backup" >&2; exit 1; }

printf 'SWITCHSTAND_STATE_UPGRADE_RESULT=APPLIED from=%s to=%s preserved_counts=%s backup=%s\n' \
    "$EXPECTED_OLD" "$EXPECTED_NEW" "$after_counts" "$backup"
