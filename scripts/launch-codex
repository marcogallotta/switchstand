#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
role="${1:-}"
case "$role" in
    worker) cd -- "$repo_root" ;;
    interface|coordinator) cd -- "$repo_root/roles/$role" ;;
    *) echo "Usage: $0 {worker|interface|coordinator} [codex arguments...]" >&2; exit 2 ;;
esac
shift
export CODEX_HOME="$HOME/.local/state/switchstand/roles/$role"
nvm_dir="${NVM_DIR:-$HOME/.nvm}"
if [[ ! -f "$nvm_dir/nvm.sh" ]]; then
    echo "NVM is missing: $nvm_dir/nvm.sh" >&2
    exit 127
fi
source "$nvm_dir/nvm.sh" --no-use
if ! node_path="$(nvm which default 2>/dev/null)"; then
    echo "NVM default Node is unavailable" >&2
    exit 127
fi
node_bin="$(dirname -- "$node_path")"
codex_cli="$node_bin/codex"
if [[ ! -x "$codex_cli" ]]; then
    echo "Official Codex CLI is missing from NVM default Node: $codex_cli" >&2
    exit 127
fi
export PATH="$node_bin:$PATH"
exec "$codex_cli" "$@"
