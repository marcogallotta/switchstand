#!/bin/sh
set -eu

: "${HOME:?HOME is required for Codex launch}"
real_codex="$HOME/.codex/packages/standalone/current/bin/codex"
if [ ! -x "$real_codex" ]; then
    echo "Codex executable is unavailable" >&2
    exit 1
fi

canonical_repo="$HOME/switchstand"
script_dir=$(dirname -- "$(readlink -f "$0")")
git_common() {
    env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR \
        -u GIT_CEILING_DIRECTORIES -u GIT_DISCOVERY_ACROSS_FILESYSTEM \
        git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || :
}
canonical_common=$(git_common "$canonical_repo")
current_common=$(git_common "$PWD")
if [ -z "$canonical_common" ] || [ "$current_common" != "$canonical_common" ]; then
    exec "$real_codex" "$@"
fi

coordinator_home="$HOME/.local/state/switchstand/codex/coordinator"
continuity_mode=${SWITCHSTAND_CODEX_CONTINUITY:-PILOT}
continuity_lifetime=${SWITCHSTAND_CODEX_LIFETIME:-ASSIGNMENT}
wakeful_mode=${SWITCHSTAND_CODEX_WAKEFUL:-PILOT}
case "$continuity_mode" in OFF|PILOT) ;; *)
    echo "SWITCHSTAND_CODEX_CONTINUITY must be OFF or PILOT" >&2; exit 2;; esac
case "$continuity_lifetime" in ASSIGNMENT|STANDING) ;; *)
    echo "SWITCHSTAND_CODEX_LIFETIME must be ASSIGNMENT or STANDING" >&2; exit 2;; esac
case "$wakeful_mode" in OFF|PILOT) ;; *)
    echo "SWITCHSTAND_CODEX_WAKEFUL must be OFF or PILOT" >&2; exit 2;; esac
auth_source="$HOME/.codex/auth.json"
auth_link="$coordinator_home/auth.json"
if [ ! -f "$auth_source" ]; then
    echo "Coordinator launch requires existing Codex authentication" >&2
    exit 1
fi
mkdir -p "$coordinator_home"
chmod 700 "$coordinator_home"
start_commit=$(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR \
    -u GIT_CEILING_DIRECTORIES -u GIT_DISCOVERY_ACROSS_FILESYSTEM \
    git -C "$canonical_repo" rev-parse --verify HEAD)
start_record=$(mktemp "$coordinator_home/start-commit.XXXXXXXX")
printf '%s\n' "$start_commit" >"$start_record"
chmod 600 "$start_record"
manifest_record="$start_record.manifest.json"
coordinator_profile="switchstand-coordinator-${start_record##*.}"
coordinator_profile_path="$coordinator_home/$coordinator_profile.config.toml"
coordinator_profile_snapshot="$coordinator_home/$coordinator_profile.launch.toml"
continuity_telemetry="$coordinator_home/continuity-${start_record##*.}.jsonl"
invocation_digest=$("$script_dir/coordinator-control" digest-argv -- "$@")
if [ -L "$auth_link" ]; then
    if [ "$(readlink -f "$auth_link")" != "$(readlink -f "$auth_source")" ]; then
        echo "Coordinator Codex authentication binding is invalid" >&2
        exit 1
    fi
elif [ -e "$auth_link" ]; then
    echo "Coordinator Codex authentication binding is invalid" >&2
    exit 1
else
    ln -s "$auth_source" "$auth_link"
fi

friction_path="$canonical_repo/friction.md"
friction_dir_path="$canonical_repo/friction"
friction_state="$HOME/.local/state/switchstand"
legacy_friction_store="$friction_state/friction.md"
friction_root="$friction_state/friction"
friction_store="$friction_root/friction.md"
friction_quarantine="$coordinator_home/friction-quarantine/${start_record##*.}"
quarantine_friction() {
    invalid=$1
    label=$2
    mkdir -p "$friction_quarantine"
    chmod 700 "$coordinator_home/friction-quarantine" "$friction_quarantine"
    destination="$friction_quarantine/$label"
    if [ -e "$destination" ] || [ -L "$destination" ]; then
        echo "Coordinator friction quarantine destination is not empty" >&2
        exit 1
    fi
    mv "$invalid" "$destination"
    echo "Coordinator friction state degraded: quarantined $label; launch continues" >&2
}

if [ -L "$friction_path" ]; then
    friction_target=$(readlink -f "$friction_path" || :)
    if [ "$friction_target" != "$legacy_friction_store" ] && \
            [ "$friction_target" != "$friction_store" ]; then
        quarantine_friction "$friction_path" primary-binding
    fi
elif [ -f "$friction_path" ]; then
    if [ -e "$legacy_friction_store" ] || [ -L "$legacy_friction_store" ]; then
        quarantine_friction "$friction_path" primary-file
    else
        mv "$friction_path" "$legacy_friction_store"
        chmod 600 "$legacy_friction_store"
    fi
elif [ -e "$friction_path" ]; then
    quarantine_friction "$friction_path" primary-binding
fi
if [ -L "$friction_dir_path" ]; then
    friction_dir_target=$(readlink -f "$friction_dir_path" || :)
    if [ "$friction_dir_target" != "$friction_root" ]; then
        quarantine_friction "$friction_dir_path" primary-directory-binding
    fi
elif [ -e "$friction_dir_path" ]; then
    quarantine_friction "$friction_dir_path" primary-directory-binding
fi

if [ -L "$legacy_friction_store" ] || \
        { [ -e "$legacy_friction_store" ] && [ ! -f "$legacy_friction_store" ]; }; then
    quarantine_friction "$legacy_friction_store" legacy-store
fi
if [ ! -e "$legacy_friction_store" ]; then
    touch "$legacy_friction_store"
    chmod 600 "$legacy_friction_store"
fi
if [ -L "$friction_root" ] || { [ -e "$friction_root" ] && [ ! -d "$friction_root" ]; }; then
    quarantine_friction "$friction_root" current-root
fi
mkdir -p "$friction_root"
chmod 700 "$friction_root"
if [ -L "$friction_store" ] || { [ -e "$friction_store" ] && [ ! -f "$friction_store" ]; }; then
    quarantine_friction "$friction_store" current-store
fi
if [ ! -e "$friction_store" ]; then
    cp "$legacy_friction_store" "$friction_store"
    chmod 600 "$friction_store"
fi
for category in capability process implementation; do
    category_store="$friction_root/$category.md"
    if [ -L "$category_store" ] || \
            { [ -e "$category_store" ] && [ ! -f "$category_store" ]; }; then
        quarantine_friction "$category_store" "category-$category"
    fi
done
if ! "$script_dir/friction-register" init "$friction_root"; then
    echo "Coordinator friction state degraded: register initialization failed; launch continues" >&2
fi
if [ "$(readlink -f "$friction_path" || :)" != "$friction_store" ]; then
    ln -sfn "$friction_store" "$friction_path"
fi
if [ "$(readlink -f "$friction_dir_path" || :)" != "$friction_root" ]; then
    ln -sfn "$friction_root" "$friction_dir_path"
fi

writer_suffix=$(printf '%s' "${start_record##*.}" | tr '[:upper:]' '[:lower:]')
owned_writer=$(
    cd "$canonical_repo"
    "$script_dir/switchstand-worktree" "coordinator-$writer_suffix" "$start_commit"
)
"$script_dir/codex-coordinator-profile" \
    "$HOME/.codex/config.toml" "$coordinator_profile_snapshot" "$coordinator_profile_path" \
    "$canonical_repo" "$owned_writer" "$coordinator_home/hooks.json" "$script_dir/codex-hook" \
    "$script_dir/codex-continuity-hook" "$script_dir/codex-compact-hook" \
    "$script_dir/coordinator-control" "$continuity_mode" "$continuity_lifetime" \
    "$continuity_telemetry" \
    "$start_record" "$manifest_record"

"$script_dir/coordinator-control" create \
    --repo "$canonical_repo" --control-root "$script_dir/.." \
    --writer "$owned_writer" \
    --start-record "$start_record" \
    --profile "$coordinator_profile_snapshot" --runtime-profile "$coordinator_profile_path" \
    --hooks "$coordinator_home/hooks.json" --executable "$real_codex" \
    --compact-hook-snapshot "$start_record.compact-controls/codex-compact-hook" \
    --coordinator-control-snapshot "$start_record.compact-controls/coordinator-control" \
    --shim "$HOME/.local/bin/codex" --invocation-digest "$invocation_digest" >/dev/null

if [ ! -e "$owned_writer/friction.md" ]; then
    ln -s "$friction_store" "$owned_writer/friction.md"
fi
if [ ! -e "$owned_writer/friction" ]; then
    ln -s "$friction_root" "$owned_writer/friction"
fi

unset SWITCHSTAND_CODEX_CONTINUITY SWITCHSTAND_CODEX_LIFETIME SWITCHSTAND_CODEX_WAKEFUL
cd "$owned_writer"
if [ "$wakeful_mode" = PILOT ]; then
    runtime_python="$canonical_repo/.venv/bin/python"
    environment_file="$HOME/.config/switchstand/.env"
    if [ ! -x "$runtime_python" ] || [ ! -f "$environment_file" ]; then
        echo "Wakeful pilot runtime is unavailable" >&2
        exit 1
    fi
    CODEX_HOME="$coordinator_home" \
        exec "$runtime_python" -c \
            'import sys; sys.path.insert(0, sys.argv.pop(1)); from switchstand.codex_session import main; main()' \
            "$canonical_repo/src" \
            --home "$coordinator_home" --codex "$real_codex" \
            --start-record "$start_record" \
            --default-name "codex-head-$writer_suffix" \
            --environment-file "$environment_file" -- \
            "$real_codex" --profile "$coordinator_profile" \
            -c 'model_reasoning_effort="medium"' \
            -a never -c 'default_permissions="switchstand-coordinator"' \
            --enable hooks --dangerously-bypass-hook-trust "$@"
fi
CODEX_HOME="$coordinator_home" \
    exec "$real_codex" --profile "$coordinator_profile" \
        -c 'model_reasoning_effort="medium"' \
        -a never -c 'default_permissions="switchstand-coordinator"' \
        --enable hooks --dangerously-bypass-hook-trust "$@"
