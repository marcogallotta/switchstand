#!/bin/sh
set -eu

: "${HOME:?HOME is required for Codex launch}"
real_codex="$HOME/.codex/packages/standalone/current/bin/codex"
if [ ! -x "$real_codex" ]; then
    echo "Codex executable is unavailable" >&2
    exit 1
fi

canonical_repo="$HOME/switchstand"
script_dir=$(dirname -- "$(readlink -f "$0")")
canonical_common=$(git -C "$canonical_repo" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || :)
current_common=$(git -C "$PWD" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || :)
if [ -z "$canonical_common" ] || [ "$current_common" != "$canonical_common" ]; then
    exec "$real_codex" "$@"
fi

stale() {
    echo "STALE Coordinator control: $1; update the canonical main checkout before launching" >&2
    exit 1
}

# A linked worktree shares the Git directory, but may be at an older commit.
# Check the worktree that supplies this launcher as well as the launch directory.
script_root=$(git -C "$script_dir" rev-parse --show-toplevel 2>/dev/null) \
    || stale "cannot verify launcher source"
current_root=$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null) \
    || stale "cannot verify launch worktree"
[ "$script_root" = "$current_root" ] \
    || stale "launcher and launch directory use different worktrees"
[ "$(git -C "$canonical_repo" symbolic-ref --quiet --short HEAD 2>/dev/null)" = main ] \
    || stale "canonical checkout is not on main"
main_head=$(git -C "$canonical_repo" rev-parse --verify HEAD 2>/dev/null) \
    || stale "cannot verify canonical HEAD"
remote_main=$(GIT_TERMINAL_PROMPT=0 git -C "$canonical_repo" ls-remote --exit-code origin refs/heads/main 2>/dev/null) \
    || stale "cannot verify remote main"
[ "$remote_main" = "$main_head$(printf '\t')refs/heads/main" ] \
    || stale "canonical HEAD differs from remote main"
for worktree in "$canonical_repo" "$current_root"; do
    head=$(git -C "$worktree" rev-parse --verify HEAD 2>/dev/null) \
        || stale "cannot verify worktree HEAD"
    [ "$head" = "$main_head" ] || stale "worktree HEAD differs from remote main"
    changes=$(git -C "$worktree" --no-optional-locks -c core.fsmonitor=false \
        status --porcelain --untracked-files=normal 2>/dev/null) \
        || stale "cannot verify clean worktree"
    [ -z "$changes" ] || stale "worktree has local changes"
done

coordinator_home="$HOME/.local/state/switchstand/codex/coordinator"
coordinator_profile="switchstand-coordinator-preferences"
auth_source="$HOME/.codex/auth.json"
auth_link="$coordinator_home/auth.json"
if [ ! -f "$auth_source" ]; then
    echo "Coordinator launch requires existing Codex authentication" >&2
    exit 1
fi
mkdir -p "$coordinator_home"
chmod 700 "$coordinator_home"
if [ -L "$auth_link" ]; then
    if [ "$(readlink -f "$auth_link")" != "$(readlink -f "$auth_source")" ]; then
        echo "Coordinator Codex authentication binding is invalid" >&2
        exit 1
    fi
elif [ -e "$auth_link" ]; then
    echo "Coordinator Codex authentication binding is invalid" >&2
    exit 1
else
    ln -s "$auth_source" "$auth_link"
fi

"$script_dir/codex-coordinator-profile" \
    "$HOME/.codex/config.toml" "$coordinator_home/$coordinator_profile.config.toml"

CODEX_HOME="$coordinator_home" \
    exec "$real_codex" --profile "$coordinator_profile" \
        -m gpt-5.6-sol -c 'model_reasoning_effort="medium"' \
        --dangerously-bypass-approvals-and-sandbox --disable hooks "$@"
