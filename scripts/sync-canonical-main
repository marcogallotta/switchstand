#!/usr/bin/python3
"""Safely fast-forward the fixed canonical Switchstand checkout."""

from __future__ import annotations

import os
import subprocess
import sys
from collections.abc import Callable, Sequence
from pathlib import Path

CANONICAL_REPO = Path("/home/marco/switchstand")
GIT = "/usr/bin/git"
CANONICAL_REMOTE = "https://github.com/marcogallotta/switchstand.git"
CANONICAL_ORIGINS = frozenset(
    {
        CANONICAL_REMOTE,
        CANONICAL_REMOTE.removesuffix(".git"),
        "git@github.com:marcogallotta/switchstand.git",
        "ssh://git@github.com/marcogallotta/switchstand.git",
    }
)
ALLOWED_LOCAL_CONFIG_KEYS = frozenset(
    {
        "core.bare",
        "core.filemode",
        "core.ignorecase",
        "core.logallrefupdates",
        "core.precomposeunicode",
        "core.repositoryformatversion",
        "core.sshcommand",
        "remote.origin.fetch",
        "remote.origin.url",
        "user.email",
        "user.name",
    }
)


def sync(
    repo: Path = CANONICAL_REPO,
    *,
    git: str = GIT,
    emit: Callable[[str], None] = print,
    remote_source: str = CANONICAL_REMOTE,
    accepted_origins: frozenset[str] = CANONICAL_ORIGINS,
    remote_protocol: str = "https",
) -> int:
    def run(arguments: Sequence[str], *, check: bool = True) -> subprocess.CompletedProcess[str]:
        result = subprocess.run(
            [
                git,
                "--no-replace-objects",
                f"--git-dir={repo / '.git'}",
                f"--work-tree={repo}",
                "-c",
                f"core.worktree={repo}",
                "-c",
                "core.fsmonitor=false",
                "-c",
                "core.hooksPath=/dev/null",
                "-c",
                "core.attributesFile=/dev/null",
                "-c",
                "core.sshCommand=",
                "-c",
                "credential.helper=",
                "-c",
                "fetch.recurseSubmodules=false",
                "-c",
                "submodule.recurse=false",
                "-c",
                "maintenance.auto=false",
                "-c",
                "gc.auto=0",
                "-c",
                "protocol.allow=never",
                "-c",
                f"protocol.{remote_protocol}.allow=always",
                "-c",
                "protocol.ext.allow=never",
                *arguments,
            ],
            text=True,
            capture_output=True,
            check=False,
            env={
                "PATH": "/usr/bin:/bin",
                "HOME": "/nonexistent",
                "XDG_CONFIG_HOME": "/nonexistent",
                "LC_ALL": "C",
                "GIT_CONFIG_NOSYSTEM": "1",
                "GIT_CONFIG_GLOBAL": "/dev/null",
                "GIT_TERMINAL_PROMPT": "0",
                "GIT_PAGER": "cat",
                "PAGER": "cat",
                "GIT_PROTOCOL_FROM_USER": "0",
            },
        )
        if check and result.returncode:
            detail = result.stderr.strip() or result.stdout.strip() or "no detail"
            raise RuntimeError(f"git {' '.join(arguments)} failed: {detail}")
        return result

    def validate_config() -> None:
        names = run(("config", "--local", "--no-includes", "--name-only", "--list"))
        for name in names.stdout.splitlines():
            key = name.lower()
            branch_tracking = key.startswith("branch.") and key.endswith((".remote", ".merge"))
            if key not in ALLOWED_LOCAL_CONFIG_KEYS and not branch_tracking:
                raise RuntimeError(f"unsafe local Git config: {name}")
        origin = run(
            ("config", "--local", "--no-includes", "--get", "remote.origin.url")
        ).stdout.strip()
        if origin not in accepted_origins:
            raise RuntimeError(f"unexpected origin: {origin}")

    try:
        validate_config()
        root = Path(run(("rev-parse", "--show-toplevel")).stdout.strip())
        if root.resolve() != repo.resolve():
            raise RuntimeError(f"checkout root mismatch: {root}")

        branch = run(("branch", "--show-current")).stdout.strip()
        if branch != "main":
            emit(f"skip: canonical checkout is on {branch or 'detached HEAD'}, not main")
            return 0

        if run(("status", "--porcelain", "--untracked-files=all")).stdout:
            emit("skip: canonical main is dirty")
            return 0

        run(
            (
                "fetch",
                "--quiet",
                "--no-tags",
                remote_source,
                "refs/heads/main:refs/remotes/origin/main",
            )
        )
        local = run(("rev-parse", "HEAD^{commit}")).stdout.strip()
        remote = run(("rev-parse", "refs/remotes/origin/main^{commit}")).stdout.strip()
        if local == remote:
            emit(f"current: canonical main is already at {local}")
            return 0

        relation = run(("merge-base", "--is-ancestor", local, remote), check=False)
        if relation.returncode == 1:
            reverse = run(("merge-base", "--is-ancestor", remote, local), check=False)
            state = "ahead of" if reverse.returncode == 0 else "diverged from"
            if reverse.returncode not in (0, 1):
                raise RuntimeError("git merge-base failed while checking canonical main")
            emit(f"skip: canonical main is {state} origin/main")
            return 0
        if relation.returncode != 0:
            raise RuntimeError("git merge-base failed while checking canonical main")

        if run(("status", "--porcelain", "--untracked-files=all")).stdout:
            emit("skip: canonical main became dirty before pull")
            return 0
        if run(("branch", "--show-current")).stdout.strip() != "main":
            emit("skip: canonical checkout left main before pull")
            return 0

        previous = local
        validate_config()
        run(("pull", "--ff-only", "--no-recurse-submodules", remote_source, "main"))
        resulting = run(("rev-parse", "HEAD^{commit}")).stdout.strip()
        fetched = run(("rev-parse", "refs/remotes/origin/main^{commit}")).stdout.strip()
        if resulting != fetched:
            raise RuntimeError(
                f"pull readback mismatch: HEAD={resulting} origin/main={fetched}"
            )
        emit(f"updated: canonical main {previous} -> {resulting}")
        return 0
    except (OSError, RuntimeError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(sync())
