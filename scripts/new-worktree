#!/bin/sh
set -eu

if [ "$#" -ne 1 ]; then
    echo "usage: scripts/new-worktree <name>" >&2
    exit 2
fi
name=$1
case "$name" in *[!a-z0-9-]*|'') echo "name must use a-z, 0-9 and hyphens" >&2; exit 2;; esac
repo=$(git rev-parse --show-toplevel)
root=$HOME/.local/state/switchstand/worktrees
target=$root/$name
branch=v2-$name
if [ -e "$target" ] || git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
    echo "worktree name already exists: $name" >&2
    exit 1
fi
mkdir -p "$root"
git -C "$repo" fetch origin main
git -C "$repo" worktree add -b "$branch" "$target" origin/main >&2
echo "$target"
