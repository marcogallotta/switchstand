#!/usr/bin/env python3
"""Wait without model calls for unacknowledged mail; leave it for the agent to process."""

import argparse
import json
import os
import sys
import time
from pathlib import Path
from urllib.error import HTTPError, URLError
from urllib.parse import urlencode
from urllib.request import ProxyHandler, build_opener

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
from switchstand.mailbox_wake import MailboxSummary  # noqa: E402


def watch(name, port, interval=60):
    url = f"http://127.0.0.1:{port}/internal/claude-mail-summary?{urlencode({'name': name})}"
    opener = build_opener(ProxyHandler({}))
    while True:
        try:
            with opener.open(url, timeout=15) as response:
                result = MailboxSummary.parse(json.load(response))
        except HTTPError as error:
            print(f"claude-mail-watch: HTTP {error.code}; check mailbox registration/access "
                  "and local edge service", file=sys.stderr)
            return 1
        except (URLError, OSError, ValueError) as error:
            print(f"claude-mail-watch: local edge transport/summary error ({type(error).__name__})",
                  file=sys.stderr)
            return 1
        if result.count:
            print(result.notice(name))
            return 0
        time.sleep(interval)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("name", help="registered Switchstand mailbox name")
    args = parser.parse_args()
    name = args.name.strip()
    if not name:
        parser.error("name must not be empty")
    try:
        port = int(os.environ.get("SWITCHSTAND_MCP_BIND_PORT", "8790"))
        if not 1 <= port <= 65535:
            raise ValueError
    except ValueError:
        parser.error("SWITCHSTAND_MCP_BIND_PORT must be a valid port")
    try:
        return watch(name, port)
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
