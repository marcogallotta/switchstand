# Switchstand asset version: 1
[Unit]
Description=Switchstand Wakeful Root mailbox follower
After=network-online.target
[Service]
Type=simple
WorkingDirectory=%h/switchstand
EnvironmentFile=%h/.config/switchstand/.env
ExecStart=%h/switchstand/.venv/bin/switchstand-wakeful-root --config=%h/.config/switchstand/wakeful-root.json
Restart=on-failure
RestartSec=2s
TimeoutStopSec=10s
KillMode=mixed
UMask=0077
NoNewPrivileges=yes
[Install]
WantedBy=default.target
